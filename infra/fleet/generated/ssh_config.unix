# Generated by `bun infra/fleet/fleet.ts ssh-config` from infra/fleet/fleet.toml. Do not edit.
# Installed as ~/.ssh/fleet/ssh_config; ~/.ssh/config starts with `Include fleet/ssh_config`.

# The Bun OS host: build farm, production (aphrody.com, api.aphrody.com, WebOS) and mesh hub
Host vps
    HostName 10.200.77.1
    User ubuntu
    HostKeyAlias vps
    IdentityFile ~/.ssh/id_ed25519_aphrody
    IdentitiesOnly yes
    UserKnownHostsFile ~/.ssh/fleet/known_hosts
    StrictHostKeyChecking yes
    BatchMode yes
    ConnectTimeout 15
    ServerAliveInterval 15
    ServerAliveCountMax 3
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m

Host vps-t
    HostName 10.200.77.1
    User ubuntu
    HostKeyAlias vps
    IdentityFile ~/.ssh/id_ed25519_aphrody
    IdentitiesOnly yes
    UserKnownHostsFile ~/.ssh/fleet/known_hosts
    StrictHostKeyChecking yes
    BatchMode yes
    ConnectTimeout 15
    ServerAliveInterval 15
    ServerAliveCountMax 3
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m
    BatchMode no
    RequestTTY yes
    RemoteCommand tmux new-session -A -s main

# Recovery path when the mesh is down
Host vps-public
    HostName 51.77.147.152
    User ubuntu
    HostKeyAlias vps
    IdentityFile ~/.ssh/id_ed25519_aphrody
    IdentitiesOnly yes
    UserKnownHostsFile ~/.ssh/fleet/known_hosts
    StrictHostKeyChecking yes
    BatchMode yes
    ConnectTimeout 15
    ServerAliveInterval 15
    ServerAliveCountMax 3
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m

