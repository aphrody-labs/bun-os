{
  "schemaVersion": 1,
  "authority": "aphrody-infra",
  "sharedDiscord": {
    "repository": "aphrody-discord",
    "role": "transport-and-framework-adapters",
    "consumers": ["aphrody", "rg", "shenron", "nie"],
    "invariants": [
      "one-gateway-connection-per-discord-application",
      "gateway-and-http-interactions-are-explicitly-exclusive",
      "applications-retain-domain-commands-data-auth-and-secrets"
    ],
    "release": "published-package-or-immutable-sha",
    "deploymentAuthority": "aphrody-infra"
  },
  "applications": {
    "rg": {
      "role": "external-source-owner",
      "sourceRepository": "https://github.com/aphrody-labs/rosegriffon",
      "binaryWorkflow": "https://github.com/aphrody-labs/rosegriffon/blob/main/.github/workflows/binaries.yml",
      "releases": "https://github.com/aphrody-labs/rosegriffon/releases",
      "libraries": ["@rosegriffon/assets", "@rosegriffon/config", "@rosegriffon/db", "@rosegriffon/i18n"]
    },
    "shenron": {
      "role": "external-product",
      "source": "aphrody-labs/shenron",
      "website": {
        "runtime": "next-bun",
        "package": "@shenron/site",
        "ui": "@shenron/ui",
        "auth": "@shenron/auth",
        "api": "shenron-bot"
      },
      "api": {
        "runtime": "bun",
        "database": "postgresql",
        "localCache": "sqlite",
        "mcp": "shenron-mcp dragonball.* (aphrody-labs/shenron)"
      },
      "bot": { "runtime": "bun-discord.js", "api": "shenron-bot", "database": "postgresql-with-sqlite-cache" },
      "data": { "primary": "postgresql", "media": "shared-nginx-storage", "backup": "aphrody-infra-backup-policy" }
    },
    "nie": {
      "role": "specialized-engine-and-3d-asset-plane",
      "website": { "runtime": "rust-http", "package": "nie-site", "unit": "nie-site.service", "port": 8085 },
      "api": { "runtime": "rust-http", "package": "nie-model-serve", "unit": "nie-model-serve.service", "port": 8792 },
      "mcp": "optional aphrody-mcp nie.* (disabled by default until NIE source crates join this monorepo; process boundary runs nie-mcp as a child; the IECODE agent plugin is stored in ~/plugins/iecode and restricted to IECODE)",
      "desktop": "none: IEVR features are web-only (nie-site + apps/nie-web). The Inacord Tauri app was removed on 2026-09-26; its generic pet/pixel commands moved to aphrody-app, which can reach game features through the opt-in aphrody-mcp nie.* capability",
      "data": {
        "primary": "none",
        "storage": "local-ievr-3d-assets",
        "localIndex": "sqlite (nie-index RE knowledge base and atlas, var/)",
        "optionalPostgres": "nie-pg schema nie (cfg.bin import, manual run)",
        "optionalRedis": "nie-index atlas mirror, opt-in via NIE_ATLAS_REDIS / --redis; no Redis service contract (OPEN-RESERVATIONS #3)",
        "schedules": "none (no nie timer or cron is declared or deployed)"
      }
    },
    "iecode": {
      "role": "modding-and-formats-plane",
      "tooling": { "runtime": "dotnet-cpp-bun-python", "package": "iecode", "sourceRepo": "iecode" }
    },
    "aphrody": {
      "role": "single-product",
      "productOwner": "@aphrody/product",
      "web": {
        "platform": "cloudflare",
        "worker": "aphrody-app",
        "ui": "@aphrody/app-ui",
        "entrypoint": "@aphrody/product/web",
        "deploymentQualification": "pending"
      },
      "ai": {
        "role": "private-backend-and-automation",
        "publicProduct": false,
        "clients": ["native-cli", "authenticated-site"],
        "sessionOwner": "aphrody-app-server",
        "capabilityOwners": "shared-with-native-cli",
        "requiredCapabilities": [
          "doc-ai",
          "rag",
          "model",
          "infer",
          "voice",
          "ocr",
          "translate",
          "memory",
          "gateway",
          "train",
          "agent",
          "status"
        ],
        "parity": {
          "status": "pending",
          "cloudflare": "prompt-stream-only; complete parity not qualified",
          "required": [
            "operation-results",
            "errors",
            "streaming",
            "cancellation",
            "session-continuity",
            "capability-discovery",
            "authorization",
            "automation"
          ]
        },
        "isolation": ["provider-authentication", "raw-provider-sessions", "cookies", "protected-data"],
        "deployment": "cloudflare-with-qualified-private-native-execution-for-host-capabilities"
      },
      "desktop": {
        "runtime": "tauri-runtime-cef",
        "package": "aphrody-app",
        "sourceRepo": "aphrody",
        "sourcePath": "crates/ui/app",
        "ui": "@aphrody/app-ui",
        "sidecars": ["sd-daemon", "aphrody"],
        "modules": [
          "agent (aphrody app-server over stdio)",
          "drive (Spacedrive sd-daemon sidecar)",
          "models",
          "identity (pet and pixel pipeline, ex-Inacord)",
          "browser",
          "terminal",
          "systemd",
          "infra",
          "windows",
          "settings"
        ]
      },
      "gameFeatures": "opt-in aphrody-mcp nie.* only; disabled in the root build until NIE is integrated; Aphrody desktop never imports IECODE sources through sibling paths"
    }
  },
  "deduplication": {
    "ui": "rg-ui-is-canonical; shenron-consumes-the-contract",
    "auth": "one-better-auth-boundary-per-public-origin",
    "api": "one-public-api-per-application; MCP-remains-internal",
    "database": "postgresql-primary; sqlite-is-a-bounded-local-cache",
    "proxy": "one-nginx-instance-and-one-route-registry",
    "backup": "one-scheduler-and-retention-policy-per-data-class"
  }
}
