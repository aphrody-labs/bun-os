# wayvnc of the aphrody-hyprland session: RFB input/clipboard channel for the WebOS gateway. Loopback only, no auth (127.0.0.1:5901).
[Unit]
Description=Aphrody wayvnc (loopback input channel of the Hyprland session)
Requires=aphrody-hyprland.service
After=aphrody-hyprland.service
PartOf=aphrody-hyprland.service

[Service]
Type=simple
User=ubuntu
Environment=XDG_RUNTIME_DIR=/run/user/1000/ah
Environment=WAYLAND_DISPLAY=wayland-1
ExecStartPre=/bin/sh -c 'for i in $(seq 1 50); do [ -S /run/user/1000/ah/wayland-1 ] && exit 0; sleep 0.3; done; exit 1'
ExecStartPre=/bin/sleep 3
ExecStart=/bin/sh -c 'export HYPRLAND_INSTANCE_SIGNATURE=$(ls -t /run/user/1000/ah/hypr | head -1); exec /usr/bin/wayvnc -o HEADLESS-1 127.0.0.1 5901'
Restart=always
RestartSec=3
NoNewPrivileges=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
