# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=aphrody.com server (Rust aphrody-webos, ADR-003)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/webos/current
Environment=WEBOS_ADDR=127.0.0.1:8790
Environment=WEBOS_CLIENT_DIR=/home/ubuntu/apps/webos/current/client
EnvironmentFile=/home/ubuntu/apps/webos/current/release.env
ExecStart=/home/ubuntu/apps/webos/current/aphrody-webos
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=512M
CPUQuota=200%
TasksMax=128

[Install]
WantedBy=multi-user.target
