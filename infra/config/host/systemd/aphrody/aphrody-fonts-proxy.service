# Google Fonts edge proxy behind nginx on cdn.aphrody.com (nginx/aphrody/cdn.aphrody.com.conf).
# Runs one self-contained bundle of packages/google/src/fonts-serve.ts (with @aphrody/bun-google from the abandoned fork, legacy),
# /home/ubuntu/apps/cdn/src/fonts-serve.js, no dependency to install; the source revision is in
# /home/ubuntu/apps/cdn/src/REVISION. Upgrade from the vps checkout with:
#   bun build packages/google/src/fonts-serve.ts --target bun --outfile /home/ubuntu/apps/cdn/src/fonts-serve.js
# Installed as /etc/systemd/system/aphrody-fonts-proxy.service on the vps. The cache lives in /home/ubuntu/apps/cdn/google. `--static` serves the asset CDN release tree
# (`scripts/aphrody/tools/infra/cdn.ts publish`, /home/ubuntu/apps/cdn/current) under /h/ and /s/<scope>/, then the
# Material Symbols release (`bun run cdn publish` of vendor/material-design-icons, aphrody-labs/material-design-icons branch aphrody,
# /home/ubuntu/apps/cdn/symbols/current, tools/aphrody/config/asset-catalog.json `releases`).
[Unit]
Description=Aphrody Google Fonts edge proxy (cdn.aphrody.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/cdn/src
ExecStart=/home/ubuntu/.local/bin/bun /home/ubuntu/apps/cdn/src/fonts-serve.js --port 8796 --cache /home/ubuntu/apps/cdn/google --origin https://cdn.aphrody.com --static /home/ubuntu/apps/cdn/current --static /home/ubuntu/apps/cdn/symbols/current
Restart=always
MemoryHigh=128M
MemoryMax=256M
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/home/ubuntu/apps/cdn/google
StandardOutput=journal
StandardError=journal
CacheDirectory=aphrody-fonts-proxy
Environment=BUN_INSTALL_CACHE_DIR=/var/cache/aphrody-fonts-proxy
SyslogIdentifier=aphrody-fonts-proxy

[Install]
WantedBy=multi-user.target
