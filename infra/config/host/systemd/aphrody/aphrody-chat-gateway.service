# Aphrody Chat inference gateway (apps/webos/services/chat.ts): 127.0.0.1:8794 behind nginx /api/chat/,
# OpenAI-compatible API over Vertex AI Gemini with the aphrody-bot service account ADC (/etc/aphrody/google.env).
[Unit]
Description=Aphrody Chat inference gateway (Vertex AI Gemini, OpenAI-compatible)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/chat
Environment=PORT=8794
EnvironmentFile=/etc/aphrody/google.env
ExecStart=/home/ubuntu/.local/bin/bun /home/ubuntu/apps/chat/chat.ts
Restart=always
RestartSec=3
NoNewPrivileges=true
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
