# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Aphrody shared Omar browser authenticated SSH client
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=omar
Group=omar
WorkingDirectory=/home/omar/.config/aphrody/omar-browser
ExecStart=/usr/bin/ssh -F /home/omar/.config/aphrody/omar-browser/ssh_config -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:9223:127.0.0.1:9233 -L 127.0.0.1:9234:127.0.0.1:9234 -L 127.0.0.1:9235:127.0.0.1:9235 -R 127.0.0.1:9230:127.0.0.1:9230 omar-browser
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
MemoryMax=128M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aphrody-obscura-omar-client

[Install]
WantedBy=multi-user.target
