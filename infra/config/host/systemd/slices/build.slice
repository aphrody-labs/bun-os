# SPDX-License-Identifier: Apache-2.0
# Bulk builds (cargo-serial, makepkg/Store, AOSP, Helium, BuildKit, tmux build sessions). Weights, not caps:
# builds use every core and the whole disk when the interactive services are idle.
[Unit]
Description=Bun OS builds
Before=slices.target

[Slice]
CPUWeight=20
IOWeight=20
