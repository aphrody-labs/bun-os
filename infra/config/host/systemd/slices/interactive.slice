# SPDX-License-Identifier: Apache-2.0
# Latency-sensitive Bun OS services: nginx, gateways, the Hyprland/wayvnc session, WebOS, session containers.
# Weights, not caps: interactive services and Bun OS release builds get equal weight when both are active.
[Unit]
Description=Bun OS interactive services
Before=slices.target

[Slice]
CPUWeight=1000
IOWeight=1000
