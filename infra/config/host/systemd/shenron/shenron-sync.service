[Unit]
Description=Shenron checkout fast-forward synchronization with origin/main
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/aphrody
Environment=PATH=%h/.bun/bin:%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# The script refuses any runtime other than its pinned Bun 1.4.4.
ExecStart=%h/.bun/bin/bun-1.4.4 %h/src/aphrody/scripts/release/shenron-auto-deploy.ts sync
SuccessExitStatus=75
UMask=0077
TimeoutStartSec=5min
Nice=15
