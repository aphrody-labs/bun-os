# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Continuous manga discovery and indexing with qualified Bun capability ports
Wants=network-online.target
Requires=shenron-mullvad-netns.service
After=network-online.target shenron-mullvad-netns.service
ConditionPathExists=/run/netns/mullvad
ConditionPathExists=/etc/netns/mullvad/resolv.conf
ConditionPathExists=/home/ubuntu/src/shenron/scripts/ops/manga-source-pool.ts
ConditionPathExists=/home/ubuntu/.bun/bin/bun-1.4.4
ConditionPathExists=/home/ubuntu/.aphrody/profiles/dbfr/jobs/manga-source-pool/runtime-capabilities.json
StartLimitIntervalSec=30min
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/src/shenron
Environment=PATH=/home/ubuntu/.bun/bin:/home/ubuntu/.cargo/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
NetworkNamespacePath=/run/netns/mullvad
BindReadOnlyPaths=/etc/netns/mullvad/resolv.conf:/etc/resolv.conf
ExecStart=/home/ubuntu/.bun/bin/bun-1.4.4 /home/ubuntu/src/shenron/scripts/ops/manga-source-pool.ts --job /home/ubuntu/.aphrody/profiles/dbfr/jobs/manga-source-pool --pid-file /home/ubuntu/.aphrody/profiles/dbfr/jobs/manga-source-pool/pool.pid --workers 16 --interval-ms 60000 --reconcile-ms 3600000 --capabilities-file /home/ubuntu/.aphrody/profiles/dbfr/jobs/manga-source-pool/runtime-capabilities.json --public-progress-file /var/www/aphrody-status/manga-source-pool.json
Restart=always
# Back off up to 30 min so a long VPN outage (the Tokyo exit check fails) cannot exhaust StartLimitBurst.
RestartSec=30s
RestartSteps=8
RestartMaxDelaySec=30min
TimeoutStartSec=5min
TimeoutStopSec=60s
KillMode=control-group
UMask=0077
Nice=10
CPUQuota=1200%
MemoryHigh=16G
MemoryMax=20G
TasksMax=2048
LimitNOFILE=8192
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
