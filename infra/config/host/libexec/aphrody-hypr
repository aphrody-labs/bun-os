#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Run a command inside the live aphrody-hyprland session: aphrody-hypr hyprctl clients | aphrody-hypr grim /tmp/s.png | aphrody-hypr -- env
export XDG_RUNTIME_DIR=/run/user/1000/ah
export WAYLAND_DISPLAY=wayland-1
export HYPRLAND_INSTANCE_SIGNATURE=$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -1)
export PIPEWIRE_RUNTIME_DIR=/run/user/1000
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=Hyprland
[ "$1" = "--" ] && shift
exec "$@"
