#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Native session apps from our aphrody-labs forks, packaged as Ubuntu 26.04 debs: factory/native-apps/build.ts.
#   aphrody-native-apps container rio|aphrody|cosmic-src|cosmic [repo...]|calculator|spacedrive
#   aphrody-native-apps publish
set -eu
ROOT=${BUNOS_NATIVE_ROOT:-$HOME/src/bun-os}
# Inside the builder the root is already an export of origin/main.
[ -d "$ROOT/.git" ] || exec bun "$ROOT/factory/native-apps/build.ts" "$@"
# On the host, run build.ts as committed on origin/main (the shared checkout may carry other agents' uncommitted work).
git -C "$ROOT" fetch -q origin main
script=$(mktemp --suffix=.ts)
trap 'rm -f "$script"' EXIT
git -C "$ROOT" show origin/main:factory/native-apps/build.ts >"$script"
bun "$script" "$@"
