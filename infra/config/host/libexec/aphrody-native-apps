#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Builds the native apps of the Bun OS desktop session (Pop!_OS + COSMIC) from our pinned aphrody-labs forks and
# packages each as a real Ubuntu .deb for the apt feed (apps/webos/store/apt.ts ingests ~/native-apps/debs).
# No upstream binaries: Ubuntu's apt "rio" (a Diamond Rio MP3 CLI) and the upstream rioterm deb are removed.
#   deps                          build dependencies (libraries and tools only)
#   rio                           aphrody-labs/rio -> rio_<ver>+bunos_amd64.deb
#   cosmic-src                    aphrody-labs/cosmic-epoch at the gitlink pinned by this repository, app submodules
#   cosmic [app...]               build + package COSMIC apps (default: the session set, dependencies first)
#   calculator                    aphrody-labs/cosmic-calculator (fork of cosmic-utils/cosmic-ext-calculator)
#   spacedrive                    aphrody-labs/spacedrive at the apps/spacedrive import: sd-daemon, sd-server, desktop
#   aphrody                       crates/aphrody-chat and crates/aphrody-search (libcosmic), with desktop/metainfo/icon
#   all                           everything above in order, one lane
# Cargo runs through scripts/aphrody/build/rust/cargo-serial.sh (factory lock), 4 jobs. Run in tmux.
set -eu
ROOT=${BUNOS_NATIVE_ROOT:-$HOME/src/bun-os}
WORK=$HOME/native-apps
DEBS=$WORK/debs
export APHRODY_BUILD_HOST=vps CARGO_BUILD_JOBS=4 PATH="$HOME/.cargo/bin:$PATH"
CARGO="$ROOT/scripts/aphrody/build/rust/cargo-serial.sh"
mkdir -p "$WORK/src" "$WORK/stage" "$DEBS"

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*"; }

deps() {
  sudo apt-get install -y --no-install-recommends just dpkg-dev pkg-config cmake clang mold nasm \
    libxkbcommon-dev libwayland-dev libinput-dev libseat-dev libudev-dev libdisplay-info-dev libgbm-dev libegl-dev \
    libpipewire-0.3-dev libpulse-dev libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev libflatpak-dev \
    libfontconfig-dev libfreetype-dev libdbus-1-dev libpam0g-dev libsystemd-dev libexpat1-dev libssl-dev \
    libglvnd-dev libxcb1-dev libx11-dev libxcursor-dev libxi-dev libxrandr-dev libappstream-dev libgtk-3-dev \
    libwebkit2gtk-4.1-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev librsvg2-dev libheif-dev libavcodec-dev \
    libavformat-dev libavutil-dev libswscale-dev libavfilter-dev libavdevice-dev
}

# deb <name> <version> <stage dir> <description> : package a staged /usr tree, Depends from dpkg-shlibdeps
deb() {
  name=$1 version=$2 stage=$3 desc=$4
  elfs=$(find "$stage" -type f -perm -u+x -exec sh -c 'head -c4 "$1" | grep -q ELF && echo "$1"' _ {} \;)
  depends=""
  if [ -n "$elfs" ]; then
    tmp=$(mktemp -d); mkdir -p "$tmp/debian"; printf 'Source: %s\n\nPackage: %s\nArchitecture: amd64\n' "$name" "$name" >"$tmp/debian/control"
    # shellcheck disable=SC2086
    depends=$(cd "$tmp" && dpkg-shlibdeps -O --ignore-missing-info -l"$stage/usr/lib" $elfs 2>/dev/null | sed -n 's/^shlibs:Depends=//p')
    rm -rf "$tmp"
  fi
  mkdir -p "$stage/DEBIAN"
  {
    printf 'Package: %s\nVersion: %s\nArchitecture: amd64\nMaintainer: aphrody-dev <contact@aphrody.com>\n' "$name" "$version"
    [ -n "$depends" ] && printf 'Depends: %s\n' "$depends"
    printf 'Section: x11\nPriority: optional\nHomepage: https://aphrody.com\nDescription: %s\n Built for Bun OS from the aphrody-labs fork.\n' "$desc"
  } >"$stage/DEBIAN/control"
  out="$DEBS/${name}_${version}_amd64.deb"
  dpkg-deb --root-owner-group -Zxz --build "$stage" "$out" >/dev/null
  printf '%s\t%s\t%s\t%s\n' "$name" "$version" "$(basename "$out")" "$(sha256sum "$out" | cut -d' ' -f1)" >>"$DEBS/index.tsv"
  log "packaged $out"
}

clone() { # clone <dir> <aphrody-labs repo> [rev]
  [ -d "$1/.git" ] || git clone --filter=blob:none "https://github.com/aphrody-labs/$2" "$1"
  [ -z "${3:-}" ] || git -C "$1" checkout -q "$3"
}

version_of() { sed -n 's/^version *= *"\(.*\)"/\1/p' "$1" | head -1; }

rio() {
  d=$WORK/src/rio; clone "$d" rio
  (cd "$d" && nice -n 10 "$CARGO" build --release --locked -p rioterm -j 4)
  s=$WORK/stage/rio; rm -rf "$s"
  install -Dm755 "$d/target/release/rio" "$s/usr/bin/rio"
  install -Dm644 "$d/misc/rio.desktop" "$s/usr/share/applications/rio.desktop"
  install -Dm644 "$ROOT/factory/native-apps/icons/rio/icon.svg" "$s/usr/share/icons/hicolor/scalable/apps/rio.svg"
  [ -f "$d/misc/rio.terminfo" ] && install -Dm644 "$d/misc/rio.terminfo" "$s/usr/share/rio/rio.terminfo"
  install -Dm644 "$d/LICENSE" "$s/usr/share/doc/rio/copyright"
  deb rio "$(version_of "$d/frontends/rioterm/Cargo.toml")+bunos$(git -C "$d" rev-parse --short HEAD)" "$s" "Rio terminal: GPU-accelerated Rust terminal emulator"
}

EPOCH_DIR=$WORK/src/cosmic-epoch
cosmic_src() {
  pin=$(git -C "$ROOT" rev-parse HEAD:vendor/cosmic-epoch)
  clone "$EPOCH_DIR" cosmic-epoch "$pin"
  git -C "$EPOCH_DIR" submodule update --init --filter=blob:none $COSMIC_SET
  log "cosmic-epoch $pin"
}

# Session set, dependencies before dependants. cosmic-randr is a cosmic-settings dependency.
COSMIC_SET="cosmic-icons cosmic-randr cosmic-comp cosmic-panel cosmic-launcher pop-launcher cosmic-settings-daemon cosmic-settings cosmic-files cosmic-term cosmic-edit cosmic-store cosmic-player"

cosmic_one() {
  app=$1; d=$EPOCH_DIR/$app; s=$WORK/stage/$app; rm -rf "$s"
  [ -d "$d" ] || { log "missing $app in cosmic-epoch"; return 1; }
  log "build $app"
  if [ -f "$d/Cargo.toml" ]; then (cd "$d" && nice -n 10 "$CARGO" build --release -j 4); fi
  # The justfile install recipes only copy the release outputs and data files into rootdir/prefix.
  (cd "$d" && just rootdir="$s" prefix=/usr install)
  v=$( [ -f "$d/Cargo.toml" ] && version_of "$d/Cargo.toml" || echo 1.0.0)
  deb "$app" "${v}+bunos$(git -C "$d" rev-parse --short HEAD)" "$s" "COSMIC $app (Bun OS build)"
}

cosmic() {
  [ -d "$EPOCH_DIR" ] || cosmic_src
  [ $# -gt 0 ] || set -- $COSMIC_SET
  failed=""
  for a in "$@"; do cosmic_one "$a" || failed="$failed $a"; done
  [ -z "$failed" ] || { log "failed:$failed"; return 1; }
}

calculator() {
  d=$WORK/src/cosmic-calculator; clone "$d" cosmic-calculator
  (cd "$d" && nice -n 10 "$CARGO" build --release -j 4)
  s=$WORK/stage/cosmic-calculator; rm -rf "$s"
  (cd "$d" && just rootdir="$s" prefix=/usr install)
  deb cosmic-calculator "$(version_of "$d/Cargo.toml")+bunos$(git -C "$d" rev-parse --short HEAD)" "$s" "COSMIC Calculator"
}

# Spacedrive builds from the aphrody-labs/spacedrive fork at the revision imported under apps/spacedrive (its own
# Cargo workspace and lock; root workspace membership waits on the lock regeneration, see a54a754c83).
SPACEDRIVE_REV=${SPACEDRIVE_REV:-4d41a379f612e23ac43a66ffd67df52ca77f57d4}
spacedrive() {
  sd=$WORK/src/spacedrive; clone "$sd" spacedrive "$SPACEDRIVE_REV"
  s=$WORK/stage/spacedrive; rm -rf "$s"
  (cd "$sd" && nice -n 10 "$CARGO" build --release --locked -j 4 --bin sd-daemon --bin sd-server)
  install -Dm755 "$sd/target/release/sd-daemon" "$s/usr/bin/sd-daemon"
  install -Dm755 "$sd/target/release/sd-server" "$s/usr/bin/sd-server"
  (cd "$sd" && bun install && cd apps/tauri && bun run build)
  (cd "$sd" && nice -n 10 "$CARGO" build --release --locked -j 4 -p spacedrive)
  install -Dm755 "$sd/target/release/Spacedrive" "$s/usr/bin/spacedrive"
  install -Dm644 "$ROOT/factory/native-apps/icons/spacedrive/icon.png" "$s/usr/share/icons/hicolor/256x256/apps/spacedrive.png"
  mkdir -p "$s/usr/share/applications"
  printf '[Desktop Entry]\nType=Application\nName=Spacedrive\nComment=The virtual distributed file manager\nExec=spacedrive\nIcon=spacedrive\nStartupWMClass=Spacedrive\nCategories=System;FileManager;\n' >"$s/usr/share/applications/spacedrive.desktop"
  install -Dm644 "$sd/LICENSE" "$s/usr/share/doc/spacedrive/copyright"
  deb spacedrive "$(version_of "$sd/apps/tauri/src-tauri/Cargo.toml")+bunos$(git -C "$sd" rev-parse --short HEAD)" "$s" "Spacedrive file manager (core daemon, headless server, desktop)"
}

# Aphrody Chat and Aphrody Search: native libcosmic apps of this repository (crates/aphrody-chat, crates/aphrody-search).
aphrody_app() { # aphrody_app <chat|search> <Chat|Search>
  n=$1 N=$2 c=$ROOT/crates/aphrody-$1
  (cd "$ROOT" && nice -n 10 "$CARGO" build --release -j 4 -p "aphrody-$n")
  s=$WORK/stage/aphrody-$n; rm -rf "$s"
  install -Dm755 "$ROOT/target/release/aphrody-$n" "$s/usr/bin/aphrody-$n"
  install -Dm644 "$c/res/com.aphrody.$N.desktop" "$s/usr/share/applications/com.aphrody.$N.desktop"
  install -Dm644 "$c/res/com.aphrody.$N.metainfo.xml" "$s/usr/share/metainfo/com.aphrody.$N.metainfo.xml"
  install -Dm644 "$c/res/com.aphrody.$N.svg" "$s/usr/share/icons/hicolor/scalable/apps/com.aphrody.$N.svg"
  deb "aphrody-$n" "$(version_of "$ROOT/Cargo.toml")+bunos$(git -C "$ROOT" rev-parse --short HEAD)" "$s" "Aphrody $N (native COSMIC app)"
}

cmd=${1:-all}; shift || true
case $cmd in
deps) deps ;;
rio) rio ;;
cosmic-src) cosmic_src ;;
cosmic) cosmic "$@" ;;
calculator) calculator ;;
spacedrive) spacedrive ;;
aphrody) aphrody_app chat Chat; aphrody_app search Search ;;
all) deps; rio; aphrody_app chat Chat || true; aphrody_app search Search || true; cosmic_src; cosmic || true; calculator || true; spacedrive ;;
*) echo "usage: $0 deps|rio|cosmic-src|cosmic [app...]|calculator|spacedrive|aphrody|all" >&2; exit 2 ;;
esac
