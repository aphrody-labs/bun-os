    {
      "unit": "nginx.service",
      "path": "systemd/shared/nginx.service.d",
      "hosts": ["vps"]
    },
    {
      "unit": "privoxy.service",
      "path": "systemd/shenron/privoxy.service.d",
      "hosts": ["vps"]
    }
  ],
  "nginxSnippets": {
    "dir": "nginx/snippets",
    "files": ["aphrody-security.inc", "proxy-client-ip.inc", "proxy-upstream.inc"]
  },
  "serviceCatalogs": {
    "aphrody": "aphrody:tools/config/service-catalog.json",
    "aphrody-routes": "nginx/routes.json",
    "nie": "nie/service-catalog.json"
  },
  "inventory": {
    "dir": "inventory",
    "files": [
      "2026-09-30-bun-transfer.json",
      "2026-09-30-oxc-transfer.json",
      "aphrody-discord-dev-2026-09-29.md",
      "build-factory-2026-10-03.json",
