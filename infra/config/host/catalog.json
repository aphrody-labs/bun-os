{
  "$comment": "Single index of host config (systemd units, nginx sites). Declared intent: live state is audited through aphrody-infra. Units compose shared drop-ins at install time (bun packages/core/src/host/cli.ts).",
  "schemaVersion": 1,
  "hostRootEnv": "BUN_OS_ROOT",
  "dropIns": {
    "dir": "systemd/shared",
    "files": [
      "net-inet-only.conf",
      "run-as-ubuntu.conf",
      "sandbox-base.conf",
      "sandbox-home-ro.conf",
      "sandbox-kernel.conf",
      "syscall-service.conf"
    ]
  },
