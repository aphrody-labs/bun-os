{
  "name": "@aphrody/m3-showcase",
  "version": "1.4.7",
  "description": "Adaptive Bun OS M3 showcase for mobile, desktop and TV, with one Bun UI/API sidecar reused by the existing desktop owner.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "inventory": "bun scripts/inventory.ts",
    "dev": "bun scripts/inventory.ts && bun ../../packages/m3-bun/bin/m3-bun.ts dev",
    "build": "bun scripts/inventory.ts && bun ../../packages/m3-bun/bin/m3-bun.ts build",
    "serve": "bun ../../packages/m3-bun/bin/m3-bun.ts serve",
    "compile": "bun scripts/inventory.ts && bun ../../packages/m3-bun/bin/m3-bun.ts compile",
    "package": "bun ../../packages/m3-bun/bin/m3-bun.ts package",
    "deploy": "bun ../../packages/m3-bun/bin/m3-bun.ts deploy all",
    "smoke": "bun ../../packages/m3-bun/bin/m3-bun.ts smoke",
    "typecheck": "bun check -p tsconfig.json --noEmit",
    "test": "bun test ./test && bun run test:dom",
    "icons": "bun scripts/icons.ts",
    "tauri": "bun scripts/tauri.ts",
    "test:dom": "bun test --preload @aphrody/m3-config/test/dom ./test-dom"
  },
  "dependencies": {
    "@aphrody/app-ui": "workspace:*",
    "@aphrody/assets": "workspace:*",
    "@aphrody/canvas": "workspace:*",
    "@aphrody/eslint-plugin-m3": "workspace:*",
    "@aphrody/identity": "workspace:*",
    "@aphrody/m3": "workspace:*",
    "@aphrody/m3-ai": "workspace:*",
    "@aphrody/m3-baseui": "workspace:*",
    "@aphrody/m3-bun": "workspace:*",
    "@aphrody/m3-codemods": "workspace:*",
    "@aphrody/m3-config": "workspace:*",
    "@aphrody/m3-design": "workspace:*",
    "@aphrody/m3-explorer": "workspace:*",
    "@aphrody/m3-fonts": "workspace:*",
    "@aphrody/m3-forms": "workspace:*",
    "@aphrody/m3-front": "workspace:*",
    "@aphrody/m3-icons": "workspace:*",
    "@aphrody/m3-mcp": "workspace:*",
    "@aphrody/m3-motion": "workspace:*",
    "@aphrody/m3-next": "workspace:*",
    "@aphrody/m3-os-themes": "workspace:*",
    "@aphrody/m3-primitives": "workspace:*",
    "@aphrody/m3-react": "workspace:*",
    "@aphrody/m3-reader": "workspace:*",
    "@aphrody/m3-tailwind": "workspace:*",
    "@aphrody/m3-theme": "workspace:*",
    "@aphrody/m3-tokens": "workspace:*",
    "@aphrody/material-design-icons": "workspace:*",
    "@aphrody/scaffold": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:"
  },
  "devDependencies": {
    "bun-types": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "playwright-core": "catalog:"
  },
  "engines": {
    "bun": "1.4.4-canary.20261028.1"
  }
}
