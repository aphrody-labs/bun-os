{
  "name": "@aphrody/lu",
  "version": "1.4.7",
  "private": true,
  "description": "The all-in-one local AI studio for your desktop: chat, images, video and a coding agent in one app.",
  "license": "AGPL-3.0-only",
  "author": "purpledoubled",
  "repository": {
    "type": "git",
    "url": "https://github.com/aphrody-labs/locally-uncensored.git"
  },
  "keywords": [
    "ai",
    "local",
    "ollama",
    "comfyui",
    "uncensored",
    "private",
    "chat",
    "image-generation",
    "video-generation"
  ],
  "engines": {
    "bun": "1.4.4-canary.20261028.1"
  },
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun vite build",
    "dev:mobile": "VITE_LU_BUILD_TARGET=mobile bunx --bun vite",
    "build:mobile": "VITE_LU_BUILD_TARGET=mobile bunx --bun vite build",
    "lint": "bunx --bun eslint .",
    "typecheck": "bunx --bun tsc -b --force",
    "cycles": "bunx --bun madge --circular --extensions ts,tsx src",
    "test": "bunx --bun vitest run",
    "test:security-deps": "bun test ../../factory/ai/scripts/security-dependencies.test.mjs",
    "preview": "bunx --bun vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@pipecat-ai/client-js": "1.13.1",
    "@pipecat-ai/websocket-transport": "1.7.2",
    "@react-three/drei": "catalog:",
    "@react-three/fiber": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@tauri-apps/plugin-shell": "catalog:",
    "@tauri-apps/plugin-updater": "catalog:",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^10.0.0",
    "dotenv": "catalog:",
    "framer-motion": "^12.38.0",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "lucide-react": "catalog:",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.3.289",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "catalog:",
    "remark-math": "^6.0.0",
    "tailwindcss": "catalog:",
    "three": "catalog:",
    "uuid": "^13.0.0",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@typescript/typescript6": "catalog:",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "catalog:",
    "madge": "^8.0.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "catalog:"
  }
}
