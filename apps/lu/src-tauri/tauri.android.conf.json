{
  "build": {
    "beforeBuildCommand": "bun run build:mobile",
    "beforeDevCommand": "bun run dev:mobile"
  },
  "identifier": "com.purpledoubled.locallyuncensored",
  "version": "3.0.7",
  "app": {
    "windows": [
      {
        "title": "LU",
        "visible": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "externalBin": [],
    "resources": [],
    "android": {
      "minSdkVersion": 24,
      "versionCode": 30007001
    }
  },
  "plugins": {
    "updater": null,
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "lu"
          ],
          "host": "oauth",
          "appLink": false
        },
        {
          "scheme": [
            "lu"
          ],
          "host": "remote",
          "appLink": false
        }
      ]
    }
  }
}
