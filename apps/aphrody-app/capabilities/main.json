{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimal default-deny permissions for the Aphrody desktop main window. Agent actions use typed app-server JSON-RPC; native domain actions use scoped commands and broker-owned services. Filesystem access is read-only, scoped to $APPDATA plus files opened by the operating system.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-unmaximize",
    "core:window:allow-unminimize",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-is-maximized",
    "core:window:allow-is-minimized",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:webview:allow-print",
    "core:event:default",

    "os:allow-platform",
    "os:allow-version",
    "os:allow-arch",
    "os:allow-locale",
    "os:allow-hostname",
    "os:allow-os-type",

    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",

    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",

    "notification:default",

    "process:allow-restart",
    "process:allow-exit",

    "autostart:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",

    "window-state:allow-save-window-state",
    "window-state:allow-restore-state",
    "window-state:allow-filename",

    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "global-shortcut:allow-is-registered",

    "log:default",

    "store:default",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",

    "opener:default",
    "deep-link:default",

    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-stat",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**" },
        { "path": "$HOME" },
        { "path": "$HOME/**" },
        { "path": "$DOWNLOAD" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT" },
        { "path": "$DOCUMENT/**" },
        { "path": "$PICTURE" },
        { "path": "$PICTURE/**" }
      ]
    },

    "aphrody-shell-tauri:default"
  ]
}
