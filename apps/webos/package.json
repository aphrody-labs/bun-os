{
  "name": "@aphrody/webos",
  "version": "1.4.7",
  "description": "The Bun OS browser desktop and installable app catalog. aphrody.com is served by the native Bun VPS service; Cloudflare Worker routes remain for app hosts and aliases.",
  "license": "Apache-2.0",
  "author": "aphrody-dev <contact@aphrody.com>",
  "type": "module",
  "scripts": {
    "build": "bun build-product.ts",
    "build:shell": "bun build.ts",
    "dev": "bun build-product.ts && wrangler dev",
    "deploy": "bun deploy.ts",
    "typecheck": "bun check -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aphrody/app-ui": "workspace:*",
    "@aphrody/bun-workspace": "workspace:*",
    "@aphrody/m3-tokens": "workspace:*",
    "@aphrody/webos-wasm": "workspace:*"
  },
  "devDependencies": {
    "@aphrody/bun-types": "workspace:*"
  },
  "engines": {
    "bun": "=1.4.4"
  }
}
