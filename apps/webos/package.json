{
  "name": "@aphrody/webos",
  "version": "1.4.7",
  "description": "aphrody.com: the Bun OS in the browser. One Cloudflare Worker serves the desktop shell (windows, launcher, file explorer, terminal, browser, Bun Engine) and the catalog of every app, package and crate of the workspace.",
  "license": "Apache-2.0",
  "author": "aphrody-dev <contact@aphrody.com>",
  "type": "module",
  "scripts": {
    "build": "bun build-product.ts",
    "build:shell": "bun build.ts",
    "dev": "bun build-product.ts && wrangler dev",
    "deploy": "bun deploy.ts",
    "inventory": "bun inventory.ts",
    "check:coverage": "bun inventory.ts --check",
    "typecheck": "bun check -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aphrody/app-ui": "workspace:*",
    "@aphrody/bun-workspace": "workspace:*",
    "@aphrody/m3-tokens": "workspace:*",
    "@aphrody/typesafe-sdk": "0.6.2",
    "@aphrody/webos-wasm": "workspace:*",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "codemirror": "6.0.2",
    "fend-wasm": "1.5.9"
  },
  "devDependencies": {
    "bun-types": "catalog:"
  },
  "engines": {
    "bun": "1.4.4-canary.20261028.1"
  }
}
