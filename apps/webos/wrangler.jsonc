{
  "name": "aphrody-webos",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "r2_buckets": [{ "binding": "VM", "bucket_name": "aphrody-assets" }],
  "routes": [
    { "pattern": "craft.aphrody.app/", "zone_name": "aphrody.app" },
    { "pattern": "aphrody.com/*", "zone_name": "aphrody.com" },
    { "pattern": "www.aphrody.com/*", "zone_name": "aphrody.com" },
    { "pattern": "app-video.aphrody.app/*", "zone_name": "aphrody.app" },
    { "pattern": "app-generation.aphrody.app/*", "zone_name": "aphrody.app" },
    { "pattern": "app-images.aphrody.app/*", "zone_name": "aphrody.app" },
    { "pattern": "app-vectors.aphrody.app/*", "zone_name": "aphrody.app" },
    { "pattern": "app-compositing.aphrody.app/*", "zone_name": "aphrody.app" },
    {
      "pattern": "app-photo-processing.aphrody.app/*",
      "zone_name": "aphrody.app",
    },
    { "pattern": "app-pdf.aphrody.app/*", "zone_name": "aphrody.app" },
    { "pattern": "app-documents.aphrody.app/*", "zone_name": "aphrody.app" },
    { "pattern": "app-audio.aphrody.app/*", "zone_name": "aphrody.app" },
    { "pattern": "app-layout.aphrody.app/*", "zone_name": "aphrody.app" },
    { "pattern": "app-cad.aphrody.app/*", "zone_name": "aphrody.app" },
    { "pattern": "app-slides.aphrody.app/*", "zone_name": "aphrody.app" },
    { "pattern": "app-tables.aphrody.app/*", "zone_name": "aphrody.app" },
    {
      "pattern": "app-interface-layouts.aphrody.app/*",
      "zone_name": "aphrody.app",
    },
    { "pattern": "aphrody.app", "custom_domain": true },
    { "pattern": "www.aphrody.app", "custom_domain": true },
    { "pattern": "filmcraft.aphrody.app", "custom_domain": true },
    { "pattern": "artcraft.aphrody.app", "custom_domain": true },
    { "pattern": "photocraft.aphrody.app", "custom_domain": true },
    { "pattern": "vectorcraft.aphrody.app", "custom_domain": true },
    { "pattern": "effectcraft.aphrody.app", "custom_domain": true },
    { "pattern": "lightcraft.aphrody.app", "custom_domain": true },
    { "pattern": "pdfcraft.aphrody.app", "custom_domain": true },
    { "pattern": "wordcraft.aphrody.app", "custom_domain": true },
    { "pattern": "soundcraft.aphrody.app", "custom_domain": true },
    { "pattern": "designcraft.aphrody.app", "custom_domain": true },
    { "pattern": "cadcraft.aphrody.app", "custom_domain": true },
    { "pattern": "deckcraft.aphrody.app", "custom_domain": true },
    { "pattern": "gridcraft.aphrody.app", "custom_domain": true },
    { "pattern": "figcraft.aphrody.app", "custom_domain": true },
    { "pattern": "apt.aphrody.app", "custom_domain": true },
    { "pattern": "desktop.aphrody.app", "custom_domain": true },
  ],
  "workers_dev": false,
  "observability": { "enabled": true },
}
