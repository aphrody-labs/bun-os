{
  "name": "artcraft",
  "version": "1.4.7",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "bun ../../packages/artcraft-frontend/scripts/artcraft.ts build",
    "preview": "bun ../../packages/artcraft-frontend/scripts/artcraft.ts preview --port 8080",
    "dev": "bun ../../packages/artcraft-frontend/scripts/artcraft.ts dev",
    "production-preview": "bun ../../packages/artcraft-frontend/scripts/artcraft.ts build && bun ../../packages/artcraft-frontend/scripts/artcraft.ts preview --port 5173",
    "staging-build": "bun ../../packages/artcraft-frontend/scripts/artcraft.ts build",
    "lint": "bun lint app/src",
    "typecheck": "bun check -p tsconfig.json --threads=2 --no-pretty",
    "test": "bun test",
    "format": "bun fmt --write --config ../../bun-format.json app/src"
  },
