{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "isolatedModules": true,
    "incremental": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@aphrody/m3-next": [
        "../../packages/m3-next/src/index.ts"
      ],
      "@aphrody/m3-next/server": [
        "../../packages/m3-next/src/server.tsx"
      ],
      "@aphrody/m3-next/client": [
        "../../packages/m3-next/src/client.tsx"
      ],
      "@aphrody/m3-next/proxy": [
        "../../packages/m3-next/src/theme-proxy.ts"
      ]
    },
    "types": [
      "bun-types",
      "next/types/global"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
