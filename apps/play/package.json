{
  "name": "@aphrody/play",
  "version": "1.4.7",
  "description": "play.aphrody.app: the Bun OS gaming web app. Bun Engine library, Steam, LAN cache, the WebRTC gamestream and web emulation behind one Bun.serve server fronted by an nginx engine that the service owns.",
  "license": "Apache-2.0",
  "author": "aphrody-dev <contact@aphrody.com>",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server/dev.ts",
    "build": "bun scripts/build.ts",
    "deploy": "bun scripts/deploy.ts",
    "typecheck": "bun check -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aphrody/bun-steam": "workspace:*",
    "@aphrody/m3": "workspace:*",
    "@aphrody/m3-fonts": "workspace:*",
    "@aphrody/m3-front": "workspace:*",
    "@aphrody/m3-tailwind": "workspace:*",
    "@aphrody/m3-tokens": "workspace:*",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@aphrody/m3-config": "workspace:*"
  },
  "engines": {
    "bun": "=1.4.4"
  }
}
