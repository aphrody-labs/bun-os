    "@next/third-parties": "16.5.0-canary.30",
    "axios": "^1.20.0",
    "next": "16.5.0-canary.30",
    "qs": "^6.16.0",
    "undici": "^7.30.0",
    "zod-to-json-schema": "3.25.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.5",
  "aphrody": {
    "m3Version": "1.4.4"
  },
  "patchedDependencies": {
    "@discordjs/rest@2.6.3": "patches/@discordjs%2Frest@2.6.3.patch",
