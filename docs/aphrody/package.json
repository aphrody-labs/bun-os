{
  "name": "aphrody",
  "private": true,
  "type": "module",
  "scripts": {
    "bun:check": "bun check packages/infra/workspace/src packages/infra/workspace/test",
    "downloads:publish": "bun scripts/release/publish-downloads.ts",
