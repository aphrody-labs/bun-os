    "downloads:test": "bun test scripts/release/publish-downloads.test.ts",
    "typecheck": "bun run --filter @aphrody/workspace typecheck && bun run typecheck:packages",
    "typecheck:packages": "bun run --filter '*' --filter '!@aphrody/workspace' --filter '!@aphrody/m3-next-example' --filter '!@aphrody/m3-next-tauri-example' typecheck",
    "test": "bun run --filter @aphrody/workspace test",
