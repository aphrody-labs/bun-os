    "@aphrody/m3-tokens": "workspace:*",
    "@aphrody/os": "workspace:*",
    "@aphrody/paths": "workspace:*",
    "@aphrody/product": "workspace:*",
    "@aphrody/runtime-sdk": "npm:@aphrody/bun-runtime-sdk@1.4.4",
    "@aphrody/update": "workspace:*",
    "@aphrody/bun-web": "workspace:*",
    "@aphrody/workspace": "workspace:*",
    "@aphrody/yolo-cli": "workspace:*",
    "@aphrody/yolo-core": "workspace:*",
    "@happy-dom/global-registrator": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
