    "update:deps": "bun packages/engine/yolo/src/index.ts update deps plan --root .",
    "update:sources": "bun packages/engine/yolo/src/index.ts update sources drift --root .",
    "update:systemd": "bun packages/engine/yolo/src/index.ts update systemd check --root .",
    "update:rust": "bun packages/engine/yolo/src/index.ts update rust status --root .",
