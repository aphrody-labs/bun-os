    "web:smoke": "bun ../bun/scripts/aphrody-source/audit/web-smoke.ts",
    "web:crawl": "bun ../bun/scripts/aphrody-source/tools/web/web-crawl.ts",
    "web:crawlability": "bun ../bun/scripts/aphrody-source/audit/web-crawlability.ts",
    "scan": "bash scripts/audit/ai/scripts/scan-repo.sh",
