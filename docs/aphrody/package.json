    "changelog": "bun packages/engine/yolo/src/index.ts update deps changelog --root .",
    "sources": "bun packages/engine/yolo/src/index.ts update sources status --root .",
    "sources:verify": "bun packages/engine/yolo/src/index.ts update sources verify --root .",
    "sources:sync": "bun packages/engine/yolo/src/index.ts update sources sync --apply --root .",
    "monorepo:layout": "bun packages/engine/yolo/src/index.ts ops workspace-layout --root . && bun packages/engine/yolo/src/index.ts ops docs-gen --root . --check --skip-ecosystem",
