    "migrate:packages:bun": "bun scripts/migration/migrate-packages-to-bun.ts --check",
    "ai:build": "bun run --filter '@aphrody/*' build",
    "ai:typecheck": "bun run --filter '@aphrody/*' typecheck",
    "ai:test": "bun run --filter '@aphrody/*' test",
    "ai:dev": "bun run --filter '*' dev",
    "ai:lint": "bun lint packages/ai/",
    "ai:fmt": "bun fmt packages/ai/",
    "docs:translate": "bun packages/engine/yolo/src/index.ts ops docs assist translate",
    "docs:ai": "bun packages/engine/yolo/src/index.ts ops docs assist sync",
