# SPDX-License-Identifier: Apache-2.0

# Cargo outputs at workspace roots. Keep source modules such as
# crates/ai/rag-eval/src/target/ visible to Git.
/target/
/crates/*/*/target/
/packages/*/*/target/
/apps/*/*/target/
**/*.rs.bk
*.rmeta

# Bun, TypeScript, and frontend outputs. Package-specific exceptions remain in
# their own .gitignore files (for example, the tracked drive-server dist shell).
/node_modules/
/dist/
/.turbo/
**/node_modules/
**/.turbo/
/apps/*/*/.next/
/packages/*/*/.next/
/apps/*/*/coverage/
/packages/*/*/coverage/
/crates/*/*/coverage/
/apps/*/*/playwright-report/
/apps/*/*/test-results/
/apps/*/*/dist/
/apps/*/dist/
/packages/*/*/dist/
/packages/*/dist/
**/*.tsbuildinfo
/.cache/
/.venv/
**/.cache/
**/.venv/
/build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
.ninja_deps
.ninja_log
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
/var/runs/
/var/audit/
/var/json/
/var/private/
/var/unification/
/var/winclean-live/
/var/data/
/tools/var/
*.pem
*.key
*.p12
*.pfx
*.kdbx
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.db
*.dump
# Database fixtures are source inputs; generated databases belong in var/.
!**/fixtures/**/*.db
!**/fixtures/**/*.sqlite
!**/fixtures/**/*.sqlite3
!**/fixtures/**/*.dump
/upstream/discord/packages/discordx/coverage/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
!.env.*.example
/secrets/
/cookies/
/.npmrc
.claude/settings.local.json
*.heapsnapshot
*.heapsnapshot.*
*.heapprofile
*.heapprofile.*
*.heaptimeline
*.heaptimeline.*
*.cpuprofile
*.cpuprofile.*
/.coord/
**/.coord/

# Host editor and file-manager state.
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vs/

# Generated host native artifacts; staged by the package builder.
/packages/interop/native/native/

# Translation caches written by test/dev runs
.aphrody-translate-cache.json
.neon
*.db-shm
*.db-wal
/packages/shell/web/pkg/
# Bun's WebOS owner is qualified; local retired artifacts remain ignored pending permitted cleanup.
/packages/web/webos-wasm/wasm/
/crates/ui/app/examples/shell_e2e/frontend/pkg/
/crates/ui/app/examples/shell_e2e/frontend/index.js
# Python SDK packaging outputs; the source package remains canonical.
/packages/google/antigravity-sdk-python/build/
/packages/google/antigravity-sdk-python/*.egg-info/


# Per-machine plugin store written by aphrody-ops plugins (absolute local path)
/.agents/plugins.json
# Private owner plugin store (aphrody-labs/plugins checkout, ~/plugins alias); own history and remote
/plugins/
/vendor

# Hardening: logs, merge leftovers, worktrees and toolchain state.
*.log
!docs/**/*.log
*.orig
*.rej
*.bak
*.tmp
*.old
npm-debug.log*
.claude/worktrees/
.claude/jobs/
.codex/sessions/
**/target-*/
.sccache/
.uv-cache/
.bun/
*.bun-build
.turbo/
.next/
.parcel-cache/
*.tgz
!**/fixtures/**/*.tgz
!**/test/**/*.tgz

# Upstream mirrors regenerated by sources:sync (shallow/sparse); not stored in Git.

# Fetched by scripts/tools/vendor/fetch.ts from tools/config/vendor.json
/m3/forks/
/py/vendor/

# Machine state gathered by scripts/tools/portable (tools/config/portable.json); never committed.
/.portable/

# JavaScript build output of the Tauri fork packages (crates/tauri/build-js.ts)
/crates/tauri/*/dist/
/crates/tauri/*/dist-js/

# Tauri permission JSON schema: written by tauri-plugin/tauri-build at compile time (one identical copy per plugin).
**/permissions/schemas/schema.json
graphify-out/
GRAPH_REPORT.md
packages/infra/product/site/dist/

# Native Web reference corpus: regenerable public mirrors and acquisition receipts.
/var/mirrors/
/var/cdn/
