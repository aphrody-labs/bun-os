{
  "openapi": "3.1.0",
  "info": {
    "title": "Bun OS product API",
    "version": "1.4.7",
    "description": "Read-only product snapshot: sources and their revisions, apps and their qualification, API owners and process status. Every route except /health and /openapi.json needs the application bearer token.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "https://api.aphrody.com/v1/bunos",
      "description": "Bun OS API gateway"
    }
  ],
  "paths": {
    "/apps": {
      "get": {
        "operationId": "getApps",
        "summary": "Apps and qualification",
        "tags": ["product"],
        "responses": {
          "200": {
            "description": "Apps",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health",
        "description": "Liveness and version of the running release; 503 when a required check fails.",
        "tags": ["contract"],
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenapi",
        "summary": "OpenAPI document",
        "description": "This document (OpenAPI 3.1).",
        "tags": ["contract"],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/owners": {
      "get": {
        "operationId": "getOwners",
        "summary": "API owners",
        "tags": ["product"],
        "responses": {
          "200": {
            "description": "Owner of each surface",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/sources": {
      "get": {
        "operationId": "getSources",
        "summary": "Product sources",
        "tags": ["product"],
        "responses": {
          "200": {
            "description": "Sources and revisions",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Process status",
        "tags": ["product"],
        "responses": {
          "200": {
            "description": "Product, runtime and catalog",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details",
        "required": ["type", "title", "status"],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference",
            "default": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status", "service", "version"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "degraded", "down"]
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "commit": {
            "type": ["string", "null"]
          },
          "channel": {
            "type": ["string", "null"]
          },
          "uptimeSeconds": {
            "type": "integer",
            "minimum": 0
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Check"
            }
          }
        }
      },
      "Check": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "optional": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Error",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid bearer token",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "x-service": "bunos"
}
