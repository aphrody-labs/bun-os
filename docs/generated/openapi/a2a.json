{
  "components": {
    "responses": {
      "Problem": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Error"
      },
      "Unauthorized": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Missing or invalid bearer token"
      }
    },
    "schemas": {
      "Check": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "optional": {
            "type": "boolean"
          }
        },
        "required": ["ok"],
        "type": "object"
      },
      "Health": {
        "properties": {
          "channel": {
            "type": ["string", "null"]
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Check"
            },
            "type": "object"
          },
          "commit": {
            "type": ["string", "null"]
          },
          "service": {
            "type": "string"
          },
          "status": {
            "enum": ["ok", "degraded", "down"],
            "type": "string"
          },
          "uptimeSeconds": {
            "minimum": 0,
            "type": "integer"
          },
          "version": {
            "type": "string"
          }
        },
        "required": ["status", "service", "version"],
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem details",
        "properties": {
          "detail": {
            "type": "string"
          },
          "instance": {
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": ["type", "title", "status"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
