{
  "openapi": "3.1.0",
  "info": {
    "title": "Aphrody fonts and asset CDN",
    "version": "1.4.7",
    "description": "Google Fonts edge proxy with the fonts.googleapis.com and fonts.gstatic.com paths, restricted to the Material 3 families and Material Symbols, plus the content-addressed asset CDN release trees.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "https://api.aphrody.com/v1/fonts",
      "description": "Bun OS API gateway"
    }
  ],
  "paths": {
    "/css": {
      "get": {
        "operationId": "getCss",
        "summary": "Font CSS (v1 API)",
        "tags": ["fonts"],
        "parameters": [
          {
            "name": "family",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stylesheet",
            "content": {
              "text/css": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Family not allowed",
            "content": {
              "text/plain": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "Family not allowed",
            "content": {
              "text/plain": {
                "schema": {}
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-error-format": "text"
      }
    },
    "/css2": {
      "get": {
        "operationId": "getCss2",
        "summary": "Font CSS (css2 API)",
        "tags": ["fonts"],
        "parameters": [
          {
            "name": "family",
            "in": "query",
            "required": true,
            "description": "Family and axes, repeatable",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stylesheet with rewritten font URLs",
            "content": {
              "text/css": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Family not allowed",
            "content": {
              "text/plain": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "Family not allowed",
            "content": {
              "text/plain": {
                "schema": {}
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-error-format": "text"
      }
    },
    "/h/{file}": {
      "get": {
        "operationId": "getHByFile",
        "summary": "Content-addressed asset",
        "tags": ["assets"],
        "parameters": [
          {
            "name": "file",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Immutable file named by its hash",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health",
        "description": "Liveness and version of the running release; 503 when a required check fails.",
        "tags": ["contract"],
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/icon": {
      "get": {
        "operationId": "getIcon",
        "summary": "Icon font CSS",
        "tags": ["fonts"],
        "parameters": [
          {
            "name": "family",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stylesheet",
            "content": {
              "text/css": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Family not allowed",
            "content": {
              "text/plain": {
                "schema": {}
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-error-format": "text"
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenapi",
        "summary": "OpenAPI document",
        "description": "This document (OpenAPI 3.1).",
        "tags": ["contract"],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/s/{path}": {
      "get": {
        "operationId": "getSByPath",
        "summary": "Font file, Material Symbols SVG or asset CDN file",
        "description": "`/s/<family>/v<n>/<file>.woff2` (immutable), `/s/i/...` icons, `/s/<scope>/<path>` CDN release files.",
        "tags": ["fonts", "assets"],
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Family not allowed",
            "content": {
              "text/plain": {
                "schema": {}
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-error-format": "text"
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details",
        "required": ["type", "title", "status"],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference",
            "default": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status", "service", "version"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "degraded", "down"]
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "commit": {
            "type": ["string", "null"]
          },
          "channel": {
            "type": ["string", "null"]
          },
          "uptimeSeconds": {
            "type": "integer",
            "minimum": 0
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Check"
            }
          }
        }
      },
      "Check": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "optional": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Error",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid bearer token",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  },
  "x-service": "fonts"
}
