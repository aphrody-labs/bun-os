{
  "components": {
    "responses": {
      "Problem": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Error"
      },
      "Unauthorized": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Missing or invalid bearer token"
      }
    },
    "schemas": {
      "Check": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "optional": {
            "type": "boolean"
          }
        },
        "required": ["ok"],
        "type": "object"
      },
      "Health": {
        "properties": {
          "channel": {
            "type": ["string", "null"]
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Check"
            },
            "type": "object"
          },
          "commit": {
            "type": ["string", "null"]
          },
          "service": {
            "type": "string"
          },
          "status": {
            "enum": ["ok", "degraded", "down"],
            "type": "string"
          },
          "uptimeSeconds": {
            "minimum": 0,
            "type": "integer"
          },
          "version": {
            "type": "string"
          }
        },
        "required": ["status", "service", "version"],
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem details",
        "properties": {
          "detail": {
            "type": "string"
          },
          "instance": {
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": ["type", "title", "status"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Sessions of the host's Bun OS desktops and their WebSocket stream, the emulator catalog and its qualification, and the inventory of every Bun OS member (records and JSON-RPC).",
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache-2.0"
    },
    "title": "Bun OS WebOS server",
    "version": "1.4.7"
  },
  "openapi": "3.1.0",
  "paths": {
