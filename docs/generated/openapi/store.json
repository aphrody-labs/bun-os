{
  "openapi": "3.1.0",
  "info": {
    "title": "Bun OS Store",
    "version": "1.4.7",
    "description": "Read-only Store data: the unified catalog over pacman, apk, flatpak, npm, cargo, Android, winget, apt and AppStream, its qualification results, one index per format, and a winget REST source.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "https://api.aphrody.com/v1/store",
      "description": "Bun OS API gateway"
    }
  ],
  "paths": {
    "/catalog": {
      "get": {
        "operationId": "getCatalog",
        "summary": "Store catalog",
        "tags": ["catalog"],
        "responses": {
          "200": {
            "description": "Unified catalog",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Not generated yet",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health",
        "description": "Liveness and version of the running release; 503 when a required check fails.",
        "tags": ["contract"],
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/index/{format}": {
      "get": {
        "operationId": "getIndexByFormat",
        "summary": "Package index of one format",
        "tags": ["catalog"],
        "parameters": [
          {
            "name": "format",
            "in": "path",
            "description": "Package format",
            "schema": {
              "type": "string",
              "enum": ["pacman", "apk", "flatpak", "npm", "cargo", "android", "winget", "apt", "appstream"]
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Index entries",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Unknown format or not generated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenapi",
        "summary": "OpenAPI document",
        "description": "This document (OpenAPI 3.1).",
        "tags": ["contract"],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/qualification": {
      "get": {
        "operationId": "getQualification",
        "summary": "Qualification results",
        "description": "Last install/run qualification of every package format.",
        "tags": ["catalog"],
        "responses": {
          "200": {
            "description": "Qualification report",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Not generated yet",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/winget/information": {
      "get": {
        "operationId": "getWingetInformation",
        "summary": "winget REST source information",
        "tags": ["winget"],
        "responses": {
          "200": {
            "description": "Source information (winget-cli-restsource)",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-error-format": "winget"
      }
    },
    "/winget/manifestSearch": {
      "post": {
        "operationId": "postWingetManifestSearch",
        "summary": "winget manifest search",
        "tags": ["winget"],
        "requestBody": {
          "required": true,
          "description": "winget ManifestSearchRequest",
          "content": {
            "application/json": {
              "schema": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Matching packages",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "204": {
            "description": "No match",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid JSON",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-error-format": "winget"
      }
    },
    "/winget/packageManifests/{id}": {
      "get": {
        "operationId": "getWingetPackageManifestsById",
        "summary": "winget package manifest",
        "tags": ["winget"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Version",
            "in": "query",
            "description": "Only this package version",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Package manifests",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "204": {
            "description": "No such version",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Package not found",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-error-format": "winget"
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details",
        "required": ["type", "title", "status"],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference",
            "default": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status", "service", "version"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "degraded", "down"]
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "commit": {
            "type": ["string", "null"]
          },
          "channel": {
            "type": ["string", "null"]
          },
          "uptimeSeconds": {
            "type": "integer",
            "minimum": 0
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Check"
            }
          }
        }
      },
      "Check": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "optional": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Error",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid bearer token",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  },
  "x-service": "store"
}
