// Aphrody (dark) for COSMIC: a complete cosmic-theme ThemeBuilder (pop-os/libcosmic cosmic-theme/src/model/
// theme.rs, #[version = 2]). It equals ThemeBuilder::dark() in the Bun OS libcosmic fork (aphrody-labs/libcosmic),
// so it is already the built-in default; this file lets `bunos-theme-set aphrody` switch back to it after
// another theme (cosmic-settings appearance import).
// Colours: the WebOS Aphrody M3 dark roles (apps/webos/src/themes.ts, factory/distro/themes/aphrody): surface
// #11131d, surface-container #1b1e2b, -high #232736, surface-variant #2c3142, on-surface #e1e3f2, primary
// #a9b8ff, error #ffb4ab. Geometry follows Omarchy: Square corners (rounding 0 -> COSMIC's 2 px minimum),
// gaps (10, 10), active hint 2 px in the accent. Palette and spacing are libcosmic's defaults.
(
    palette: Dark((name: "aphrody-dark", bright_red: "#FFA09AFF", bright_green: "#5EDB8CFF", bright_orange: "#FFA37DFF", gray_1: "#1B1B1BFF", gray_2: "#262626FF", neutral_0: "#000000FF", neutral_1: "#030303FF", neutral_2: "#161616FF", neutral_3: "#2E2E2EFF", neutral_4: "#484848FF", neutral_5: "#636363FF", neutral_6: "#808080FF", neutral_7: "#9E9E9EFF", neutral_8: "#BEBEBEFF", neutral_9: "#DEDEDEFF", neutral_10: "#FFFFFFFF", accent_blue: "#63D0DFFF", accent_indigo: "#A1C0EBFF", accent_purple: "#E79CFEFF", accent_pink: "#FF9CB1FF", accent_red: "#FDA1A0FF", accent_orange: "#FFAD00FF", accent_yellow: "#F7E062FF", accent_green: "#92CF9CFF", accent_warm_grey: "#CABAB4FF", ext_warm_grey: "#9B8E8AFF", ext_orange: "#FFAD00FF", ext_yellow: "#FEDB40FF", ext_blue: "#48B9C7FF", ext_purple: "#CF7DFFFF", ext_pink: "#F93A83FF", ext_indigo: "#3E88FFFF")),
    spacing: (space_none: 0, space_xxxs: 4, space_xxs: 8, space_xs: 12, space_s: 16, space_m: 24, space_l: 32, space_xl: 48, space_xxl: 64, space_xxxl: 128),
    corner_radii: (radius_0: (0.0, 0.0, 0.0, 0.0), radius_xs: (2.0, 2.0, 2.0, 2.0), radius_s: (2.0, 2.0, 2.0, 2.0), radius_m: (2.0, 2.0, 2.0, 2.0), radius_l: (2.0, 2.0, 2.0, 2.0), radius_xl: (2.0, 2.0, 2.0, 2.0)),
    neutral_tint: Some("#2C3142FF"),
    bg_color: Some("#11131DFF"),
    primary_container_bg: Some("#1B1E2BFF"),
    secondary_container_bg: Some("#232736FF"),
    text_tint: Some("#E1E3F2FF"),
    accent: Some("#A9B8FFFF"),
    success: Some("#8FD694FF"),
    warning: Some("#F0C674FF"),
    destructive: Some("#FFB4ABFF"),
    gaps: (10, 10),
    active_hint: 2,
    window_hint: Some("#A9B8FFFF"),
)
