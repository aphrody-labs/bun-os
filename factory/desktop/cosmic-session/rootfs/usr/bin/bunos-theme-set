#!/bin/sh
# SPDX-License-Identifier: MIT
# bunos-theme-set NAME: Omarchy's theme switch (omarchy-theme-set, basecamp/omarchy, MIT) for COSMIC.
# Applies /usr/share/bunos/themes/NAME (generated by factory/distro/cosmic-themes.ts from the Omarchy themes):
# COSMIC theme (cosmic-settings appearance import, which also rebuilds GTK colours when "apply theme to GTK"
# is on), icon theme, Rio terminal colours and the theme's first wallpaper. `bunos-theme-set` alone lists.
set -eu
ROOT=/usr/share/bunos/themes
CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
if [ $# -eq 0 ]; then
  for d in "$ROOT"/*/; do [ -f "$d/cosmic.ron" ] && basename "$d"; done
  exit 0
fi
name=$(printf '%s' "$1" | tr '[:upper:] ' '[:lower:]-')
case "$name" in */* | .* | "") echo "invalid theme: $1" >&2; exit 2 ;; esac
dir="$ROOT/$name"
[ -f "$dir/cosmic.ron" ] || { echo "no such theme: $name (see bunos-theme-set)" >&2; exit 1; }

cosmic-settings appearance import "$dir/cosmic.ron"

icons=$(sed -n 's/.*"icons": *"\([^"]*\)".*/\1/p' "$dir/theme.json")
if [ -n "$icons" ] && [ -d "/usr/share/icons/$icons" ]; then
  mkdir -p "$CONF/cosmic/com.system76.CosmicTk/v1"
  printf '"%s"' "$icons" >"$CONF/cosmic/com.system76.CosmicTk/v1/icon_theme"
fi

mkdir -p "$CONF/rio/themes"
ln -sf "$dir/rio.toml" "$CONF/rio/themes/bunos.toml"
if [ ! -f "$CONF/rio/config.toml" ]; then
  printf 'theme = "bunos"\n' >"$CONF/rio/config.toml"
elif ! grep -q '^theme *=' "$CONF/rio/config.toml"; then
  printf 'theme = "bunos"\n%s\n' "$(cat "$CONF/rio/config.toml")" >"$CONF/rio/config.toml"
fi

if [ -d "$dir/backgrounds" ]; then
  mkdir -p "$CONF/cosmic/com.system76.CosmicBackground/v1"
  printf '(output: "all", source: Path("%s"), filter_by_theme: false, rotation_frequency: 900, filter_method: Lanczos, scaling_mode: Zoom, sampling_method: Alphanumeric)' \
    "$dir/backgrounds" >"$CONF/cosmic/com.system76.CosmicBackground/v1/all"
fi

mkdir -p "$CONF/bunos"
printf '%s\n' "$name" >"$CONF/bunos/theme"
command -v notify-send >/dev/null 2>&1 && notify-send -a "Bun OS" -i preferences-desktop-theme "Theme" "$name" || true
