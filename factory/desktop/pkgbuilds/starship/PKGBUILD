# Source: https://github.com/aphrody-labs/starship.git at the gitlink vendor/starship (upstream release v1.27.0 (2026-10-17)).
pkgname=starship
pkgver=0
pkgrel=1
pkgdesc='starship prompt (Bun OS, built from the aphrody-labs fork)'
arch=(x86_64)
url='https://github.com/aphrody-labs/starship'
license=('ISC')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'git' 'cmake')
options=(!lto)
source=("$pkgname::git+https://github.com/aphrody-labs/starship.git#commit=f8e4e2155542cc84f49b342122d371f74e0ad253")
b2sums=('SKIP')

pkgver() {
  cd "$pkgname"
  # Only release-looking tags count (yazi also tags "nightly" on release commits).
  local m=(--match 'v[0-9]*' --match '[0-9]*') v
  if v=$(git describe --tags --exact-match "${m[@]}" 2>/dev/null); then
    v=$(sed 's/^v//; s/-/./g' <<<"$v")
  elif v=$(git describe --tags --long "${m[@]}" 2>/dev/null); then
    v=$(sed 's/^v//; s/-\([0-9]*\)-g/.r\1.g/; s/-/./g' <<<"$v")
  else
    v=r$(git rev-list --count HEAD).$(git rev-parse --short=12 HEAD)
  fi
  printf '%s' "$v"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 "target/release/starship" "$pkgdir/usr/bin/starship"
  for f in LICENSE* COPYING* UNLICENSE*; do
    [[ -f $f ]] && install -Dm644 "$f" "$pkgdir/usr/share/licenses/$pkgname/$f"
  done
  true
}
