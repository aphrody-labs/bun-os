# Source: https://github.com/aphrody-labs/atuin.git at the gitlink vendor/atuin (upstream release v18.24.4 (2026-10-30)).
pkgname=atuin
pkgver=0
pkgrel=1
pkgdesc='atuin, synced shell history (Bun OS, built from the aphrody-labs fork)'
arch=(x86_64)
url='https://github.com/aphrody-labs/atuin'
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'git' 'protobuf')
options=(!lto)
source=("$pkgname::git+https://github.com/aphrody-labs/atuin.git#commit=b7ccdaf6b71f648d096de24b66cc8c7821d73351")
b2sums=('SKIP')

pkgver() {
  cd "$pkgname"
  # Only release-looking tags count (yazi also tags "nightly" on release commits).
  local m=(--match 'v[0-9]*' --match '[0-9]*') v
  if v=$(git describe --tags --exact-match "${m[@]}" 2>/dev/null); then
    v=$(sed 's/^v//; s/-/./g' <<<"$v")
  elif v=$(git describe --tags --long "${m[@]}" 2>/dev/null); then
    v=$(sed 's/^v//; s/-\([0-9]*\)-g/.r\1.g/; s/-/./g' <<<"$v")
  else
    v=r$(git rev-list --count HEAD).$(git rev-parse --short=12 HEAD)
  fi
  printf '%s' "$v"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release -p atuin
}

package() {
  cd "$pkgname"
  install -Dm755 "target/release/atuin" "$pkgdir/usr/bin/atuin"
  for f in LICENSE* COPYING* UNLICENSE*; do
    [[ -f $f ]] && install -Dm644 "$f" "$pkgdir/usr/share/licenses/$pkgname/$f"
  done
  true
}
