# Generated by factory/desktop/pkgbuilds.ts from factory/desktop/cli.json; do not edit.
# Source: https://github.com/aphrody-labs/helix.git at the gitlink vendor/helix (upstream release 25.07.1 (2025-07-18; master active 2026-09)).
pkgname=helix
pkgver=0
pkgrel=1
pkgdesc='Helix modal editor (grammars: hx --grammar fetch && hx --grammar build) (Bun OS, built from the aphrody-labs fork)'
arch=(x86_64)
url='https://github.com/aphrody-labs/helix'
license=('MPL-2.0')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'git')
options=(!lto)
source=("$pkgname::git+https://github.com/aphrody-labs/helix.git#commit=a05c151bb6e8e9c65ec390b0ae2afe7a5efd619b")
b2sums=('SKIP')

pkgver() {
  cd "$pkgname"
  # Only release-looking tags count (yazi also tags "nightly" on release commits).
  local m=(--match 'v[0-9]*' --match '[0-9]*') v
  if v=$(git describe --tags --exact-match "${m[@]}" 2>/dev/null); then
    v=$(sed 's/^v//; s/-/./g' <<<"$v")
  elif v=$(git describe --tags --long "${m[@]}" 2>/dev/null); then
    v=$(sed 's/^v//; s/-\([0-9]*\)-g/.r\1.g/; s/-/./g' <<<"$v")
  else
    v=r$(git rev-list --count HEAD).$(git rev-parse --short=12 HEAD)
  fi
  printf '%s' "$v"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  export HELIX_DISABLE_AUTO_GRAMMAR_BUILD=1 HELIX_DEFAULT_RUNTIME=/usr/lib/helix/runtime
  cargo build --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 "target/release/hx" "$pkgdir/usr/bin/hx"
  install -d "$pkgdir/usr/lib/helix" && cp -r runtime "$pkgdir/usr/lib/helix/" && rm -rf "$pkgdir/usr/lib/helix/runtime/grammars/sources"
  for f in LICENSE* COPYING* UNLICENSE*; do
    [[ -f $f ]] && install -Dm644 "$f" "$pkgdir/usr/share/licenses/$pkgname/$f"
  done
  true
}
