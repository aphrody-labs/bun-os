# Generated by factory/desktop/pkgbuilds.ts from factory/desktop/cli.json; do not edit.
# Source: https://github.com/aphrody-labs/gitui.git at the gitlink vendor/gitui (upstream release v0.28.1 (2026-03-24; master active 2026-10)).
pkgname=gitui
pkgver=0
pkgrel=1
pkgdesc='gitui, terminal UI for git (Bun OS, built from the aphrody-labs fork)'
arch=(x86_64)
url='https://github.com/aphrody-labs/gitui'
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'git' 'cmake' 'perl')
options=(!lto)
source=("$pkgname::git+https://github.com/aphrody-labs/gitui.git#commit=e24fb45df1584ee8d8ebdc4258531b4a91ca975d")
b2sums=('SKIP')

pkgver() {
  cd "$pkgname"
  local tag
  if tag=$(git describe --tags --exact-match 2>/dev/null); then
    printf '%s' "${tag#v}" | sed 's/^[^0-9]*//; s/-/./g'
  else
    git describe --tags --long 2>/dev/null | sed 's/^[^0-9]*//; s/-\([0-9]*\)-g/.r\1.g/; s/-/./g' ||
      printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=12 HEAD)"
  fi
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 "target/release/gitui" "$pkgdir/usr/bin/gitui"
  for f in LICENSE* COPYING* UNLICENSE*; do
    [[ -f $f ]] && install -Dm644 "$f" "$pkgdir/usr/share/licenses/$pkgname/$f"
  done
  true
}
