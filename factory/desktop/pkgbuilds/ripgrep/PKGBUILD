# Source: https://github.com/aphrody-labs/ripgrep.git at the gitlink vendor/ripgrep (upstream release 15.2.0 (2026-07-15)).
pkgname=ripgrep
pkgver=0
pkgrel=1
pkgdesc='ripgrep (rg) (Bun OS, built from the aphrody-labs fork)'
arch=(x86_64)
url='https://github.com/aphrody-labs/ripgrep'
license=('MIT OR Unlicense')
depends=('gcc-libs' 'glibc' 'pcre2')
makedepends=('cargo' 'git')
options=(!lto)
source=("$pkgname::git+https://github.com/aphrody-labs/ripgrep.git#commit=e89fff89ac9af12e8d4ce9d5fd07beb408ca730f")
b2sums=('SKIP')

pkgver() {
  cd "$pkgname"
  local tag
  if tag=$(git describe --tags --exact-match 2>/dev/null); then
    printf '%s' "${tag#v}" | sed 's/^[^0-9]*//; s/-/./g'
  else
    git describe --tags --long 2>/dev/null | sed 's/^[^0-9]*//; s/-\([0-9]*\)-g/.r\1.g/; s/-/./g' ||
      printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=12 HEAD)"
  fi
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release --features pcre2
}

package() {
  cd "$pkgname"
  install -Dm755 "target/release/rg" "$pkgdir/usr/bin/rg"
  for f in LICENSE* COPYING* UNLICENSE*; do
    [[ -f $f ]] && install -Dm644 "$f" "$pkgdir/usr/share/licenses/$pkgname/$f"
  done
  true
}
