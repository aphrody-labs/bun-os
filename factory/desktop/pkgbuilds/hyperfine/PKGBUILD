# Generated by factory/desktop/pkgbuilds.ts from factory/desktop/cli.json; do not edit.
# Source: https://github.com/aphrody-labs/hyperfine.git at the gitlink vendor/hyperfine (upstream release v2.0.0 (2026-10-07)).
pkgname=hyperfine
pkgver=0
pkgrel=1
pkgdesc='hyperfine benchmarking (Bun OS, built from the aphrody-labs fork)'
arch=(x86_64)
url='https://github.com/aphrody-labs/hyperfine'
license=('MIT OR Apache-2.0')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'git')
options=(!lto)
source=("$pkgname::git+https://github.com/aphrody-labs/hyperfine.git#commit=b33755fe1fca8bcc1f182c773ca3ab040bfe517d")
b2sums=('SKIP')

pkgver() {
  cd "$pkgname"
  # Only release-looking tags count (yazi also tags "nightly" on release commits).
  local m=(--match 'v[0-9]*' --match '[0-9]*') v
  if v=$(git describe --tags --exact-match "${m[@]}" 2>/dev/null); then
    v=$(sed 's/^v//; s/-/./g' <<<"$v")
  elif v=$(git describe --tags --long "${m[@]}" 2>/dev/null); then
    v=$(sed 's/^v//; s/-\([0-9]*\)-g/.r\1.g/; s/-/./g' <<<"$v")
  else
    v=r$(git rev-list --count HEAD).$(git rev-parse --short=12 HEAD)
  fi
  printf '%s' "$v"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 "target/release/hyperfine" "$pkgdir/usr/bin/hyperfine"
  for f in LICENSE* COPYING* UNLICENSE*; do
    [[ -f $f ]] && install -Dm644 "$f" "$pkgdir/usr/share/licenses/$pkgname/$f"
  done
  true
}
