# Source: https://github.com/aphrody-labs/eza.git at the gitlink vendor/eza (upstream release v0.23.5 (2026-07-09)).
pkgname=eza
pkgver=0
pkgrel=1
pkgdesc='eza, a modern ls (Bun OS, built from the aphrody-labs fork)'
arch=(x86_64)
url='https://github.com/aphrody-labs/eza'
license=('EUPL-1.2')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'git')
options=(!lto)
source=("$pkgname::git+https://github.com/aphrody-labs/eza.git#commit=471bfbc7b03cbac8c738e8d9050edb06ee79132a")
b2sums=('SKIP')

pkgver() {
  cd "$pkgname"
  local tag
  if tag=$(git describe --tags --exact-match 2>/dev/null); then
    printf '%s' "${tag#v}" | sed 's/^[^0-9]*//; s/-/./g'
  else
    git describe --tags --long 2>/dev/null | sed 's/^[^0-9]*//; s/-\([0-9]*\)-g/.r\1.g/; s/-/./g' ||
      printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=12 HEAD)"
  fi
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 "target/release/eza" "$pkgdir/usr/bin/eza"
  for f in LICENSE* COPYING* UNLICENSE*; do
    [[ -f $f ]] && install -Dm644 "$f" "$pkgdir/usr/share/licenses/$pkgname/$f"
  done
  true
}
