# Source: https://github.com/aphrody-labs/rio.git at the gitlink vendor/rio (upstream release v0.5.29 (2026-11-01)).
pkgname=rio
pkgver=0
pkgrel=1
pkgdesc='Rio terminal (WebGPU/wgpu), the Bun OS terminal (Bun OS, built from the aphrody-labs fork)'
arch=(x86_64)
url='https://github.com/aphrody-labs/rio'
license=('MIT')
depends=('gcc-libs' 'glibc' 'fontconfig' 'freetype2' 'libxkbcommon' 'wayland' 'vulkan-icd-loader')
makedepends=('cargo' 'git' 'cmake' 'shaderc')
options=(!lto)
source=("$pkgname::git+https://github.com/aphrody-labs/rio.git#commit=59203ccd5fa1e6b760a738c1ad653bb29f2f3465")
b2sums=('SKIP')

pkgver() {
  cd "$pkgname"
  # Only release-looking tags count (yazi also tags "nightly" on release commits).
  local m=(--match 'v[0-9]*' --match '[0-9]*') v
  if v=$(git describe --tags --exact-match "${m[@]}" 2>/dev/null); then
    v=$(sed 's/^v//; s/-/./g' <<<"$v")
  elif v=$(git describe --tags --long "${m[@]}" 2>/dev/null); then
    v=$(sed 's/^v//; s/-\([0-9]*\)-g/.r\1.g/; s/-/./g' <<<"$v")
  else
    v=r$(git rev-list --count HEAD).$(git rev-parse --short=12 HEAD)
  fi
  printf '%s' "$v"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release -p rioterm
}

package() {
  cd "$pkgname"
  install -Dm755 "target/release/rio" "$pkgdir/usr/bin/rio"
  for f in LICENSE* COPYING* UNLICENSE*; do
    [[ -f $f ]] && install -Dm644 "$f" "$pkgdir/usr/share/licenses/$pkgname/$f"
  done
  true
}
