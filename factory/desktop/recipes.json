  "groups": {
    "gtk4": ["glib", "fribidi", "harfbuzz", "cairo", "pango", "gdk-pixbuf", "graphene", "libepoxy", "gtk4"],
    "libadwaita": ["gtk4", "libadwaita"],
    "qt6": ["qtbase", "qtshadertools", "qttools", "qtdeclarative"],
    "kf6": ["qtbase", "qttools", "ecm", "kcoreaddons", "ki18n"],
    "plasma-libs": ["kf6", "plasma-workspace"],
    "samples": ["hello-gtk4", "hello-qt", "hello-qml", "hello-kcoreaddons"]
