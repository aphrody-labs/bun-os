{
  "schemaVersion": 1,
  "kind": "buncc-desktop-recipes",
  "verified": "2026-10-29",
  "note": "Pinned recipes for `buncc desktop`. `track` says how `buncc desktop plan --pin` resolves the newest stable upstream tag; `pin` is the resolved tag and commit that `fetch` verifies. Decisions: docs/BUNCC-DESKTOP.md.",
  "targets": {
    "x86_64-pc-windows-msvc": {
      "kind": "msvc",
      "arch": "x64",
      "cross": false
    },
    "aarch64-pc-windows-msvc": {
      "kind": "msvc",
      "arch": "arm64",
      "cross": true,
      "needs": "MSVC ARM64 libraries (VC.Tools.ARM64) or cargo-xwin splat"
    },
    "x86_64-pc-windows-gnullvm": {
      "kind": "llvm-mingw",
      "triple": "x86_64-w64-mingw32",
      "cross": true
    },
    "aarch64-pc-windows-gnullvm": {
      "kind": "llvm-mingw",
      "triple": "aarch64-w64-mingw32",
      "cross": true
    }
  },
  "tools": {
    "meson": {
      "source": "pypi",
      "name": "meson",
      "version": "1.12.1",
      "why": "GNOME build system; WrapDB and project wraps resolve through it"
    },
    "ninja": {
      "source": "pypi",
      "name": "ninja",
      "version": "1.13.0",
      "why": "Kitware-compatible ninja wheel, one DAG for the whole stack"
    },
    "pkgconf": {
      "source": "git",
      "repo": "https://github.com/pkgconf/pkgconf",
      "tag": "pkgconf-3.0.10",
      "sha": "511e6e6b8c82367e75d02edb56ad98da766e06b6",
      "build": "meson"
    },
    "win-flex-bison": {
      "source": "zip",
      "url": "https://github.com/lexxmark/winflexbison/releases/download/v2.5.25/win_flex_bison-2.5.25.zip",
      "sha256": "8d324b62be33604b2c45ad1dd34ab93d722534448f55a16ca7292de32b6ac135"
    },
    "gettext": {
      "source": "zip",
      "url": "https://github.com/mlocati/gettext-iconv-windows/releases/download/v1.0-v1.19/gettext1.0-iconv1.19-static-64.zip",
      "sha256": "2b999bc37b56fa052ff98578e9cb188152009f634e3a66aa8ff263a016e9c466",
      "why": "msgfmt/xgettext for KI18n and ECM translations"
    }
  },
  "packages": [
    {
      "id": "glib",
      "group": "gtk4",
      "build": "meson",
      "repo": "https://github.com/GNOME/glib",
      "track": {
        "pattern": "^(\\d+)\\.(\\d*[02468])\\.(\\d+)$"
      },
      "pin": {
        "tag": "2.90.1",
        "sha": "e05063ccc6c8f222465a1080927f4c14349f3de6"
      },
      "deps": [],
      "options": [
        "-Dtests=false",
        "-Dnls=disabled",
        "-Dintrospection=disabled",
        "-Dglib_debug=disabled",
        "-Dman-pages=disabled",
        "-Dsysprof=disabled",
        "-Dlibelf=disabled"
      ],
      "wraps": "its own subprojects/*.wrap (libffi, pcre2, zlib, proxy-libintl, gvdb)"
    },
    {
      "id": "fribidi",
      "group": "gtk4",
      "build": "meson",
      "repo": "https://github.com/fribidi/fribidi",
      "track": {
        "pattern": "^v(\\d+)\\.(\\d+)\\.(\\d+)$"
      },
      "pin": {
        "tag": "v1.0.17",
        "sha": "b93119f5fdc7ea47672cc304c1455ffa6dfe7536"
      },
      "deps": [],
      "options": ["-Ddocs=false", "-Dbin=false", "-Dtests=false"]
    },
    {
      "id": "harfbuzz",
      "group": "gtk4",
      "build": "meson",
      "repo": "https://github.com/harfbuzz/harfbuzz",
      "track": {
        "pattern": "^(\\d+)\\.(\\d+)\\.(\\d+)$"
      },
      "pin": {
        "tag": "15.0.0",
        "sha": "35f656a1a2bab548ea7f54a6dd3fba2b09680d14"
      },
      "deps": ["glib"],
      "options": [
        "-Dtests=disabled",
        "-Ddocs=disabled",
        "-Dglib=enabled",
        "-Dgobject=enabled",
        "-Dfreetype=enabled",
        "-Dcairo=disabled",
        "-Dicu=disabled",
        "-Dintrospection=disabled",
        "-Dutilities=disabled",
        "-Ddirectwrite=disabled"
      ]
    },
    {
      "id": "cairo",
      "group": "gtk4",
      "build": "meson",
      "repo": "https://gitlab.freedesktop.org/cairo/cairo.git",
      "track": {
        "pattern": "^(\\d+)\\.(\\d*[02468])\\.(\\d+)$"
      },
      "pin": {
        "tag": "1.18.6",
        "sha": "018b3424a10ecd37450360f21454ecf0f3007e17"
      },
      "deps": ["glib"],
      "options": [
        "-Dtests=disabled",
        "-Dfontconfig=disabled",
        "-Dfreetype=enabled",
        "-Dpng=enabled",
        "-Dzlib=enabled",
        "-Dglib=enabled",
        "-Dspectre=disabled",
        "-Dgtk_doc=false",
        "-Dxlib=disabled",
        "-Dxcb=disabled",
        "-Dsymbol-lookup=disabled"
      ],
      "wraps": "cairo subprojects: pixman, freetype2, libpng, zlib"
    },
    {
      "id": "pango",
      "group": "gtk4",
      "build": "meson",
      "repo": "https://github.com/GNOME/pango",
      "track": {
        "pattern": "^(\\d+)\\.(\\d+)\\.(\\d+)$"
      },
      "pin": {
        "tag": "1.58.2",
        "sha": "d360f14004e4a4824f2352f6e2722016f9a51dd6"
      },
      "deps": ["glib", "fribidi", "harfbuzz", "cairo"],
      "options": [
        "-Dintrospection=disabled",
        "-Dfontconfig=disabled",
        "-Dbuild-testsuite=false",
        "-Dbuild-examples=false",
        "-Ddocumentation=false",
        "-Dlibthai=disabled",
        "-Dxft=disabled",
        "-Dcairo=enabled"
      ]
    },
    {
      "id": "gdk-pixbuf",
      "group": "gtk4",
      "build": "meson",
      "repo": "https://github.com/GNOME/gdk-pixbuf",
      "track": {
        "pattern": "^(\\d+)\\.(\\d+)\\.(\\d+)$"
      },
      "pin": {
        "tag": "2.90.3",
        "sha": "aab1a96d46a5b96dfe316cd897880637db98791c"
      },
      "deps": ["glib"],
      "options": [
        "-Dtests=false",
        "-Dinstalled_tests=false",
        "-Dintrospection=disabled",
        "-Ddocumentation=false",
        "-Dman=false",
        "-Dthumbnailer=disabled",
        "-Dothers=disabled",
        "-Dgio_sniffing=false",
        "-Dpng=enabled",
        "-Djpeg=disabled",
        "-Dtiff=disabled",
        "-Dglycin=disabled"
      ]
    },
    {
      "id": "graphene",
      "group": "gtk4",
      "build": "meson",
      "repo": "https://github.com/ebassi/graphene",
      "track": {
        "pattern": "^(\\d+)\\.(\\d+)\\.(\\d+)$"
      },
      "pin": {
        "tag": "1.10.8",
        "sha": "4e2578450809c2099400cf85caf18eafcd7100aa"
      },
      "deps": ["glib"],
      "options": [
        "-Dtests=false",
        "-Dinstalled_tests=false",
        "-Dgobject_types=true",
        "-Dintrospection=disabled",
        "-Dgtk_doc=false",
        "-Dbenchmarks=false"
      ]
    },
    {
      "id": "libepoxy",
      "group": "gtk4",
      "build": "meson",
      "repo": "https://github.com/anholt/libepoxy",
      "track": {
        "pattern": "^(\\d+)\\.(\\d+)\\.(\\d+)$"
      },
      "pin": {
        "tag": "1.5.10",
        "sha": "c84bc9459357a40e46e2fec0408d04fbdde2c973"
      },
      "deps": [],
      "options": ["-Dtests=false", "-Degl=no", "-Dglx=no", "-Dx11=false"]
    },
    {
      "id": "gtk4",
      "group": "gtk4",
      "build": "meson",
      "repo": "https://github.com/GNOME/gtk",
      "track": {
        "pattern": "^4\\.(\\d*[02468])\\.(\\d+)$"
      },
      "pin": {
        "tag": "4.24.1",
        "sha": "2ea935e3ec680fb122f245b28e18c3495df8c344"
      },
      "deps": ["glib", "pango", "cairo", "gdk-pixbuf", "graphene", "libepoxy", "harfbuzz", "fribidi"],
      "options": [
        "-Dbuild-demos=false",
        "-Dbuild-tests=false",
        "-Dbuild-testsuite=false",
        "-Dbuild-examples=false",
        "-Dmedia-gstreamer=disabled",
        "-Dvulkan=disabled",
        "-Dintrospection=disabled",
        "-Ddocumentation=false",
        "-Dman-pages=false",
        "-Dprint-cups=disabled",
        "-Dwin32-backend=true",
        "-Daccesskit=disabled"
