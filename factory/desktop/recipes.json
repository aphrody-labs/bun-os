      "id": "kcoreaddons",
      "group": "kf6",
      "build": "cmake",
      "repo": "https://github.com/KDE/kcoreaddons",
      "track": {
        "pattern": "^v6\\.(\\d+)\\.(\\d+)$"
      },
      "pin": {
        "tag": "v6.31.0",
        "sha": "911a815687a14389895df3e658235de2450bc294"
      },
      "deps": ["ecm", "qtbase", "qttools"],
      "options": [
        "-DBUILD_TESTING=OFF",
        "-DBUILD_QCH=OFF",
        "-DBUILD_PYTHON_BINDINGS=OFF",
        "-DUSE_DBUS=OFF",
        "-DKCOREADDONS_USE_QML=OFF"
      ]
    },
    {
      "id": "ki18n",
      "group": "kf6",
      "build": "cmake",
      "repo": "https://github.com/KDE/ki18n",
      "track": {
        "pattern": "^v6\\.(\\d+)\\.(\\d+)$"
      },
      "pin": {
        "tag": "v6.31.0",
        "sha": "df98b98f001721f83ebf3e36b73e346f6d29670a"
