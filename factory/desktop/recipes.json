        "tag": "1.10.0",
        "sha": "c9ab118612eee92324143783c4641c98eaded3f0"
      },
      "deps": ["gtk4"],
      "options": [
        "-Dintrospection=disabled",
        "-Dvapi=false",
        "-Dtests=false",
        "-Dexamples=false",
        "-Ddocumentation=false",
        "-Dappstream=disabled"
      ]
    },
    {
      "id": "qtbase",
      "group": "qt6",
      "build": "cmake",
      "repo": "https://github.com/qt/qtbase",
      "track": {
        "pattern": "^v6\\.(\\d+)\\.(\\d+)$",
        "lts": "^v6\\.8\\.(\\d+)$"
      },
      "pin": {
        "tag": "v6.12.0",
        "sha": "025bdad181de241e81bf853c8a2d7bf3d19261a9"
      },
      "lts": {
        "tag": "v6.8.3",
        "sha": "c07c2d5a527a644d36e7853d55132ae38921682f"
      },
      "deps": [],
      "options": [
        "-DQT_BUILD_EXAMPLES=OFF",
        "-DQT_BUILD_TESTS=OFF",
        "-DQT_BUILD_BENCHMARKS=OFF",
        "-DBUILD_SHARED_LIBS=ON",
        "-DFEATURE_sql=OFF",
        "-DFEATURE_dbus=OFF",
        "-DFEATURE_testlib=OFF",
        "-DFEATURE_printsupport=OFF",
        "-DFEATURE_system_pcre2=OFF",
        "-DFEATURE_system_zlib=OFF",
        "-DFEATURE_system_freetype=OFF",
        "-DFEATURE_system_harfbuzz=OFF",
        "-DFEATURE_system_png=OFF",
        "-DFEATURE_system_jpeg=OFF",
        "-DFEATURE_system_doubleconversion=OFF",
        "-DFEATURE_system_sqlite=OFF"
      ],
      "note": "qtbase vendors zlib/harfbuzz/freetype/pcre2/libpng; system_* features are forced OFF so GLib/GTK headers in the shared prefix are never picked up"
    },
    {
      "id": "qtshadertools",
      "group": "qt6",
      "build": "cmake",
      "repo": "https://github.com/qt/qtshadertools",
      "track": {
