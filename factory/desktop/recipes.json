      },
      "pin": {
        "tag": "v6.12.0",
        "sha": "bccd516b990a6396900051470ac86cc27a7042ea"
      },
      "deps": ["qtbase"],
      "options": ["-DQT_BUILD_EXAMPLES=OFF", "-DQT_BUILD_TESTS=OFF"]
    },
    {
      "id": "qttools",
      "group": "qt6",
      "build": "cmake",
      "repo": "https://github.com/qt/qttools",
      "track": {
        "pattern": "^v6\\.(\\d+)\\.(\\d+)$"
      },
      "pin": {
        "tag": "v6.12.0",
        "sha": "613a6fbf0a7998010ab2fda260b64066d66a021d"
      },
      "deps": ["qtbase"],
      "options": [
        "-DQT_BUILD_EXAMPLES=OFF",
        "-DQT_BUILD_TESTS=OFF",
        "-DFEATURE_assistant=OFF",
        "-DFEATURE_designer=OFF",
        "-DFEATURE_qdoc=OFF",
        "-DFEATURE_pixeltool=OFF",
        "-DFEATURE_qtdiag=OFF",
        "-DFEATURE_qtplugininfo=OFF",
        "-DFEATURE_distancefieldgenerator=OFF",
        "-DFEATURE_kmap2qmap=OFF",
        "-DFEATURE_qtattributionsscanner=OFF",
        "-DFEATURE_linguist=ON"
      ],
      "note": "LinguistTools (lrelease/lupdate) is what ECMPoQmTools needs"
    },
    {
      "id": "qtdeclarative",
      "group": "qt6",
      "build": "cmake",
      "repo": "https://github.com/qt/qtdeclarative",
      "track": {
        "pattern": "^v6\\.(\\d+)\\.(\\d+)$"
      },
      "pin": {
        "tag": "v6.12.0",
        "sha": "4332fbbb4c340463dc8cee36dda0c85d932122d8"
      },
      "deps": ["qtbase", "qtshadertools"],
      "options": [
