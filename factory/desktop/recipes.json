    {
      "id": "kate",
      "group": "apps",
      "build": "cmake",
      "repo": "https://github.com/KDE/kate",
      "track": {
        "pattern": "^v(\\d+)\\.(\\d+)\\.(\\d+)$"
      },
      "pin": {
        "tag": "v26.08.2",
        "sha": "2b6465a886b9d3bfc6eab25065c14ffe025e6ac3"
      },
      "deps": ["ecm", "qtbase", "qttools", "kcoreaddons", "ki18n"],
      "options": ["-DBUILD_TESTING=OFF"],
      "status": "plan-only",
      "note": "KDE Gear app; example for `build app:kate`. KDE ships Windows builds of it through Craft, so the dependency closure is known to exist."
    },
    {
      "id": "hello-gtk4",
      "group": "samples",
