    {
      "id": "linux-aphrody-bun",
      "sourceId": "linux",
      "revision": "47f637c546bf4bb274c7149815ed66d748e4f325",
      "branch": "aphrody-bun",
      "host": "linux",
      "architecture": "x64",
      "abi": "linux-kernel",
      "license": "GPL-2.0-only",
      "ownerFiles": [
        "Makefile",
        "drivers/misc/Kconfig",
        "Documentation/kbuild/kbuild.rst",
        "Documentation/rust/quick-start.rst",
        "scripts/rust_is_available.sh"
      ],
      "tools": [
        "git",
        "make",
        "gcc",
        "g++",
        "ld",
        "bison",
        "flex",
        "perl",
        "pkg-config",
        "clang",
        "clang++",
        "ld.lld",
        "llvm-ar",
        "llvm-nm",
        "llvm-strip",
        "llvm-objcopy",
        "llvm-objdump",
        "llvm-readelf",
        "rustc",
        "bindgen"
      ],
      "pkgConfig": ["openssl", "libelf"],
      "requirements": [
        "An explicit x86_64 kernel configuration with CONFIG_BUN_ACCEL=y or m",
        "Kernel toolchain and optional configuration dependencies supplied by the host",
        "LLVM toolchain, matching Rust standard library sources and libclang for bindgen; source rustavailable guard must succeed"
      ],
      "steps": [
        {
          "copy": "{kernelConfig}",
          "to": "{out}/build/.config"
        },
        {
          "cmd": [
            "make",
            "-C",
            "{source}",
            "O={out}/build",
            "ARCH=x86",
            "LLVM=1",
            "RUSTC=rustc",
            "BINDGEN=bindgen",
            "rustavailable"
          ],
          "timeoutMs": 30000
        },
        {
          "cmd": [
            "make",
            "-C",
            "{source}",
            "O={out}/build",
            "ARCH=x86",
            "olddefconfig",
            "LLVM=1",
            "RUSTC=rustc",
            "BINDGEN=bindgen"
          ],
          "timeoutMs": 300000,
          "checkKernelConfig": true
        },
        {
          "cmd": [
            "make",
            "-C",
            "{source}",
            "O={out}/build",
            "ARCH=x86",
            "-j2",
            "bzImage",
            "modules",
            "LLVM=1",
            "RUSTC=rustc",
            "BINDGEN=bindgen"
          ],
          "timeoutMs": 14400000
        },
        {
          "cmd": [
            "make",
            "-C",
            "{source}",
            "O={out}/build",
            "ARCH=x86",
            "INSTALL_MOD_PATH={out}/modules",
            "modules_install",
            "LLVM=1",
            "RUSTC=rustc",
            "BINDGEN=bindgen"
          ],
          "timeoutMs": 1800000
        },
        {
          "cmd": [
            "make",
            "-C",
            "{source}",
            "O={out}/build",
            "ARCH=x86",
            "INSTALL_HDR_PATH={out}/headers",
            "headers_install",
            "LLVM=1",
            "RUSTC=rustc",
            "BINDGEN=bindgen"
          ],
          "timeoutMs": 300000
        }
      ],
      "artifacts": ["build/arch/x86/boot/bzImage", "build/vmlinux", "build/.config"],
      "unqualified": [
        "Boot on the selected physical/virtual host",
        "/dev/bun_accel permissions and runtime integration",
        "ARM64 needs its own owner configuration and recipe"
      ]
    },
    {
      "id": "wsl-windows",
