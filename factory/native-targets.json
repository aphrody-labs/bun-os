        "apt-pkg/CMakeLists.txt",
        "apt-pkg/contrib/fileutl.cc",
        "apt-pkg/contrib/mmap.cc",
        "apt-pkg/deb/dpkgpm.cc"
      ],
      "tools": ["git", "cmake", "ninja"],
      "pkgConfig": [],
      "portRequired": true,
      "requirements": [
        "Port CMake POSIX statfs/endian/signal/LFS checks, Perl/Dpkg/id commands, grep/awk generators and GNU version scripts to native Windows generators and DLL exports",
        "Implement UCRT 64-bit file offsets, Win32 locking/mapping/process/pipes, Unicode paths and socket/event operations in the APT owners",
        "Supply MSVC/UCRT builds of Iconv, Berkeley DB, OpenSSL, zlib, bzip2, liblzma, lz4, zstd and xxhash through an explicit CMake toolchain",
        "Supply native signature verifier and a separately ported package-transaction backend; Linux dpkg and ELF payloads are not Windows executables",
        "Compile and qualify libapt-pkg plus apt.exe from the ported revision; the Bun conversion frontend is a separate artifact"
      ],
      "steps": [
        {
          "cmd": [
            "bun",
            "msvc",
            "--arch",
            "x64",
            "exec",
            "--",
            "cmake",
            "-S",
            "{source}",
            "-B",
            "{out}/build",
            "-G",
            "Ninja",
            "-DCMAKE_BUILD_TYPE=Release",
            "-DCMAKE_TOOLCHAIN_FILE={windowsToolchain}",
            "-DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreadedDLL",
            "-DWITH_DOC=OFF",
            "-DWITH_TESTS=OFF",
            "-DUSE_NLS=OFF"
          ],
          "timeoutMs": 300000
        },
