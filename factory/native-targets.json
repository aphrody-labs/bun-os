      "tools": ["git", "cmake", "ninja", "g++", "perl", "triehash", "grep", "awk", "pkg-config", "dpkg-architecture"],
      "pkgConfig": ["openssl", "zlib", "liblzma", "liblz4", "libzstd", "libxxhash"],
      "requirements": [
        "C++23 toolchain",
        "Berkeley DB, bzip2, Iconv and large-file headers/libraries",
