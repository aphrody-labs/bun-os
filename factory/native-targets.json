            "{out}/build",
            "-G",
            "Ninja",
            "-DCMAKE_BUILD_TYPE=Release",
            "-DWITH_DOC=OFF",
            "-DWITH_TESTS=OFF",
            "-DUSE_NLS=OFF",
            "-DCMAKE_INSTALL_PREFIX=/usr"
          ],
          "timeoutMs": 300000
        },
        {
          "cmd": ["cmake", "--build", "{out}/build", "--parallel", "2"],
          "timeoutMs": 7200000
        },
        {
          "cmd": ["cmake", "--install", "{out}/build"],
          "env": {
            "DESTDIR": "{out}/stage"
          },
          "timeoutMs": 300000
        }
      ],
      "artifacts": ["stage/usr/bin/apt", "stage/usr/bin/apt-get", "stage/usr/bin/apt-cache"],
      "unqualified": [
