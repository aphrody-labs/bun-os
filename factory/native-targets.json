    {
      "id": "apt-windows-msvc",
      "sourceId": "apt",
      "revision": "745fc126218c7cb3df48b22bbc7c7098fa2f7966",
      "host": "win32",
      "architecture": "x64",
      "abi": "msvc-ucrt",
      "license": "GPL-2.0-or-later",
