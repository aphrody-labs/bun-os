      "host": "win32",
      "architecture": "x64",
      "abi": "msvc-ucrt",
      "license": "MIT",
      "ownerFiles": ["CMakeLists.txt", ".vsconfig", "cmake/FindLINUXBUILD.cmake", "doc/docs/dev-loop.md"],
      "tools": ["git", "cmake", "dotnet"],
      "pkgConfig": [],
      "requirements": [
        "Visual Studio 2022 v143 workloads declared by .vsconfig",
        "Windows SDK 10.0.26100.0",
        "Developer Mode or equivalent permission to create build links",
        "Pinned NuGet packages, LinuxSDK and native Clang guest-helper cross compiler"
      ],
      "steps": [
        {
          "cmd": [
            "cmake",
            "-S",
            "{source}",
            "-B",
            "{out}/build",
            "-G",
            "Visual Studio 17 2022",
            "-A",
            "x64",
            "-DCMAKE_SYSTEM_VERSION=10.0.26100.0",
            "-DCMAKE_BUILD_TYPE=Release"
          ],
          "timeoutMs": 1800000
        },
        {
          "cmd": ["cmake", "--build", "{out}/build", "--config", "Release", "--parallel", "2"],
          "timeoutMs": 14400000
        }
      ],
      "artifacts": ["build/bin/x64/Release/wsl.exe"],
      "unqualified": [
        "Installer/package signing",
        "Windows service and WSL1/WSL2 execution",
        "No deployment, WSL startup or registration is performed by this recipe"
      ]
    },
    {
      "id": "wslg-system",
      "sourceId": "wslg",
      "revision": "6942bb534b537302a7a22617261d9274db3cfa37",
      "host": "linux",
      "architecture": "x64",
      "abi": "gnu-glibc",
      "license": "MIT",
      "ownerFiles": ["Dockerfile", "CONTRIBUTING.md", "build-and-export.sh"],
      "tools": ["git", "docker", "go"],
      "pkgConfig": [],
      "externalSources": [
        {
          "path": "vendor/FreeRDP",
          "repository": "https://github.com/microsoft/FreeRDP-mirror",
          "buildArg": "FREERDP_COMMIT"
        },
        {
          "path": "vendor/weston",
          "repository": "https://github.com/microsoft/weston-mirror",
          "buildArg": "WESTON_COMMIT"
        },
        {
          "path": "vendor/pulseaudio",
          "repository": "https://github.com/microsoft/PulseAudio-mirror",
          "buildArg": "PULSEAUDIO_COMMIT"
        },
        {
          "path": "vendor/mesa",
          "repository": "https://gitlab.freedesktop.org/mesa/mesa",
          "buildArg": "MESA_VERSION"
        },
        {
          "path": "vendor/DirectX-Headers-1.0",
          "repository": "https://github.com/microsoft/DirectX-Headers",
          "buildArg": "DIRECTX_HEADERS_VERSION"
        }
      ],
      "requirements": [
        "Five separately pinned vendor Git sources; this WSLg source has no gitlinks",
        "An immutable Azure Linux base image digest and explicit WSLg version",
        "A live Linux Docker daemon on the selected factory",
        "Network access to the pinned hcsshim tar2ext4 v0.13.0 module"
      ],
      "steps": [
        {
          "cmd": [
            "docker",
            "build",
            "--file",
            "{source}/Dockerfile",
            "--tag",
            "{image}",
            "--build-arg",
            "MARINER_IMAGE={baseImage}",
            "--build-arg",
            "WSLG_ARCH=x86_64",
            "--build-arg",
            "WSLG_VERSION={version}",
            "--build-arg",
            "WSLG_COMMIT={revision}",
            "--build-arg",
            "DIRECTX_HEADERS_VERSION={DIRECTX_HEADERS_VERSION}",
            "--build-arg",
            "FREERDP_COMMIT={FREERDP_COMMIT}",
            "--build-arg",
            "MESA_VERSION={MESA_VERSION}",
            "--build-arg",
            "PULSEAUDIO_COMMIT={PULSEAUDIO_COMMIT}",
            "--build-arg",
            "WESTON_COMMIT={WESTON_COMMIT}",
            "{source}"
          ],
          "timeoutMs": 14400000
        },
        {
          "cmd": ["docker", "create", "--name", "{container}", "{image}"],
          "timeoutMs": 60000
        },
        {
          "cmd": ["docker", "export", "--output", "{out}/system_x64.tar", "{container}"],
          "timeoutMs": 1800000
        },
        {
          "cmd": [
            "go",
            "run",
            "github.com/Microsoft/hcsshim/cmd/tar2ext4@v0.13.0",
            "-vhd",
            "-i",
            "{out}/system_x64.tar",
            "-o",
            "{out}/system_x64.vhd"
          ],
          "timeoutMs": 1800000
        },
        {
          "cmd": ["docker", "rm", "{container}"],
          "timeoutMs": 60000
        }
      ],
      "artifacts": ["system_x64.tar", "system_x64.vhd"],
      "unqualified": [
        "Windows RDP plugin built by its separate Visual Studio owner",
        "WSL host/system-distro integration and GPU/audio behavior",
        "Azure Linux owner image is not an Ubuntu rootfs"
      ]
    },
