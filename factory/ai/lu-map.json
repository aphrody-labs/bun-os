        "scripts/signpath-stages.mjs",
        "scripts/windows-signing-setup.ps1",
        "scripts/windows-signing-verify.ps1",
        "scripts/signing-config.sh",
        "scripts/macos-release-signing.sh",
        "scripts/mark-old-releases.mjs",
        "scripts/release-dry-run.mjs",
        "scripts/release-rules.mjs",
        "scripts/release-rules.d.mts",
        "scripts/enforce-prerelease.mjs",
        "scripts/site-publish-date.mjs",
        "scripts/check-cloud-sales.mjs",
        "scripts/scorecard"
      ]
    },
    { "from": "index.html", "to": "apps/lu/index.html" },
    { "from": "vite.config.ts", "to": "apps/lu/vite.config.ts" },
    { "from": "vitest.config.ts", "to": "apps/lu/vitest.config.ts" },
    { "from": "eslint.config.js", "to": "apps/lu/eslint.config.js" },
    { "from": "playwright.config.ts", "to": "apps/lu/playwright.config.ts" },
    { "from": "playwright.stack.config.ts", "to": "apps/lu/playwright.stack.config.ts" },
    { "from": "tsconfig.json", "to": "apps/lu/tsconfig.json" },
    { "from": "tsconfig.app.json", "to": "apps/lu/tsconfig.app.json" },
    { "from": "tsconfig.node.json", "to": "apps/lu/tsconfig.node.json" },
    { "from": "tsconfig.e2e.json", "to": "apps/lu/tsconfig.e2e.json" },
    { "from": "LICENSE", "to": "apps/lu/LICENSE" },
    { "from": "LICENSE", "to": "crates/lu-native/LICENSE" },
    { "from": "COMPUTER-CONTROL.md", "to": "docs/ai/COMPUTER-CONTROL.md" },
    { "from": "VOICE.md", "to": "docs/ai/VOICE.md" },
    { "from": "SECURITY.md", "to": "docs/ai/SECURITY.md" },
    { "from": "CONTRIBUTING.md", "to": "docs/ai/CONTRIBUTING.md" },
    { "from": "CODE_OF_CONDUCT.md", "to": "docs/ai/CODE_OF_CONDUCT.md" },
    { "from": "CHANGELOG.md", "to": "docs/ai/CHANGELOG.upstream.md" },
    { "from": "README.md", "to": "docs/ai/README.upstream.md" }
  ],
  "dropped": [
    "docs (marketing site of lu-labs.ai: pricing, cloud, SEO pages)",
    ".github (upstream CI, release, SignPath, Discord announce; replaced by .github/workflows/ai.yml)",
    ".signpath, signing and release scripts",
    "setup.bat, setup.ps1, setup.sh, start.bat, update.bat (replaced by factory/ai/setup.ts)",
    "package-lock.json (Bun lockfile at the repository root)"
  ]
}
