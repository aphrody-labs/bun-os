  "copy": [
    {
      "from": "src",
      "to": "apps/lu/src",
      "skip": [
        "src/lib/__tests__/release-rules.test.ts",
        "src/lib/__tests__/signpath-stages.test.ts",
        "src/lib/__tests__/site-legal-pages.test.ts",
