      ]
    },
    { "from": "dev-server", "to": "apps/lu/dev-server" },
    { "from": "public", "to": "apps/lu/public" },
    { "from": "e2e", "to": "apps/lu/e2e" },
    { "from": "e2e-stack", "to": "apps/lu/e2e-stack" },
    { "from": "logos", "to": "apps/lu/logos" },
    { "from": "mobile-client", "to": "apps/lu/mobile-client" },
