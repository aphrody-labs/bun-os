# SPDX-License-Identifier: GPL-2.0
# Android 17 fragment for linux-bun (and the WSL kernel, factory/wsl/kernel/build-wsl-kernel.sh), merged after
# aphrody-bun.config. Purpose: run Android 17 on the one Bun OS kernel, in a container (Waydroid, LXC) or in a VM
# (Cuttlefish/crosvm, QEMU), and keep the kernel inside AOSP's Android 17 kernel requirements as far as a
# general-purpose host kernel can.
#
# Source of the requirements (fetched 2026-11-03):
#   android.googlesource.com/kernel/configs main @ bd79f38685cf, c/android-6.12/{android-base.config,
#   android-base-conditional.xml} (c = Android 17; last change 05a51b15ae1b, 2025-03-03; minlts 6.12.0). Android 17
#   has no android-recommended.config any more (removed after Android P/Q), and kernel/configs has no android17
#   branch: main is the Android 17 data.
#   android.googlesource.com/kernel/common android17-6.18 arch/x86/configs/gki_defconfig (GKI for Android 17), used
#   for the extras below.
# check-android.ts classifies each AOSP requirement as met, absent (symbol not in mainline), waived (deliberately
# not met on a host kernel; reasons in that file) or missing (a failure); build.sh runs it on every build.
#
# Toolchain requirements CC_IS_CLANG, LD_IS_LLD, AS_IS_LLVM are met by building with LLVM=1 (PKGBUILD,
# build-wsl-kernel.sh), not by config lines.
#
# Not ported, by design (out-of-tree Android common-kernel features; each has a mainline path):
#   ashmem            removed from mainline v5.18      -> memfd (Android 10+, Waydroid sys.use_memfd=true)
#   C binder/binderfs removed from mainline in v7.4     -> Rust binder below (GKI android17-6.18 ships it as =m)
#   FUSE-BPF          not upstream (GKI-only)           -> FUSE_PASSTHROUGH (mainline v6.9), below
#   incremental-fs    not upstream (GKI-only)           -> not needed: adb install works without it (no streaming install)
#   xt_quota2         not upstream                      -> netd BPF accounting (CGROUP_BPF, XT_MATCH_BPF)
#   cpufreq_times, uid_sys_stats, dm-default-key, x86_64 16K page emulation: Android common kernel only, not
#   needed by Android in a container or VM; see docs in factory/kernel/README.md.
# 16 KB pages: x86_64 has only 4 KB base pages in mainline (16K is ARM64_16K_PAGES on arm64). Android 17 apps built
# 16 KB-aligned (Play requirement since 2025-11) run unchanged on 4 KB kernels.

# ---- Binder: the Rust driver (drivers/android/binder, v7.4: the only binder; links rust_binderfs.c) ----
# Feature parity checked in the v7.4-rc1 sources: BINDER_FREEZE, BINDER_GET_FROZEN_INFO, BINDER_GET_EXTENDED_ERROR,
# BINDER_ENABLE_ONEWAY_SPAM_DETECTION, freeze notifications, the binder netlink transaction report, and the binderfs
# features/ directory (oneway_spam_detection, extended_error, freeze_notification, transaction_report).
CONFIG_ANDROID_BINDER_IPC_RUST=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# MODVERSIONS (android-base.config) with Rust needs DWARF-based symbol versions (init/Kconfig: RUST depends on
# !MODVERSIONS || GENDWARFKSYMS).
CONFIG_GENDWARFKSYMS=y

# ---- Memory and IPC that Android 17 userspace uses ----
CONFIG_MEMFD_CREATE=y
CONFIG_ANON_VMA_NAME=y
CONFIG_USERFAULTFD=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_UDMABUF=y
CONFIG_SYNC_FILE=y
CONFIG_ZRAM=m
CONFIG_PSI=y
# ---- cgroup v2 + freezer, BPF ----
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_BPF_LSM=y
CONFIG_DEBUG_INFO_BTF=y
# ---- File systems for Android images ----
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=m
CONFIG_EROFS_FS=y
CONFIG_FUSE_PASSTHROUGH=y
CONFIG_OVERLAY_FS=y
# ---- Waydroid (LXC) networking ----
CONFIG_BRIDGE=m
CONFIG_NF_TABLES=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
# ---- Cuttlefish / crosvm / QEMU: Android 17 as a guest (virtio front ends) ----
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_INPUT=m
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_SND_VIRTIO=m
CONFIG_VIRTIO_FS=m
CONFIG_HW_RANDOM_VIRTIO=m
CONFIG_CRYPTO_DEV_VIRTIO=m
CONFIG_VSOCKETS=m
CONFIG_VIRTIO_VSOCKETS=m
# ---- Cuttlefish / crosvm: the host side (vhost back ends, KVM) ----
CONFIG_KVM=m
CONFIG_VHOST_NET=m
CONFIG_VHOST_VSOCK=m

# ---- AOSP c/android-6.12/android-base-conditional.xml, x86_64 groups (CFI: renamed CFI_CLANG -> CFI) ----
CONFIG_KFENCE=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_VMAP_STACK=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_ACPI=y
# kCFI (renamed from CFI_CLANG in v6.18), with Rust (HAVE_CFI_ICALL_NORMALIZE_INTEGERS_RUSTC=y on x86_64).
CONFIG_CFI=y

# ---- Parents raised from m to y so the AOSP lines below can be y (Kconfig caps a tristate at its parent) ----
CONFIG_BLK_DEV_DM=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_INET_DIAG=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y

# ---- AOSP c/android-6.12/android-base.config, verbatim, minus the absent and waived lines (check-android.ts) ----
# CONFIG_MODULE_FORCE_UNLOAD is not set
# CONFIG_PM_AUTOSLEEP is not set
# CONFIG_RT_GROUP_SCHED is not set
CONFIG_ADVISE_SYSCALLS=y
CONFIG_AIO=y
CONFIG_AUDIT=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLOCK=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_SYSCALL=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
