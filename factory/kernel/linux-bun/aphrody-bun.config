# SPDX-License-Identifier: 0BSD
# Bun OS kernel configuration fragment for linux-bun (merged over Arch's config.x86_64 of
# linux 7.2.11.arch1-1 with scripts/kconfig/merge_config.sh -m, then `make olddefconfig`;
# check-config.sh then fails the build if any line below is not in the final .config).
#
# Every symbol was looked up in the Kconfig files of linux-7.2.11 (the pinned tarball). Two kinds of
# lines: CHANGED (value differs from Arch) and PINNED (already set that way in Arch; repeated so a
# rebase onto a newer Arch config or an olddefconfig dependency change cannot silently drop it).
# Nothing here is needed by upstream Bun itself except the PINNED base ELF/memfd/epoll interfaces:
# Bun 11c367163a4b (canary 2026-10-27) only mentions io_uring in a TODO (src/install/PackageInstall.rs).

# ---- PINNED: Rust (Phase 0 gate, init/Kconfig `config RUST`) ----
# Needs HAVE_RUST, RUST_IS_AVAILABLE (rustc >= 1.85.0, bindgen >= 0.71.1 in 7.2.11:
# scripts/min-tool-version.sh), !MODVERSIONS (or GENDWARFKSYMS), !RANDSTRUCT and, with
# DEBUG_INFO_BTF=y, a pahole that has --lang_exclude. This is the option that lets out-of-tree Rust
# modules (aphrody-labs/linux drivers/misc/bun_accel.rs, not in 7.2.11) be built against
# linux-bun-headers.
CONFIG_RUST=y

# ---- PINNED: running a Bun executable as PID 1 ----
# Bun is a (dynamically or statically linked) ELF; the kernel must load it as /init or /sbin/init.
CONFIG_BINFMT_ELF=y
# initramfs support, and zstd decompression for mkinitcpio's COMPRESSION=zstd image.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
# tmpfs (also selects MEMFD_CREATE; Bun's LinuxMemFdAllocator uses memfd_create) and devtmpfs.
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
# NOTE (drivers/base/Kconfig, DEVTMPFS_MOUNT help): the automount "does not affect initramfs based
# booting"; a Bun /init in an initramfs has to mount /dev, /proc and /sys itself.
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# Event-loop primitives of a JS runtime (all EXPERT-hidden, default y).
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_FUTEX=y
# Local sockets (Bun.serve({ unix }), IPC).
CONFIG_UNIX=y

# ---- PINNED: Phase 3 control plane and Track G (see ROADMAP.md) ----
# sched_ext depends on BPF_SYSCALL && BPF_JIT && DEBUG_INFO_BTF (kernel/Kconfig.preempt).
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y
# io_uring is `default y` (init/Kconfig); pinned for the Track G io_uring-opcode experiment, not
# because Bun uses it today.
CONFIG_IO_URING=y

# ---- CHANGED: module-less appliance / image boot (Phase 0 step 3) ----
# Arch builds these as modules, which an initramfs containing only a Bun /init cannot load without
# kmod. Built in, they are available before any userspace helper runs.
# Overlay root over a read-only lower layer (select FS_STACK, EXPORTFS: both already y).
CONFIG_OVERLAY_FS=y
# Read-only image roots (depend on BLOCK only; compression sub-options are already y in Arch).
CONFIG_SQUASHFS=y
CONFIG_EROFS_FS=y
# virtio-net for the QEMU boot receipt without modules (depends on VIRTIO, already y; selects
# NET_FAILOVER, DIMLIB, PAGE_POOL).
CONFIG_VIRTIO_NET=y

# Deliberately NOT set here: CONFIG_BUN_ACCEL. That symbol exists only in the aphrody-labs/linux fork
# branches; it is absent from drivers/misc/Kconfig of linux-7.2.11 and would be dropped by olddefconfig.
