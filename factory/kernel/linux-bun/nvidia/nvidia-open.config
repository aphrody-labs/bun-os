# SPDX-License-Identifier: 0BSD
# linux-bun (bare metal) fragment for the NVIDIA open kernel modules (aphrody-labs/open-gpu-kernel-modules,
# tag 615.78.08 = commit 1a82fbfda8f3, the same version as Arch extra/nvidia-open and nvidia-utils on 2026-10-29).
# Merge after aphrody-bun.config with scripts/kconfig/merge_config.sh -m, then `make olddefconfig`.
# Symbols looked up in linux v7.3 Kconfig (mm/Kconfig, drivers/gpu/drm/Kconfig, drivers/gpu/drm/clients/Kconfig,
# arch/x86/Kconfig). Not built, not booted. Does NOT apply to WSL (no in-guest NVIDIA module there).

# Out-of-tree modules need module loading and unloading.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# nvidia-drm: KMS helpers and fbdev emulation (drivers/gpu/drm/clients/Kconfig in v7.3).
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
# nvidia-uvm: HMM and device-private pages (mm/Kconfig), page-attribute table for write-combining mappings.
CONFIG_MMU_NOTIFIER=y
CONFIG_ZONE_DEVICE=y
CONFIG_DEVICE_PRIVATE=y
CONFIG_HMM_MIRROR=y
CONFIG_X86_PAT=y

# Two drivers must not claim the same GPU: nouveau and the in-tree Rust nova-core (WIP in v7.3, depends on RUST).
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_NOVA_CORE is not set
