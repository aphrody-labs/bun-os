# Differences from Arch are listed in ../README.md; in short: pkgbase=linux-bun, the aphrody-bun.config
# fragment merged in prepare() and enforced by check-config.sh, no -docs package / htmldocs, no `replaces`,
# the mkinitcpio preset and Limine template installed under /usr/share/linux-bun.

pkgbase=linux-bun
pkgver=7.2.11.arch1
pkgrel=1
pkgdesc='Linux (Bun OS)'
url='https://github.com/archlinux/linux'
