# linux-bun variant "desktop": HZ=1000, full NO_HZ, full preemption, THP always (Arch config values, pinned against drift).
# Generated by `bun factory/distro/cli.ts kernel fragment desktop`; merge after aphrody-bun.config and check with check-config.sh.
# Not built or booted; values follow linux-cachyos 523baf9cc1e3 (_HZ_ticks/_tickrate/_preempt/_hugepage).
# CONFIG_HZ_100 is not set
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000
# CONFIG_HZ_PERIODIC is not set
# CONFIG_NO_HZ_IDLE is not set
CONFIG_NO_HZ_FULL=y
CONFIG_NO_HZ=y
CONFIG_NO_HZ_COMMON=y
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_LAZY is not set
# CONFIG_TRANSPARENT_HUGEPAGE_MADVISE is not set
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
