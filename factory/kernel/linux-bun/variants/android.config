# linux-bun variant "android": binder for Waydroid. Merge after aphrody-bun.config; not built or booted.
# config.x86_64 selects the Rust binder (ANDROID_BINDER_IPC_RUST=y), which has no binderfs in v7.3 and is mutually
# exclusive with the C driver, so this variant switches to the C driver that Waydroid's node allocation needs.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
# CONFIG_ANDROID_BINDER_IPC_RUST is not set
CONFIG_PSI=y
CONFIG_MEMFD_CREATE=y
CONFIG_VETH=y
CONFIG_NF_NAT=y
