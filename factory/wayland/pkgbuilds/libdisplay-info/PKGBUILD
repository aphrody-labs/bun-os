# STUB, UNVERIFIED (never built): libdisplay-info 0.4.0 pinned to the exact commit of factory/wayland/closure.json.
# Replaces Arch 0.3.0 for the opt-in Hyprland composition; same package name, so the local repository must precede core/extra.
pkgname=libdisplay-info
pkgver=0.4.0
pkgrel=1
_commit=c67a3e9bedb05ab61c7443704a1a107e76254595
pkgdesc='libdisplay-info pinned by the Bun OS Wayland closure'
arch=(x86_64)
url='https://gitlab.freedesktop.org/emersion/libdisplay-info'
license=(custom)
depends=('glibc')
makedepends=('hwdata' 'meson' 'ninja' 'python' 'git')
source=("$pkgname::git+https://gitlab.freedesktop.org/emersion/libdisplay-info.git#commit=$_commit")
sha256sums=('SKIP')

build() {
  _src="$srcdir/$pkgname"
  arch-meson build "$_src"
  meson compile -C build
}

package() {
  _src="$srcdir/$pkgname"
  meson install -C build --destdir "$pkgdir"
}
