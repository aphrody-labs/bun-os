sha256sums=('SKIP')

build() {
  _src="$srcdir/$pkgname"
  arch-meson build "$_src"
  meson compile -C build
}

package() {
  _src="$srcdir/$pkgname"
  meson install -C build --destdir "$pkgdir"
}
