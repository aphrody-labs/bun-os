pkgname=directx-headers
pkgver=1.721.2
pkgrel=1
_commit=6064ae312901a77e8700e84a2341470d050fcbca
pkgdesc='directx-headers pinned by the Bun OS Wayland closure'
arch=(x86_64)
url='https://github.com/microsoft/DirectX-Headers'
license=(custom)
depends=()
