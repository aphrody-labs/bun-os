sha256sums=('SKIP')

build() {
  _src="$srcdir/$pkgname"
  cd "$_src" && cargo build --release --locked
}

package() {
  _src="$srcdir/$pkgname"
  install -Dm755 "$_src/target/release/hyprland-preview-share-picker" "$pkgdir/usr/bin/hyprland-preview-share-picker"
}
