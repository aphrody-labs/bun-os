[Desktop Entry]
Type=Application
Name=Gemini
Comment=Google Gemini as an installed web app (Helium app window)
Exec=bunos-launch-webapp https://gemini.google.com/ com.aphrody.webapp.Gemini
Icon=com.aphrody.webapp.Gemini
Categories=Network;Utility;
StartupWMClass=com.aphrody.webapp.Gemini
X-Bunos-AppKind=web
X-Bunos-IconDomain=gemini.google.com
