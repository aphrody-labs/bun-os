#!/bin/sh
# SPDX-License-Identifier: MIT
# Waydroid user session inside COSMIC (autostart). Inherits WAYLAND_DISPLAY from cosmic-session, so Android
# windows are COSMIC toplevels. Waydroid's user manager writes ~/.local/share/applications/waydroid.*.desktop
# for every Android app, which the COSMIC launcher and app library list next to the Linux and web apps.
set -u
i=0
until waydroid status 2>/dev/null | grep -q '^Container:'; do
  i=$((i + 1)); [ $i -gt 90 ] && exit 0; sleep 2
done
# Android 17 needs minigbm gralloc on the render node before the first boot (waydroid-android17).
/usr/libexec/bunos/waydroid-android17 prepare
exec waydroid session start
