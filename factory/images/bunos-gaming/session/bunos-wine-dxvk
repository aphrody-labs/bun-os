#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Install the Bun OS DXVK and vkd3d-proton DLLs (packages bunos-dxvk, bunos-vkd3d-proton) into a Wine prefix and set
# the native,builtin DLL overrides, as their upstream setup scripts do.
#   bunos-wine-dxvk [WINEPREFIX]
set -eu
prefix=${1:-${WINEPREFIX:-$HOME/.wine}}
export WINEPREFIX="$prefix"
copy() { # copy <src-dir> <dst-dir> dll...
  src=$1 dst=$2; shift 2
  for dll in "$@"; do [ -f "$src/$dll.dll" ] && install -m644 "$src/$dll.dll" "$dst/$dll.dll"; done
}
override() {
  for dll in "$@"; do wine reg add 'HKCU\Software\Wine\DllOverrides' /v "$dll" /d native,builtin /f >/dev/null 2>&1; done
}
sys64="$prefix/drive_c/windows/system32" sys32="$prefix/drive_c/windows/syswow64"
dxvk="d3d8 d3d9 d3d10core d3d11 dxgi"
vkd3d="d3d12 d3d12core"
# shellcheck disable=SC2086
{
  copy /usr/share/dxvk/x64 "$sys64" $dxvk
  copy /usr/share/dxvk/x32 "$sys32" $dxvk
  copy /usr/share/vkd3d-proton/x64 "$sys64" $vkd3d
  copy /usr/share/vkd3d-proton/x86 "$sys32" $vkd3d
  override $dxvk $vkd3d
}
