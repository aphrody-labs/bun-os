# syntax=docker/dockerfile:1.7
# SPDX-License-Identifier: MIT
# bunos-gaming: Arch + CachyOS repositories + the selected Bun OS gaming composition.
# pacman.conf and usr.packages are generated by `bun factory image build bunos-gaming` from factory/usr.
# Targets: gaming (container, host kernel), emulation (gaming + every emulator binary and Bun Engine),
# bootable (blocked until an explicit kernel source and qualified artifact receipt are selected).
ARG ARCH_BOOTSTRAP_IMAGE
FROM ${ARCH_BOOTSTRAP_IMAGE} AS gaming
ARG PACMAN_KEYS
COPY pacman.conf /etc/pacman.conf
# Runtime image: skip docs, man pages and non-English translations (licenses stay).
RUN sed -i '/^\[options\]/a NoExtract = usr/share/doc/* usr/share/man/* usr/share/info/* usr/share/gtk-doc/* usr/share/help/*\nNoExtract = usr/share/locale/* !usr/share/locale/locale.alias !usr/share/locale/en*' /etc/pacman.conf \
  && grep -q '^NoExtract = usr/share/doc' /etc/pacman.conf
COPY usr.packages gaming.packages emulation.packages /usr/share/bun-os/
# Local [bunos] repository (bun-canary, bunos-filesystem, aphrody, ...) built by `bun factory usr build --composition gaming --no-boot`.
COPY bunos-repo/ /var/lib/bun-os/repo/
RUN set -e; repo-add -q /var/lib/bun-os/repo/bunos.db.tar.zst /var/lib/bun-os/repo/*.pkg.tar.zst \
  && pacman-key --init && pacman-key --populate archlinux \
  && for spec in ${PACMAN_KEYS}; do key=${spec%@*}; server=${spec#*@}; \
       pacman-key --keyserver "hkps://$server" --recv-keys "$key" && pacman-key --lsign-key "$key"; done \
  && pacman -Syu --noconfirm --needed cachyos-keyring cachyos-mirrorlist \
  && bunos-install-packages /usr/share/bun-os/usr.packages /usr/share/bun-os/gaming.packages \
  && rm -rf /var/cache/pacman/pkg/*
# Agent tooling (factory/images/manifest.json agentTooling): skills and MCP config in /etc/skel/.claude and .codex.
COPY agent/ /usr/share/bun-os/agent/
RUN bash /usr/share/bun-os/agent/install.sh && rm -rf /var/cache/pacman/pkg/*
ENV XDG_SESSION_TYPE=wayland
CMD ["/bin/bash"]

FROM gaming AS emulation
# Every requested emulator must come from configured pacman repositories or the staged Bun OS repo.
RUN bunos-install-packages /usr/share/bun-os/emulation.packages && rm -rf /var/cache/pacman/pkg/*

FROM gaming AS bootable
# Direct Containerfile builds are gated too; select and qualify a kernel composition before enabling this target.
RUN echo "Bun OS bootable image is blocked until a kernel source and artifact receipt are selected and qualified" >&2; exit 1

FROM ${ARCH_BOOTSTRAP_IMAGE} AS session
# Headless Gamescope Gaming session for the WebOS session manager (factory/images/bunos-gaming/session): one full-screen
# client under gamescope (launcher, wine, proton or app), frames on gamescope's PipeWire node, audio on the session
# PipeWire graph, gamepads from host uinput devices through /dev/input. Standalone: Arch core/extra/multilib plus the
# signed Bun OS repository `aphrody` (https://aphrody.com/repo/os), where the forked emulators, gamescope, RetroArch,
# DXVK/vkd3d-proton, Proton and umu-launcher are published; it does not wait for the /usr composition lock.
# Build: docker buildx build --target session -t bunos-gaming:session factory/images/bunos-gaming
# Run with --device /dev/udmabuf (lavapipe buffer export), -v <runtime dir>:/run/user/1000 and
# --device-cgroup-rule 'c 13:* rmw' -v /dev/input:/dev/input (host uinput pads).
COPY session/pacman.conf /etc/pacman.conf
COPY session.packages session-emulators.packages /usr/share/bun-os/
COPY session/bunos-gaming-session session/bunos-wine-dxvk /usr/bin/
COPY session/retroarch-vulkan.cfg /usr/share/bun-os/
ADD https://aphrody.com/repo/os/aphrody.gpg /tmp/aphrody.gpg
RUN set -e; pacman-key --init && pacman-key --populate archlinux \
  && pacman-key --add /tmp/aphrody.gpg && pacman-key --lsign-key "$(gpg --with-colons --show-keys /tmp/aphrody.gpg | awk -F: '/^fpr/{print $10; exit}')" \
  && pacman -Syu --noconfirm \
  && pacman -S --noconfirm --needed $(grep -hv '^#' /usr/share/bun-os/session.packages /usr/share/bun-os/session-emulators.packages) \
  && rm -rf /var/cache/pacman/pkg/* \
  && chmod 755 /usr/bin/bunos-gaming-session /usr/bin/bunos-wine-dxvk \
  && useradd -m -u 1000 -G input player
USER player
ENV XDG_RUNTIME_DIR=/run/user/1000
ENTRYPOINT ["/usr/bin/bunos-gaming-session"]
