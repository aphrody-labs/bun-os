# syntax=docker/dockerfile:1.7
# SPDX-License-Identifier: MIT
# bunos-gaming: Arch + CachyOS repositories + the selected Bun OS gaming composition.
# pacman.conf and usr.packages are generated by `bun factory image build bunos-gaming` from factory/usr.
# Targets: gaming (container, host kernel), emulation (gaming + every emulator binary and Bun Engine),
# bootable (blocked until an explicit kernel source and qualified artifact receipt are selected).
FROM archlinux:base-devel AS gaming
ARG PACMAN_KEYS
COPY pacman.conf /etc/pacman.conf
# Runtime image: skip docs, man pages and non-English translations (licenses stay).
RUN sed -i '/^\[options\]/a NoExtract = usr/share/doc/* usr/share/man/* usr/share/info/* usr/share/gtk-doc/* usr/share/help/*\nNoExtract = usr/share/locale/* !usr/share/locale/locale.alias !usr/share/locale/en*' /etc/pacman.conf \
  && grep -q '^NoExtract = usr/share/doc' /etc/pacman.conf
COPY install-packages.sh /usr/local/sbin/bunos-install-packages
COPY usr.packages gaming.packages emulation.packages /usr/share/bun-os/
# Local [bunos] repository (bun-canary, bunos-filesystem, aphrody, ...) built by `bun factory usr build --composition gaming --no-boot`.
COPY bunos-repo/ /var/lib/bun-os/repo/
RUN set -e; repo-add -q /var/lib/bun-os/repo/bunos.db.tar.zst /var/lib/bun-os/repo/*.pkg.tar.zst \
  && pacman-key --init && pacman-key --populate archlinux \
  && for spec in ${PACMAN_KEYS}; do key=${spec%@*}; server=${spec#*@}; \
       pacman-key --keyserver "hkps://$server" --recv-keys "$key" && pacman-key --lsign-key "$key"; done \
  && pacman -Syu --noconfirm --needed git cachyos-keyring cachyos-mirrorlist \
  && useradd -m -r builder && echo 'builder ALL=(ALL) NOPASSWD: /usr/bin/pacman' >/etc/sudoers.d/builder \
  && bunos-install-packages /usr/share/bun-os/usr.packages /usr/share/bun-os/gaming.packages \
  && rm -rf /var/cache/pacman/pkg/* /home/builder/.cache
# Agent tooling (factory/images/manifest.json agentTooling): skills and MCP config in /etc/skel/.claude and .codex.
COPY agent/ /usr/share/bun-os/agent/
RUN bash /usr/share/bun-os/agent/install.sh && rm -rf /var/cache/pacman/pkg/*
ENV XDG_SESSION_TYPE=wayland
CMD ["/bin/bash"]

FROM gaming AS emulation
# Missing repository packages are built from the AUR; gaps land in /usr/share/bun-os/missing-packages.txt.
RUN bunos-install-packages /usr/share/bun-os/emulation.packages && rm -rf /var/cache/pacman/pkg/* /home/builder/.cache

FROM gaming AS bootable
# Direct Containerfile builds are gated too; select and qualify a kernel composition before enabling this target.
RUN echo "Bun OS bootable image is blocked until a kernel source and artifact receipt are selected and qualified" >&2; exit 1
