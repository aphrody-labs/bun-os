# GRUB 2 (i386-pc) in the MBR gap; btrfs read natively by GRUB. @ROOTFLAGS@ and @CMDLINE@ are substituted.
set timeout=3
set default=0
insmod part_msdos
insmod btrfs
insmod all_video
serial --unit=0 --speed=115200
terminal_input serial console
terminal_output serial console
search --no-floppy --label bunos-root --set=root

menuentry 'Bun OS (linux-bun 7.3)' {
    linux /boot/vmlinuz-linux-bun @CMDLINE@
    initrd /boot/initramfs-linux-bun.img
}
menuentry 'ReactOS (FreeLoader, multiboot)' {
    # freeldr.sys carries a Multiboot v1 header (boot/freeldr/freeldr/arch/i386/multiboot.S); i386 BIOS only.
    multiboot /freeldr.sys
    boot
}
menuentry 'ReactOS (btrfs boot sector chainload)' {
    # sector 0..2 of the partition hold boot/freeldr/bootsect/btrfs.S patched with the partition start LBA.
    chainloader +1
}
