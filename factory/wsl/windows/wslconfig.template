# Bun OS for Windows: %USERPROFILE%\.wslconfig (keys from Learn "wsl-config", .wslconfig section).
# install.ts merges these keys into an existing file (a backup is kept as .wslconfig.bunos-backup) and fills
# {{KERNEL}} / {{MODULES}} with the installed paths, backslashes escaped as .wslconfig requires, and
# {{PROCESSORS}} / {{MEMORY}} / {{SWAP}} from this machine (all logical CPUs, half the RAM, a quarter of it as swap).
# Applies to every WSL 2 distro of the user after `wsl --shutdown`.

[wsl2]
# Bun OS WSL2 kernel (Linux 7.3.1 + the Microsoft WSL series ported to 7.3, Rust on, dxgkrnl for /dev/dxg).
kernel={{KERNEL}}
# Modules VHD built from the same kernel (vermagic match; CONFIG_MODVERSIONS is off for Rust).
kernelModules={{MODULES}}
# Sizing for latency: every logical CPU (idle vCPUs cost the host nothing; Hyper-V schedules them like threads),
# half the RAM (Learn default; autoMemoryReclaim below hands cache back to Windows).
processors={{PROCESSORS}}
memory={{MEMORY}}
swap={{SWAP}}
# WSLg: Wayland, X11 and PulseAudio through the WSLg system distro; windows appear as Win32 windows.
guiApplications=true
# No separation from Windows: share the host network stack (localhost both ways, same IPs).
networkingMode=mirrored
dnsTunneling=true
autoProxy=true
nestedVirtualization=true

[general]
# Keep the distro (and with it the VM, Docker and Waydroid) running: no 3-4 s cold boot on the next wsl.exe.
instanceIdleTimeout=-1

[experimental]
# gradual: cache is returned slowly, so file-cache hits survive idle periods (dropCache empties it at once).
autoMemoryReclaim=gradual
sparseVhd=true
hostAddressLoopback=true
# Mirrored mode refuses Linux binds on ports Windows already uses; Waydroid's dnsmasq serves DNS + DHCP (53, 67)
# on its own bridge (waydroid0), which Windows ICS/Hyper-V DHCP also hold on the host.
ignoredPorts=53,67
