# SPDX-License-Identifier: GPL-2.0
# Docker Engine and Waydroid networking for the WSL kernel, merged after wsl-android.config.
# Microsoft's config-wsl (a989171) already has OVERLAY_FS, NF_TABLES, NFT_NAT, NFT_MASQ, VETH, VXLAN, cgroup v2
# (MEMCG, BLK_CGROUP, CGROUP_PIDS, CPUSETS, CGROUP_BPF, CFS_BANDWIDTH), SECCOMP_FILTER, USER_NS and POSIX_MQUEUE
# built in. dockerd and Waydroid's LXC bridge still modprobe the rest at start; building them in removes that
# modprobe round trip from every daemon and container start and does not depend on the modules VHD being mounted.
CONFIG_BRIDGE=y
# Arch's iptables is iptables-nft: rules go through nf_tables + xt matches (NFT_COMPAT). The legacy tables
# (IP_NF_FILTER, IP_NF_NAT: they depend on IP_NF_IPTABLES_LEGACY in 7.3) stay modules for iptables-legacy.
CONFIG_BRIDGE_NETFILTER=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_CT=y
CONFIG_TUN=y
# dma-buf from memfd (/dev/udmabuf) and the system heap: software-rendered Android gralloc and lavapipe
# share buffers with the compositor without a copy.
CONFIG_UDMABUF=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
