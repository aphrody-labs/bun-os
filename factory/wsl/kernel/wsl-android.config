# SPDX-License-Identifier: GPL-2.0
# Android container support (Waydroid) for the WSL kernel, merged after wsl-rust.config. Nothing here has been built.
# Checked on 2026-10-29: Microsoft's config-wsl (a989171) has PSI, MEMFD_CREATE, VETH, BRIDGE=m, NF_TABLES, NF_NAT,
# NFT_MASQ, SECCOMP, USER_NS, SYNC_FILE, OVERLAY_FS, SQUASHFS and TUN=m already; it lacks only the binder driver.
# Linux v7.3 drivers/android/Kconfig: ANDROID_BINDER_IPC is a bool (no module), ANDROID_BINDERFS depends on it, and
# ANDROID_BINDER_IPC_RUST depends on !ANDROID_BINDER_IPC. Waydroid allocates its nodes through binderfs, so the C
# driver is the one to enable. ashmem was removed from mainline; Waydroid falls back to memfd (sys.use_memfd=true).
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
# CONFIG_ANDROID_BINDER_IPC_RUST is not set
