# SPDX-License-Identifier: GPL-2.0
# Android container support (Waydroid) for the WSL kernel, merged after wsl-rust.config (build-wsl-kernel.sh merges rust, android, docker, desktop, latency in that order).
# Checked on 2026-10-29: Microsoft's config-wsl (a989171) has PSI, MEMFD_CREATE, VETH, BRIDGE=m, NF_TABLES, NF_NAT,
# NFT_MASQ, SECCOMP, USER_NS, SYNC_FILE, OVERLAY_FS, SQUASHFS and TUN=m already; it lacks only the binder driver.
# Linux v7.4-rc1 drivers/android/Kconfig (checked 2026-11-03): the C binder driver (ANDROID_BINDER_IPC, ANDROID_BINDERFS)
# is gone; ANDROID_BINDER_IPC_RUST (bool, depends on MMU, NET, RUST) is the only binder, and its object always links
# rust_binderfs.c, so binderfs comes with it. Waydroid allocates its nodes through binderfs. ashmem was removed from
# mainline; Waydroid falls back to memfd (sys.use_memfd=true).
CONFIG_ANDROID_BINDER_IPC_RUST=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
