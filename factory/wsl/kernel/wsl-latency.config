# SPDX-License-Identifier: GPL-2.0
# Latency tuning for a Hyper-V guest, merged last. Compared on 2026-11-03 with Microsoft's config-wsl (a989171,
# 6.18.58) and Azure Linux 3.0 SPECS/kernel/config (6.6.159.1) and SPECS/kernel-hwe/config (6.18.57.1).
# Kept from config-wsl: PREEMPT_DYNAMIC, NO_HZ_IDLE, HYPERV_TIMER, PARAVIRT_SPINLOCKS, THP madvise.
# Not taken: NO_HZ_FULL (tick offload costs syscall entry time on every CPU), cpufreq governors (a Hyper-V guest has
# no cpufreq driver; the host schedules the vCPUs), PREEMPT_RT (throughput loss, no hard real-time need).
# EEVDF is the only fair scheduler in 7.3 and needs no option.

# Full preemption by default. config-wsl and both Azure Linux configs pick PREEMPT_NONE (server); in 7.3 that
# choice needs ARCH_NO_PREEMPT, so x86 falls back to PREEMPT anyway. Pinned here; preempt=lazy at boot still works.
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
# 1000 Hz tick as in Azure Linux HWE 6.18 (config-wsl and Azure Linux 6.6 use 250): 1 ms timer and scheduler
# granularity for interactive WSLg, audio and Android input.
CONFIG_HZ_1000=y
CONFIG_HZ=1000
# Multi-gen LRU on by default (Azure Linux 6.6 and HWE): faster reclaim under autoMemoryReclaim and fewer stalls.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# Compressed swap cache in RAM before the swap VHD (Azure Linux HWE has ZSWAP=y).
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_SHRINKER_DEFAULT_ON=y
# BPF schedulers (scx_lavd, scx_bpfland) as in Azure Linux HWE; BTF is already on in config-wsl.
CONFIG_SCHED_CLASS_EXT=y
# BBR + fq pacing by default (both are modules defaulting to cubic/pfifo_fast in config-wsl and Azure Linux).
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
