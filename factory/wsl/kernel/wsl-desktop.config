# SPDX-License-Identifier: GPL-2.0
# Desktop sessions under WSLg (docs/DESKTOP-SESSIONS.md), merged after wsl-docker.config.
# Hyprland/Omarchy run on Aquamarine's DRM backend with no seat (LIBSEAT_BACKEND=noop). WSL has no KMS device: vgem is
# render-only ("not a KMS device", then "no allocator available", measured 2026-11-03). vkms is the kernel's virtual
# KMS driver: one virtual connector, dumb buffers, software rendering through Mesa's kms_swrast; wayvnc then exports it.
CONFIG_DRM_VKMS=y
