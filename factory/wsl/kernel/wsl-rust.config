# SPDX-License-Identifier: GPL-2.0
# Fragment merged over Microsoft's config-wsl (6.18.52.3 base) after `make olddefconfig` on linux v7.3,
# with scripts/kconfig/merge_config.sh -m, then `make olddefconfig` again. Build with LLVM=1.
# Symbols checked against the v7.3 Kconfig files (init/Kconfig, lib/Kconfig.debug, samples/rust/Kconfig,
# drivers/gpu/nova-core/Kconfig) on 2026-10-29. Nothing here has been built yet.

# Rust support. Needs rustc >= 1.85.0, bindgen >= 0.71.1, libclang >= 17.0.1 (scripts/min-tool-versions.sh).
# HAVE_RUST is selected on X86_64; RUST also needs !MODVERSIONS (or GENDWARFKSYMS) and !RANDSTRUCT.
CONFIG_RUST=y
# Microsoft's config-wsl sets CONFIG_MODVERSIONS=y (line verified at a989171), which excludes RUST unless
# GENDWARFKSYMS is used (it is not set). The port turns MODVERSIONS off. Consequence: modules are matched by
# vermagic only; modules.vhdx must be built from this exact kernel.
# CONFIG_MODVERSIONS is not set

# Rust hygiene: release-like. Debug assertions and overflow checks cost size and speed.
# CONFIG_RUST_DEBUG_ASSERTIONS is not set
# CONFIG_RUST_OVERFLOW_CHECKS is not set
# CONFIG_RUST_BUILD_ASSERT_ALLOW is not set
# CONFIG_RUST_KERNEL_DOCTESTS is not set
# CONFIG_RUST_INLINE_HELPERS is not set

# Rust samples off (samples/rust/Kconfig, all default n; pinned so an olddefconfig change cannot enable them).
# CONFIG_SAMPLES_RUST is not set

# NVIDIA: WSL has no in-guest NVIDIA kernel module. The Windows host driver is reached through dxgkrnl
# (/dev/dxg) and the user-space libraries WSL mounts at /usr/lib/wsl/lib.
CONFIG_DXGKRNL=y
# The in-tree Rust NVIDIA driver (GSP, Turing+) is "work in progress and may not be functional" in v7.3
# and has no function under WSL: keep it, nouveau and any NVIDIA module out.
# CONFIG_NOVA_CORE is not set
# CONFIG_DRM_NOUVEAU is not set

# Keep the WSL identity.
CONFIG_LOCALVERSION="-microsoft-standard-WSL2"
# CONFIG_LOCALVERSION_AUTO is not set
