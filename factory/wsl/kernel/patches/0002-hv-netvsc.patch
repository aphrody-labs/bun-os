+	while (!wait_for_completion_timeout(&request->wait_event, HZ)) {
+		if (netvsc_channel_rescinded(dev->ndev)) {
+			netdev_err(dev->ndev,
+				   "RNDIS request 0x%x aborted, channel rescinded\n",
+				   request->request_msg.ndis_msg_type);
+			return -ENODEV;
+		}
+	}
+
+	return 0;
+}
