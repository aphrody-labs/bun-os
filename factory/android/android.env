# Shared Android toolchain environment (factory/android/sdk.ts). Source it on the VPS and in build
# containers: `set -a; . factory/android/android.env; set +a`. Used by apps/bun-android, apps/java-ffi,
# crates/android-native and packages/bun-android (which also falls back to /opt/android-sdk).
ANDROID_HOME=/opt/android-sdk
ANDROID_SDK_ROOT=/opt/android-sdk
ANDROID_NDK_HOME=/opt/android-sdk/ndk/30.0.16248370
ANDROID_NDK_ROOT=/opt/android-sdk/ndk/30.0.16248370
ANDROID_NDK_SIDE_BY_SIDE=/opt/android-sdk/ndk/29.0.14206865
ANDROID_PLATFORM=37
ANDROID_AVD_HOME=/opt/android-avd
JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
GRADLE_HOME=/opt/android-tools/gradle
GRADLE_USER_HOME=/home/ubuntu/.cache/bunos-android/gradle
KOTLIN_HOME=/opt/android-tools/kotlinc
PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/emulator:/opt/android-tools/gradle/bin:/opt/android-tools/kotlinc/bin:/home/ubuntu/.cargo/bin:/usr/local/bin:/usr/bin:/bin
