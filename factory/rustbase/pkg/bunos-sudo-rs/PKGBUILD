# Generated by factory/rustbase/gen.ts from pins.json (version) and forks.json (aphrody-labs fork commit).
pkgname=bunos-sudo-rs
pkgver=0.2.15
pkgrel=2
pkgdesc="sudo-rs (memory-safe sudo and su) as /usr/bin/sudo with Arch PAM service files"
arch=(x86_64 aarch64)
url="https://github.com/aphrody-labs/sudo-rs"
license=(Apache-2.0 MIT)
depends=(glibc gcc-libs pam)
makedepends=(cargo git)
provides=(sudo=1.9.17.p2 sudo-rs=0.2.15)
conflicts=(sudo sudo-rs)
backup=(etc/sudoers etc/pam.d/sudo etc/pam.d/sudo-i)
options=(!lto !debug)
source=(
  "sudo-rs::git+https://github.com/aphrody-labs/sudo-rs.git#commit=baa7fcea2181f4b26a636bb29e2589a76682f8f4"
  sudoers
  pam-sudo
)
sha256sums=(SKIP SKIP SKIP)

prepare() { cd "$srcdir/sudo-rs" && cargo fetch --locked; }

build() {
  cd "$srcdir/sudo-rs"
  # no pam-login feature: Arch's sudo uses the "sudo" PAM service for sudo -i as well
  cargo build --release --locked --target-dir "$srcdir/target"
}

package() {
  # setuid root is mandatory for sudo and su
  install -Dm4755 "$srcdir/target/release/sudo" "$pkgdir/usr/bin/sudo"
  install -Dm4755 "$srcdir/target/release/su" "$pkgdir/usr/bin/su-rs"
  install -Dm755 "$srcdir/target/release/visudo" "$pkgdir/usr/bin/visudo"
  install -Dm440 "$srcdir/sudoers" "$pkgdir/etc/sudoers"
  install -dm750 "$pkgdir/etc/sudoers.d"
  install -Dm644 "$srcdir/pam-sudo" "$pkgdir/etc/pam.d/sudo"
  install -Dm644 "$srcdir/pam-sudo" "$pkgdir/etc/pam.d/sudo-i"
  install -Dm644 "$srcdir/sudo-rs/LICENSE-MIT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 "$srcdir/sudo-rs/LICENSE-APACHE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
