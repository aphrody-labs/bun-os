# SPDX-License-Identifier: Apache-2.0
# RPCS3 (PlayStation 3) from the Bun OS fork (vendor/rpcs3, aphrody-labs/rpcs3). PS3 firmware is never shipped.
# cmake installs the desktop entry, icons and AppStream metainfo.
pkgname=rpcs3
pkgver=0.0.43.r9508444
pkgrel=1
_commit=9508444d31338e89a4f4cee1d0cee1800c96d2c1
pkgdesc='PlayStation 3 emulator (Bun OS fork of RPCS3)'
arch=('x86_64')
url='https://github.com/aphrody-labs/rpcs3'
license=('GPL-2.0-only')
depends=('alsa-lib' 'curl' 'ffmpeg' 'glew' 'libevdev' 'libgl' 'libpng' 'libpulse' 'libusb' 'openal' 'qt6-base'
         'qt6-multimedia' 'qt6-svg' 'qt6-wayland' 'sdl3' 'vulkan-icd-loader' 'wayland' 'zlib')
makedepends=('clang' 'cmake' 'git' 'lld' 'llvm' 'ninja' 'python' 'vulkan-headers')
options=('!debug' '!lto')
source=("rpcs3::git+https://github.com/aphrody-labs/rpcs3.git#commit=${_commit}")
sha256sums=('SKIP')

prepare() {
  cd rpcs3
  git submodule update --init --recursive --depth 1
}

build() {
  cmake -S rpcs3 -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ -DUSE_NATIVE_INSTRUCTIONS=OFF -DUSE_SYSTEM_FFMPEG=ON \
    -DUSE_SYSTEM_CURL=ON -DUSE_SYSTEM_LIBPNG=ON -DUSE_SYSTEM_ZLIB=ON -DUSE_DISCORD_RPC=OFF -DBUILD_LLVM=OFF
  cmake --build build -j 4
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 rpcs3/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
