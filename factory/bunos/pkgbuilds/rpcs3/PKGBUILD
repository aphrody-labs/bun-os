  install -Dm644 "$srcdir/rpcs3.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/rpcs3.svg"
  install -Dm644 "$srcdir/rpcs3.metainfo.xml" "$pkgdir/usr/share/metainfo/com.aphrody.bunos.rpcs3.metainfo.xml"
