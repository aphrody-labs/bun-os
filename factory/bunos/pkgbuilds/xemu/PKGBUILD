# SPDX-License-Identifier: Apache-2.0
# xemu (original Xbox) from the Bun OS fork (vendor/xemu, aphrody-labs/xemu). The MCPX boot ROM, BIOS and HDD image
# are never shipped.
pkgname=xemu
pkgver=0.8.139.rdc10b4c
pkgrel=1
_commit=dc10b4cea96e403d30c17ed53551fdaf023bc17f
pkgdesc='Original Xbox emulator (Bun OS fork of xemu)'
arch=('x86_64')
url='https://github.com/aphrody-labs/xemu'
license=('GPL-2.0-or-later')
depends=('glib2' 'gtk3' 'libepoxy' 'libpcap' 'libsamplerate' 'libslirp' 'openssl' 'sdl2' 'vulkan-icd-loader' 'zlib')
makedepends=('cmake' 'git' 'glslang' 'meson' 'ninja' 'python' 'python-yaml' 'vulkan-headers')
options=('!debug' '!lto')
source=("xemu::git+https://github.com/aphrody-labs/xemu.git#commit=${_commit}")
sha256sums=('SKIP')

prepare() {
  cd xemu
  git submodule update --init --recursive --depth 1
}

build() {
  cd xemu
  MAKEFLAGS=-j4 ./build.sh --release
}

package() {
  cd xemu
  install -Dm755 dist/xemu "$pkgdir/usr/bin/xemu"
  install -Dm644 ui/xemu.desktop "$pkgdir/usr/share/applications/xemu.desktop"
  for size in 16 24 32 48 64 128 256 512; do
    [ -f "ui/icons/xemu_${size}x${size}.png" ] && install -Dm644 "ui/icons/xemu_${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/xemu.png"
  done
  [ -f ui/icons/xemu.svg ] && install -Dm644 ui/icons/xemu.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/xemu.svg"
  [ -f ui/xemu.metainfo.xml ] && install -Dm644 ui/xemu.metainfo.xml "$pkgdir/usr/share/metainfo/app.xemu.xemu.metainfo.xml"
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}
