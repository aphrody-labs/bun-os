arch=(x86_64)
url="https://github.com/xemu-project/xemu"
license=('GPL-2.0-or-later')
depends=('glibc' 'hicolor-icon-theme')
options=('!strip' '!debug')
source=("xemu-0.8.139-x86_64.AppImage::https://github.com/xemu-project/xemu/releases/download/v0.8.139/xemu-0.8.139-x86_64.AppImage" "xemu.desktop" "xemu.svg" "xemu.metainfo.xml")
sha256sums=('220282aacf09b30b35c55ba900a774fb6940c70deca1408bc70a4c9cc67c322f' 'SKIP' 'SKIP' 'SKIP')
noextract=("xemu-0.8.139-x86_64.AppImage")

prepare() {
  cd "$srcdir"
  local image
  image=$(find . -maxdepth 2 -iname '*.AppImage' | head -n1)
  chmod +x "$image"
  rm -rf squashfs-root
  "$image" --appimage-extract >/dev/null
}

package() {
  install -d "$pkgdir/opt/xemu" "$pkgdir/usr/bin"
  cp -a "$srcdir/squashfs-root/." "$pkgdir/opt/xemu/"
  chmod -R u+rwX,go+rX "$pkgdir/opt/xemu"
  printf '#!/bin/sh\nexec /opt/xemu/AppRun "$@"\n' > "$pkgdir/usr/bin/xemu"
  chmod 755 "$pkgdir/usr/bin/xemu"
  install -Dm644 "$srcdir/xemu.desktop" "$pkgdir/usr/share/applications/xemu.desktop"
  install -Dm644 "$srcdir/xemu.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/xemu.svg"
  install -Dm644 "$srcdir/xemu.metainfo.xml" "$pkgdir/usr/share/metainfo/com.aphrody.bunos.xemu.metainfo.xml"
  # Upstream license and notice files shipped inside the image.
  install -d "$pkgdir/usr/share/licenses/xemu"
  find "$srcdir/squashfs-root" -maxdepth 4 -type f \( -iname 'LICENSE*' -o -iname 'COPYING*' -o -iname 'NOTICE*' \) -exec cp -n {} "$pkgdir/usr/share/licenses/xemu/" \; || true
  printf '%s\n' "Upstream: https://github.com/xemu-project/xemu/releases/download/v0.8.139/xemu-0.8.139-x86_64.AppImage" "sha256: 220282aacf09b30b35c55ba900a774fb6940c70deca1408bc70a4c9cc67c322f" "License: GPL-2.0-or-later" > "$pkgdir/usr/share/licenses/xemu/SOURCE"
}
