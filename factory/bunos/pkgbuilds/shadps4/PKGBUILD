# SPDX-License-Identifier: Apache-2.0
# shadPS4 (PlayStation 4) from the Bun OS fork (vendor/shadps4, aphrody-labs/shadPS4). PS4 firmware is never shipped.
pkgname=shadps4
pkgver=0.21.0.r860d73b
pkgrel=1
_commit=860d73b7e99559106a3ffa3d3d69f0f9237e115e
pkgdesc='PlayStation 4 emulator (Bun OS fork of shadPS4)'
arch=('x86_64')
url='https://github.com/aphrody-labs/shadPS4'
license=('GPL-2.0-or-later')
depends=('alsa-lib' 'ffmpeg' 'libpulse' 'openal' 'sdl3' 'vulkan-icd-loader' 'wayland' 'zlib')
makedepends=('clang' 'cmake' 'git' 'lld' 'ninja' 'python' 'vulkan-headers')
options=('!debug' '!lto')
source=("shadps4::git+https://github.com/aphrody-labs/shadPS4.git#commit=${_commit}")
sha256sums=('SKIP')

prepare() {
  cd shadps4
  git submodule update --init --recursive --depth 1
}

build() {
  cmake -S shadps4 -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ -DENABLE_DISCORD_RPC=OFF -DENABLE_UPDATER=OFF
  cmake --build build -j 4
}

package() {
  install -Dm755 build/shadps4 "$pkgdir/usr/bin/shadps4"
  cd shadps4
  install -Dm644 dist/net.shadps4.shadPS4.desktop -t "$pkgdir/usr/share/applications/" 2>/dev/null || true
  install -Dm644 dist/net.shadps4.shadPS4.metainfo.xml -t "$pkgdir/usr/share/metainfo/" 2>/dev/null || true
  install -Dm644 src/images/net.shadps4.shadPS4.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/" 2>/dev/null || true
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/" 2>/dev/null || install -Dm644 LICENSES/* -t "$pkgdir/usr/share/licenses/$pkgname/"
}
