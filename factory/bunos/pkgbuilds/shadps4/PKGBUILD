arch=(x86_64)
url="https://github.com/shadps4-emu/shadPS4"
license=('GPL-2.0-or-later')
depends=('glibc' 'hicolor-icon-theme')
options=('!strip' '!debug')
source=("shadps4-linux-sdl-0.21.0.zip::https://github.com/shadps4-emu/shadPS4/releases/download/v.0.21.0/shadps4-linux-sdl-0.21.0.zip" "shadps4.desktop" "shadps4.svg" "shadps4.metainfo.xml")
