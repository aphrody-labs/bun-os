prepare() {
  cd "$srcdir"
  local image
  image=$(find . -maxdepth 2 -iname '*.AppImage' | head -n1)
  chmod +x "$image"
  rm -rf squashfs-root
  "$image" --appimage-extract >/dev/null
}

package() {
  install -d "$pkgdir/opt/shadps4" "$pkgdir/usr/bin"
  cp -a "$srcdir/squashfs-root/." "$pkgdir/opt/shadps4/"
  chmod -R u+rwX,go+rX "$pkgdir/opt/shadps4"
  printf '#!/bin/sh\nexec /opt/shadps4/AppRun "$@"\n' > "$pkgdir/usr/bin/shadps4"
  chmod 755 "$pkgdir/usr/bin/shadps4"
  install -Dm644 "$srcdir/shadps4.desktop" "$pkgdir/usr/share/applications/shadps4.desktop"
  install -Dm644 "$srcdir/shadps4.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/shadps4.svg"
  install -Dm644 "$srcdir/shadps4.metainfo.xml" "$pkgdir/usr/share/metainfo/com.aphrody.bunos.shadps4.metainfo.xml"
  # Upstream license and notice files shipped inside the image.
  install -d "$pkgdir/usr/share/licenses/shadps4"
  find "$srcdir/squashfs-root" -maxdepth 4 -type f \( -iname 'LICENSE*' -o -iname 'COPYING*' -o -iname 'NOTICE*' \) -exec cp -n {} "$pkgdir/usr/share/licenses/shadps4/" \; || true
  printf '%s\n' "Upstream: https://github.com/shadps4-emu/shadPS4/releases/download/v.0.21.0/shadps4-linux-sdl-0.21.0.zip" "sha256: 7c41c58254461d742b5edf564e23795697b63e9e46de11d0e1ed67bd2cbaae68" "License: GPL-2.0-or-later" > "$pkgdir/usr/share/licenses/shadps4/SOURCE"
}
