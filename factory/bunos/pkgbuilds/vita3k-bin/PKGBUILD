arch=(x86_64)
url="https://github.com/Vita3K/Vita3K"
license=('GPL-2.0-or-later')
depends=('glibc' 'hicolor-icon-theme')
options=('!strip' '!debug')
source=("Vita3K-x86_64.AppImage::https://github.com/Vita3K/Vita3K/releases/download/continuous/Vita3K-x86_64.AppImage" "vita3k-bin.desktop" "vita3k-bin.svg" "vita3k-bin.metainfo.xml")
