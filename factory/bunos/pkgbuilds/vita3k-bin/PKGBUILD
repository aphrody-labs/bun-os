noextract=("Vita3K-x86_64.AppImage")

prepare() {
  cd "$srcdir"
  local image
  image=$(find . -maxdepth 2 -iname '*.AppImage' | head -n1)
  chmod +x "$image"
  rm -rf squashfs-root
  "$image" --appimage-extract >/dev/null
}

package() {
  install -d "$pkgdir/opt/vita3k-bin" "$pkgdir/usr/bin"
  cp -a "$srcdir/squashfs-root/." "$pkgdir/opt/vita3k-bin/"
  chmod -R u+rwX,go+rX "$pkgdir/opt/vita3k-bin"
  printf '#!/bin/sh\nexec /opt/vita3k-bin/AppRun "$@"\n' > "$pkgdir/usr/bin/Vita3K"
  chmod 755 "$pkgdir/usr/bin/Vita3K"
  install -Dm644 "$srcdir/vita3k-bin.desktop" "$pkgdir/usr/share/applications/vita3k-bin.desktop"
  install -Dm644 "$srcdir/vita3k-bin.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/vita3k-bin.svg"
  install -Dm644 "$srcdir/vita3k-bin.metainfo.xml" "$pkgdir/usr/share/metainfo/com.aphrody.bunos.vita3k-bin.metainfo.xml"
  # Upstream license and notice files shipped inside the image.
  install -d "$pkgdir/usr/share/licenses/vita3k-bin"
  find "$srcdir/squashfs-root" -maxdepth 4 -type f \( -iname 'LICENSE*' -o -iname 'COPYING*' -o -iname 'NOTICE*' \) -exec cp -n {} "$pkgdir/usr/share/licenses/vita3k-bin/" \; || true
  printf '%s\n' "Upstream: https://github.com/Vita3K/Vita3K/releases/download/continuous/Vita3K-x86_64.AppImage" "sha256: 43fa2b6f9ce086c5f73fb2e99eaa06c3b892aa3f09ae043b2ff017b5d4bf3a33" "License: GPL-2.0-or-later" > "$pkgdir/usr/share/licenses/vita3k-bin/SOURCE"
}
