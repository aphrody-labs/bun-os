# SPDX-License-Identifier: MIT
# virglrenderer from the Bun OS fork (aphrody-labs/virglrenderer, mirror of gitlab.freedesktop.org/virgl/virglrenderer).
# On WSL it is the GPU bridge for Waydroid: Android's Mesa has no d3d12 driver and cannot load Microsoft's glibc
# libd3d12/libdxcore, so Android GLES runs on Mesa virpipe over the vtest socket and virgl_test_server replays it
# on the host's Mesa d3d12 (DirectX 12). bunos-vtest@<user>.service serves the socket inside the Waydroid /data mount.
pkgname=bunos-virglrenderer
pkgver=1.3.0
_commit=ca50e008863837e094747a69974dde3ae148aeaa # virglrenderer-1.3.0
pkgrel=1
pkgdesc='virglrenderer + vtest server for Waydroid GPU over Mesa d3d12 on WSL (Bun OS fork)'
arch=(x86_64)
url='https://github.com/aphrody-labs/virglrenderer'
license=(MIT)
depends=(glibc libdrm libepoxy libglvnd mesa vulkan-icd-loader)
makedepends=(git meson ninja python-yaml vulkan-headers)
provides=("virglrenderer=${pkgver}" libvirglrenderer.so)
conflicts=(virglrenderer)
source=("virglrenderer::git+https://github.com/aphrody-labs/virglrenderer.git#commit=${_commit}"
        bunos-vtest@.service)
sha256sums=('SKIP' 'SKIP')

build() {
  arch-meson virglrenderer build -D venus=true -D video=false -D tests=false
  local _j
  _j=$(sed -n 's/.*-j *\([0-9][0-9]*\).*/\1/p' <<<"${MAKEFLAGS:-}")
  meson compile -C build ${_j:+-j "$_j"}
}

package() {
  meson install -C build --destdir "$pkgdir" --no-rebuild
  install -Dm644 bunos-vtest@.service -t "$pkgdir/usr/lib/systemd/system/"
  install -Dm644 virglrenderer/COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}
