# SPDX-License-Identifier: Apache-2.0
# RetroArch from the Bun OS fork (vendor/retroarch, aphrody-labs/retroarch: libretroarch library mode and the WebGPU
# driver). Recipe follows Arch's extra/retroarch; the upstream Makefile installs the desktop entry, icons and AppStream
# metainfo. It is also the controller-first launcher of the gaming session (Ozone/XMB).
pkgname=bunos-retroarch
pkgver=1.22.2.r5f2f529
pkgrel=2
_commit=5f2f529b476fbaa165241c19518b76d4bbd98b04
pkgdesc='Reference frontend for the libretro API (Bun OS fork)'
arch=('x86_64')
url='https://github.com/aphrody-labs/retroarch'
license=('GPL-3.0-or-later')
depends=('alsa-lib' 'dbus' 'ffmpeg' 'flac' 'fontconfig' 'freetype2' 'libass' 'libdrm' 'libgl' 'libpulse' 'libudev.so'
         'libusb' 'libx11' 'libxext' 'libxinerama' 'libxkbcommon' 'libxrandr' 'libxv' 'libxxf86vm' 'mbedtls'
         'mesa' 'openal' 'pipewire' 'qt6-base' 'sdl2' 'v4l-utils' 'vulkan-icd-loader' 'wayland' 'zlib'
         'libretro-core-info')
makedepends=('git' 'vulkan-headers' 'wayland-protocols' 'python')
optdepends=('retroarch-assets-ozone: Ozone menu assets'
            'retroarch-assets-xmb: XMB menu assets')
provides=('retroarch')
conflicts=('retroarch')
backup=('etc/retroarch.cfg')
options=('!debug')
source=("retroarch::git+https://github.com/aphrody-labs/retroarch.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
  cd retroarch
  ./configure --prefix=/usr --sysconfdir=/etc --disable-builtinflac --disable-builtinmbedtls --disable-builtinzlib \
    --disable-cg --disable-jack --disable-oss --enable-dbus --enable-pipewire --enable-vulkan --enable-wayland
  make -j4
  make -C libretro-common/audio/dsp_filters
  make -C gfx/video_filters
}

package() {
  cd retroarch
  make DESTDIR="$pkgdir" install
  install -Dm644 libretro-common/audio/dsp_filters/*.dsp libretro-common/audio/dsp_filters/*.so \
    -t "$pkgdir/usr/lib/retroarch/filters/audio/"
  install -Dm644 gfx/video_filters/*.filt gfx/video_filters/*.so -t "$pkgdir/usr/lib/retroarch/filters/video/"
  sed -i 's|# libretro_directory =|libretro_directory = "/usr/lib/libretro"|; s|# libretro_info_path =|libretro_info_path = "/usr/share/libretro/info"|' \
    "$pkgdir/etc/retroarch.cfg"
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}
