# SPDX-License-Identifier: Apache-2.0
# Cemu (Wii U) from the Bun OS fork (vendor/cemu, aphrody-labs/Cemu). Recipe follows the AUR cemu package (system
# libraries, no vcpkg). Wii U keys and titles are never shipped.
pkgname=cemu
pkgver=2.6.re710761
pkgrel=1
_commit=e7107612785946da857d9b6df4ec665844cb89bd
pkgdesc='Wii U emulator (Bun OS fork of Cemu)'
arch=('x86_64')
url='https://github.com/aphrody-labs/Cemu'
license=('MPL-2.0')
depends=('bluez-libs' 'boost-libs' 'cubeb' 'curl' 'fmt' 'glib2' 'gtk3' 'hidapi' 'libpng' 'libusb' 'libzip' 'openssl'
         'pugixml' 'sdl2' 'vulkan-icd-loader' 'wayland' 'wxwidgets-gtk3' 'zarchive' 'zlib' 'zstd')
makedepends=('boost' 'clang' 'cmake' 'git' 'glm' 'glslang' 'nasm' 'ninja' 'rapidjson' 'vulkan-headers' 'wayland-protocols')
options=('!debug' '!lto')
source=("cemu::git+https://github.com/aphrody-labs/Cemu.git#commit=${_commit}")
sha256sums=('SKIP')

prepare() {
  cd cemu
  git submodule update --init --recursive --depth 1
}

build() {
  cmake -S cemu -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ \
    -DENABLE_VCPKG=OFF -DPORTABLE=OFF -DENABLE_DISCORD_RPC=OFF -DENABLE_WAYLAND=ON
  cmake --build build -j 4
}

package() {
  cd cemu
  install -Dm755 bin/Cemu_release "$pkgdir/usr/bin/cemu"
  install -d "$pkgdir/usr/share/cemu"
  cp -r bin/gameProfiles bin/resources "$pkgdir/usr/share/cemu/" 2>/dev/null || true
  install -Dm644 dist/linux/info.cemu.Cemu.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 dist/linux/info.cemu.Cemu.metainfo.xml -t "$pkgdir/usr/share/metainfo/"
  install -Dm644 dist/linux/info.cemu.Cemu.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/info.cemu.Cemu.png"
  install -Dm644 LICENSE.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
