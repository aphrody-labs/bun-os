pkgname=cemu
pkgver=2.6
pkgrel=1
pkgdesc="Cemu emulator, upstream cemu-project/Cemu v2.6 release binary packaged for Bun OS"
arch=(x86_64)
url="https://github.com/cemu-project/Cemu"
license=('MPL-2.0')
depends=('glibc' 'hicolor-icon-theme')
options=('!strip' '!debug')
source=("Cemu-2.6-x86_64.AppImage::https://github.com/cemu-project/Cemu/releases/download/v2.6/Cemu-2.6-x86_64.AppImage" "cemu.desktop" "cemu.svg" "cemu.metainfo.xml")
sha256sums=('0c20c4aeb800bb13d9bab9474ef45a6f8fcde6402cad9b32ac2a1bbd03186313' 'SKIP' 'SKIP' 'SKIP')
noextract=("Cemu-2.6-x86_64.AppImage")

prepare() {
  cd "$srcdir"
  local image
  image=$(find . -maxdepth 2 -iname '*.AppImage' | head -n1)
  chmod +x "$image"
  rm -rf squashfs-root
  "$image" --appimage-extract >/dev/null
}

package() {
  install -d "$pkgdir/opt/cemu" "$pkgdir/usr/bin"
  cp -a "$srcdir/squashfs-root/." "$pkgdir/opt/cemu/"
  chmod -R u+rwX,go+rX "$pkgdir/opt/cemu"
  printf '#!/bin/sh\nexec /opt/cemu/AppRun "$@"\n' > "$pkgdir/usr/bin/Cemu"
  chmod 755 "$pkgdir/usr/bin/Cemu"
  install -Dm644 "$srcdir/cemu.desktop" "$pkgdir/usr/share/applications/cemu.desktop"
  install -Dm644 "$srcdir/cemu.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/cemu.svg"
  install -Dm644 "$srcdir/cemu.metainfo.xml" "$pkgdir/usr/share/metainfo/com.aphrody.bunos.cemu.metainfo.xml"
  # Upstream license and notice files shipped inside the image.
  install -d "$pkgdir/usr/share/licenses/cemu"
  find "$srcdir/squashfs-root" -maxdepth 4 -type f \( -iname 'LICENSE*' -o -iname 'COPYING*' -o -iname 'NOTICE*' \) -exec cp -n {} "$pkgdir/usr/share/licenses/cemu/" \; || true
  printf '%s\n' "Upstream: https://github.com/cemu-project/Cemu/releases/download/v2.6/Cemu-2.6-x86_64.AppImage" "sha256: 0c20c4aeb800bb13d9bab9474ef45a6f8fcde6402cad9b32ac2a1bbd03186313" "License: MPL-2.0" > "$pkgdir/usr/share/licenses/cemu/SOURCE"
}
