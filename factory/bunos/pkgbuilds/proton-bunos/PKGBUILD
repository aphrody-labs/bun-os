# SPDX-License-Identifier: Apache-2.0
# Proton for the Bun OS Gamescope session, built from the Bun OS fork of proton-ge-custom (vendor/proton-ge-custom,
# aphrody-labs/proton-ge-custom; Valve's Proton fork is vendor/proton). Native build without the Steam Runtime SDK
# container (--container-engine=none), as Arch distributions build Proton. Installs a Steam compatibility tool that
# umu-launcher uses (PROTONPATH=/usr/share/steam/compatibilitytools.d/proton-bunos). Several hours at -j4.
pkgname=proton-bunos
pkgver=10.r107d34e
pkgrel=1
_commit=107d34ec7c562c56448ab59f13b3f2d88d056e81
pkgdesc='Proton compatibility tool for Windows games (Bun OS fork of proton-ge-custom)'
arch=('x86_64')
url='https://github.com/aphrody-labs/proton-ge-custom'
license=('custom' 'LGPL-2.1-or-later' 'BSD-3-Clause' 'MIT' 'Zlib')
depends=('python' 'vulkan-icd-loader' 'lib32-vulkan-icd-loader' 'lib32-gcc-libs' 'lib32-glibc' 'lib32-libx11'
         'lib32-libxext' 'lib32-libgl' 'lib32-freetype2' 'lib32-gnutls' 'lib32-alsa-lib' 'lib32-libpulse'
         'lib32-sdl2-compat' 'lib32-gst-plugins-base-libs' 'gst-plugins-base-libs' 'ffmpeg' 'sdl2-compat' 'libpulse'
         'alsa-lib' 'gnutls' 'freetype2' 'libxcomposite' 'libxinerama' 'libxrandr' 'libxi' 'libxcursor')
makedepends=('git' 'autoconf' 'automake' 'bison' 'flex' 'cmake' 'meson' 'ninja' 'nasm' 'glslang' 'mingw-w64-gcc'
             'rust' 'lib32-rust-libs' 'python-pefile' 'fontforge' 'afdko' 'perl' 'gettext' 'vulkan-headers'
             'wayland-protocols' 'lib32-wayland' 'lib32-libxkbcommon' 'libxkbcommon' 'lib32-mesa' 'mesa'
             'lib32-gstreamer' 'gstreamer' 'lib32-libva' 'libva' 'lib32-v4l-utils' 'v4l-utils' 'lib32-libcups' 'libcups'
             'lib32-ocl-icd' 'ocl-icd' 'opencl-headers' 'lib32-sdl3' 'sdl3' 'rsync' 'unzip' 'wget')
options=('!debug' '!lto' '!strip' 'staticlibs')
source=("proton-ge-custom::git+https://github.com/aphrody-labs/proton-ge-custom.git#commit=${_commit}")
sha256sums=('SKIP')
_tool=/usr/share/steam/compatibilitytools.d/proton-bunos

prepare() {
  cd proton-ge-custom
  git submodule update --init --recursive --depth 1
  [ -x patches/protonprep-valve-staging.sh ] && ./patches/protonprep-valve-staging.sh
  mkdir -p "$srcdir/build"
}

build() {
  cd "$srcdir/build"
  ../proton-ge-custom/configure.sh --container-engine=none --build-name=proton-bunos
  make -j4 redist
}

package() {
  install -d "$pkgdir$_tool"
  cp -a "$srcdir/build/redist/." "$pkgdir$_tool/"
  install -d "$pkgdir/usr/share/licenses/$pkgname"
  for f in LICENSE LICENSE.OFL PATENTS.AV1; do
    [ -f "$srcdir/proton-ge-custom/$f" ] && install -m644 "$srcdir/proton-ge-custom/$f" "$pkgdir/usr/share/licenses/$pkgname/"
  done
}
