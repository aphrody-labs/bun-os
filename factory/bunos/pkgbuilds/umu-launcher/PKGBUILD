# SPDX-License-Identifier: Apache-2.0
# umu-launcher (Proton outside Steam, in the Steam Linux Runtime) from the Bun OS fork (vendor/umu-launcher,
# aphrody-labs/umu-launcher). Recipe follows the upstream packaging (configure.sh + make).
pkgname=umu-launcher
pkgver=1.3.re2b203a
pkgrel=1
_commit=e2b203a1fdd2af9f35166f5713cb3f85d72587e2
pkgdesc='Unified launcher for Windows games on Linux with Proton (Bun OS fork)'
arch=('x86_64')
url='https://github.com/aphrody-labs/umu-launcher'
license=('GPL-3.0-only')
depends=('bash' 'python' 'python-filelock' 'python-urllib3' 'python-xlib' 'python-xxhash' 'python-cbor2'
         'python-pyzstd')
makedepends=('cargo' 'git' 'python-build' 'python-hatchling' 'python-installer' 'python-wheel' 'scdoc' 'python-hatch-vcs')
options=('!debug')
source=("umu-launcher::git+https://github.com/aphrody-labs/umu-launcher.git#commit=${_commit}")
sha256sums=('SKIP')

prepare() {
  cd umu-launcher
  git submodule update --init --recursive --depth 1
}

build() {
  cd umu-launcher
  ./configure.sh --prefix=/usr --use-system-pyzstd --use-system-urllib
  make -j4
}

package() {
  cd umu-launcher
  make DESTDIR="$pkgdir" PYTHONDIR="$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')" install
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
