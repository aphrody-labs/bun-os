pkgname=flycast
pkgver=2.7
pkgrel=1
pkgdesc="Flycast emulator, upstream flyinghead/flycast v2.7 release binary packaged for Bun OS"
arch=(x86_64)
url="https://github.com/flyinghead/flycast"
license=('GPL-2.0-only')
depends=('glibc' 'hicolor-icon-theme')
options=('!strip' '!debug')
source=("flycast-x86_64-2.7.AppImage::https://github.com/flyinghead/flycast/releases/download/v2.7/flycast-x86_64-2.7.AppImage" "flycast.desktop" "flycast.svg" "flycast.metainfo.xml")
sha256sums=('5b9f8a636a6acb8446bc78fe96650d8cb8233ac9f8ce69665dab3f39a1cbaae1' 'SKIP' 'SKIP' 'SKIP')
noextract=("flycast-x86_64-2.7.AppImage")

prepare() {
  cd "$srcdir"
  local image
  image=$(find . -maxdepth 2 -iname '*.AppImage' | head -n1)
  chmod +x "$image"
  rm -rf squashfs-root
  "$image" --appimage-extract >/dev/null
}

package() {
  install -d "$pkgdir/opt/flycast" "$pkgdir/usr/bin"
  cp -a "$srcdir/squashfs-root/." "$pkgdir/opt/flycast/"
  chmod -R u+rwX,go+rX "$pkgdir/opt/flycast"
  printf '#!/bin/sh\nexec /opt/flycast/AppRun "$@"\n' > "$pkgdir/usr/bin/flycast"
  chmod 755 "$pkgdir/usr/bin/flycast"
  install -Dm644 "$srcdir/flycast.desktop" "$pkgdir/usr/share/applications/flycast.desktop"
  install -Dm644 "$srcdir/flycast.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/flycast.svg"
  install -Dm644 "$srcdir/flycast.metainfo.xml" "$pkgdir/usr/share/metainfo/com.aphrody.bunos.flycast.metainfo.xml"
  # Upstream license and notice files shipped inside the image.
  install -d "$pkgdir/usr/share/licenses/flycast"
  find "$srcdir/squashfs-root" -maxdepth 4 -type f \( -iname 'LICENSE*' -o -iname 'COPYING*' -o -iname 'NOTICE*' \) -exec cp -n {} "$pkgdir/usr/share/licenses/flycast/" \; || true
  printf '%s\n' "Upstream: https://github.com/flyinghead/flycast/releases/download/v2.7/flycast-x86_64-2.7.AppImage" "sha256: 5b9f8a636a6acb8446bc78fe96650d8cb8233ac9f8ce69665dab3f39a1cbaae1" "License: GPL-2.0-only" > "$pkgdir/usr/share/licenses/flycast/SOURCE"
}
