# SPDX-License-Identifier: Apache-2.0
# Vita3K (PlayStation Vita) from the Bun OS fork (vendor/vita3k, aphrody-labs/Vita3K). Vita firmware is never shipped.
pkgname=vita3k
pkgver=0.2.rfea7c37
pkgrel=1
_commit=fea7c3718da7dcdd31ff56924768a7a0ca20ff59
pkgdesc='PlayStation Vita emulator (Bun OS fork of Vita3K)'
arch=('x86_64')
url='https://github.com/aphrody-labs/Vita3K'
license=('GPL-2.0-or-later')
depends=('gtk3' 'libgl' 'openssl' 'sdl3' 'vulkan-icd-loader' 'zlib')
makedepends=('boost' 'clang' 'cmake' 'git' 'lld' 'ninja' 'python' 'vulkan-headers')
provides=('vita3k-bin')
conflicts=('vita3k-bin')
options=('!debug' '!lto')
source=("vita3k::git+https://github.com/aphrody-labs/Vita3K.git#commit=${_commit}")
sha256sums=('SKIP')

prepare() {
  cd vita3k
  git submodule update --init --recursive --depth 1
}

build() {
  cmake -S vita3k -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ \
    -DUSE_DISCORD_RICH_PRESENCE=OFF -DUSE_VITA3K_UPDATE=OFF
  cmake --build build -j 4
}

package() {
  install -d "$pkgdir/opt/vita3k" "$pkgdir/usr/bin"
  cp -a build/bin/. "$pkgdir/opt/vita3k/"
  ln -s /opt/vita3k/Vita3K "$pkgdir/usr/bin/Vita3K"
  cd vita3k
  install -Dm644 data/image/icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/vita3k.png" 2>/dev/null || true
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/vita3k.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=Vita3K
Comment=PlayStation Vita emulator
Exec=Vita3K %f
Icon=vita3k
Terminal=false
Categories=Game;Emulator;
DESKTOP
  install -Dm644 /dev/stdin "$pkgdir/usr/share/metainfo/vita3k.metainfo.xml" <<'META'
<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>vita3k</id>
  <name>Vita3K</name>
  <summary>PlayStation Vita emulator</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>
  <launchable type="desktop-id">vita3k.desktop</launchable>
  <url type="homepage">https://vita3k.org</url>
  <categories><category>Game</category><category>Emulator</category></categories>
  <content_rating type="oars-1.1"/>
</component>
META
  install -Dm644 COPYING.txt -t "$pkgdir/usr/share/licenses/$pkgname/" 2>/dev/null || install -Dm644 LICENSE* -t "$pkgdir/usr/share/licenses/$pkgname/"
}
