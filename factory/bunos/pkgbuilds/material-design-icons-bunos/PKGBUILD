# Material Symbols and icon fonts from the aphrody-labs/material-design-icons submodule.
pkgname=material-design-icons-bunos
pkgver=r1
pkgrel=3
_commit=b45878038c54b89ec8405dce1da18aba6379f5df
pkgdesc='Material Symbols SVG icons (and Material icon fonts when the pinned source ships them) for Bun OS'
arch=('any')
options=('!strip' '!debug')
url='https://github.com/aphrody-labs/material-design-icons'
license=('Apache-2.0')
source=("mdi::git+https://github.com/aphrody-labs/material-design-icons.git#commit=${_commit}")
sha256sums=('SKIP')

package() {
  cd mdi
  [[ -d font ]] && find font -type f \( -name '*.ttf' -o -name '*.otf' -o -name '*.woff2' \) -exec install -Dm644 -t "$pkgdir/usr/share/fonts/material-design-icons" {} +
  [[ -d symbols ]] && { install -dm755 "$pkgdir/usr/share/icons/material-symbols"; cp -a symbols/. "$pkgdir/usr/share/icons/material-symbols/"; }
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
