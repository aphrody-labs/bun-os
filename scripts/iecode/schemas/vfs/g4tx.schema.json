{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aphrody.com/schemas/vfs/g4tx.schema.json",
  "title": "G4txContainerSchema",
  "description": "Validation schema for Level-5 G4TX Texture Container decoded metadata and sprite atlas subregions.",
  "type": "object",
  "required": ["magic", "headerSize", "textureCount", "textures"],
  "properties": {
    "magic": {
      "type": "string",
      "const": "G4TX"
    },
    "headerSize": {
      "type": "integer",
      "minimum": 32
    },
    "textureCount": {
      "type": "integer",
      "minimum": 1
    },
    "atlasSubregionCount": {
      "type": "integer",
      "minimum": 0
    },
    "textures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "width", "height", "format", "dataOffset", "dataSize"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "format": { "type": "string" },
          "mipLevels": { "type": "integer", "minimum": 1 },
          "dataOffset": { "type": "integer", "minimum": 0 },
          "dataSize": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "atlasSubregions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "x", "y", "width", "height"],
        "properties": {
          "name": { "type": "string" },
          "x": { "type": "integer", "minimum": 0 },
          "y": { "type": "integer", "minimum": 0 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
