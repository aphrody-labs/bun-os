{
  "schemaVersion": 1,
  "scheduler": "systemd-timers-and-windows-task-scheduler",
  "principle": "one-scheduler-per-data-class",
  "timers": [
    {
      "id": "infra-sync",
      "host": "dbfr",
      "cadence": "on-demand-or-hourly",
      "priority": "deferred",
      "owns": ["replication-checksums", "asset-manifest"]
    },
    {
      "id": "infra-cleanup",
      "host": "vps",
      "cadence": "daily",
      "priority": "low",
      "owns": ["journal-retention", "release-retention", "temporary-files"]
    }
  ],
  "disabledByDefault": [
    "crawler",
    "full-site-mirror",
    "duplicate-db-mirror",
    "per-app-cron"
  ],
  "unverifiedBackupDataClasses": [
    "redis-config",
    "release-slot",
    "nie-sqlite",
    "nie-postgresql-schema",
    "aphrody-rag-postgresql",
    "aphrody-web-postgresql"
  ],
  "rules": [
    "no crawler runs continuously in production",
    "no database has more than one active mirror direction",
    "sync is checksum-based and resumable",
    "cleanup never touches active release, primary data or non-regenerable assets"
  ]
}
