{
  "schemaVersion": 1,
  "owner": "aphrody-infra",
  "enabled": true,
  "target": "vps",
  "windowsFactory": {
    "host": "omar-pc",
    "target": "windows-x64",
    "enabled": false,
    "nativeArchitectures": [
      "x64"
    ],
    "crossArchitectures": [
      "arm64"
    ],
    "maxJobs": 1,
    "reserveMemoryGiB": 6,
    "reserveDiskGiB": 20,
    "scope": [
      "windows-native-builds",
      "windows-packaging",
      "windows-smoke-tests"
    ],
    "execution": "local-windows"
  },
  "executionOnlyTargets": [],
  "workspaceRoot": "/home/ubuntu/src/bun-os",
  "cacheRoot": "/home/ubuntu/build/storage/cache",
  "artifactRoot": "/home/ubuntu/build/storage/artifacts",
  "lockPath": "/home/ubuntu/build/locks/heavy.lock",
  "hostEnvironment": {
    "name": "APHRODY_BUILD_HOST",
    "value": "vps"
  },
  "rust": {
    "maxJobs": 4,
    "serialized": true,
    "wrapper": "scripts/cargo.ts",
    "incremental": false,
    "cache": "sccache"
  },
  "bun": {
    "heavyJobs": 1,
    "frozenLockfile": true
  },
  "local": {
    "allowed": [
      "help",
      "plan",
      "inventory",
      "source-edit",
      "scoped-static-check"
    ],
    "heavyExecution": "remote"
  },
  "transport": {
    "owner": "aphrody-infra ssh",
    "sync": "sync",
    "exec": "exec",
    "sourcePolicy": "clean-pinned-first-party-source",
    "secrets": "host-local-private-files-only"
  },
  "retention": {
    "preserve": [
      "active-releases",
      "rollback-releases",
      "primary-data",
      "source-patches",
      "cargo-cache",
      "sccache",
      "bun-cache"
    ],
    "cleanup": "existing-infra-allowlist-only"
  },
  "repositories": {
    "bun-os": "/home/ubuntu/src/bun-os",
    "aphrody": "/home/ubuntu/src/bun-os",
    "yolo": "/home/ubuntu/src/bun-os",
    "iecode": "/home/ubuntu/src/iecode",
    "bun-runtime": "/home/ubuntu/src/bun"
  },
  "next": {
    "image": "node:22-bookworm-slim",
    "pull": "never",
    "cpus": 6,
    "memoryMiB": 16384,
    "maxOldSpaceSizeMiB": 8192
  },
  "cleanup": {
    "transientRoot": "/home/ubuntu/build/storage/transient",
    "privilegeBinary": "/usr/bin/sudo-rs",
    "retiredOutputs": []
  },
  "resources": {
    "reserveMemoryGiB": 8,
    "reserveDiskGiB": 32,
    "memoryPerJobGiB": 1
  }
}
