{
  "schemaVersion": 1,
  "owner": "@aphrody/workspace",
  "protocol": {
    "name": "A2A",
    "version": "1.0",
    "binding": "JSON-RPC 2.0",
    "rpcPath": "/a2a",
    "agentCardPath": "/.well-known/agent-card.json"
  },
  "coord": {
    "directory": ".coord",
    "location": "repository-root",
    "format": "jsonl",
    "inbox": ".coord/inbox-from-<peer>.jsonl",
    "outbox": ".coord/outbox-to-<peer>.jsonl",
    "envelope": [
      "v",
      "ts",
      "id",
      "from",
      "to",
      "kind",
      "topic",
      "body",
      "re",
      "channel_hint"
    ],
    "gitPolicy": "untracked-runtime-state",
    "retention": "operator-rotated; never contains secrets"
  },
  "peers": [
    {
      "id": "android",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-android.jsonl",
      "authEnv": null
    },
    {
      "id": "aphrody-app-purge",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-aphrody-app-purge.jsonl",
      "authEnv": null
    },
    {
      "id": "aphrody-vps",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-aphrody-vps.jsonl",
      "authEnv": null
    },
    {
      "id": "architect",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-architect.jsonl",
      "authEnv": null
    },
    {
      "id": "blockers",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-blockers.jsonl",
      "authEnv": null
    },
    {
      "id": "bun-ui",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-bun-ui.jsonl",
      "authEnv": null
    },
    {
      "id": "codex",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-codex.jsonl",
      "authEnv": null
    },
    {
      "id": "discord-purge",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-discord-purge.jsonl",
      "authEnv": null
    },
    {
      "id": "emulators",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-emulators.jsonl",
      "authEnv": null
    },
    {
      "id": "fork-migration",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-fork-migration.jsonl",
      "authEnv": null
    },
    {
      "id": "google",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-google.jsonl",
      "authEnv": null
    },
    {
      "id": "googlebook",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-googlebook.jsonl",
      "authEnv": null
    },
    {
      "id": "help-wanted",
      "role": "coordination-channel",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-help-wanted.jsonl",
      "authEnv": null
    },
    {
      "id": "jvm-flutter",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-jvm-flutter.jsonl",
      "authEnv": null
    },
    {
      "id": "native-apps",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-native-apps.jsonl",
      "authEnv": null
    },
    {
      "id": "product",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-product.jsonl",
      "authEnv": null
    },
    {
      "id": "redox-cosmic",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-redox-cosmic.jsonl",
      "authEnv": null
    },
    {
      "id": "rust-base",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-rust-base.jsonl",
      "authEnv": null
    },
    {
      "id": "sessions",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-sessions.jsonl",
      "authEnv": null
    },
    {
      "id": "store",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-store.jsonl",
      "authEnv": null
    },
    {
      "id": "unified-image",
      "role": "coding-agent",
      "application": "bun-os",
      "transport": "coord-file",
      "endpoint": ".coord/inbox-from-unified-image.jsonl",
      "authEnv": null
    }
  ],
  "policy": {
    "secrets": "authEnv names an operator-managed environment variable; values never live in Git"
  },
  "codingAgents": {
    "workspace": "repository-root",
    "branchPolicy": "same-current-branch",
    "rules": "AGENTS.md",
    "sessionOwner": "aphrody-session/external",
    "syncCommand": [
      "aphrody",
      "ai",
      "sync-sessions",
      "--watch",
      "--interval-secs",
      "30",
      "--json",
      "--shared-workspace",
      "."
    ],
    "memoryStore": "~/.aphrody/memory/memory.sqlite",
    "contextFiles": [
      ".coord/shared/MEMORY.md",
      ".coord/shared/CONVERSATIONS.md",
      ".coord/shared/TRANSCRIPTS.md"
    ],
    "commitPolicy": "one-integrator; distinct-file-claims",
    "claimCommand": [
      "aphrody",
      "a2a",
      "invoke",
      "--peer",
      "<agent>",
      "--claim",
      "<relative-file-family>",
      "<task>"
    ]
  }
}
