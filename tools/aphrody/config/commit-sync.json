{
  "schemaVersion": 1,
  "owners": [
    "aphrody-labs",
    "aphrody-dev",
    "yohan971"
  ],
  "pollIntervalMs": 60000,
  "debounceMs": 250,
  "commandTimeoutMs": 30000,
  "repositories": [
    {
      "id": "bun-os",
      "repositoryName": "bun-distribution",
      "path": ".",
      "remote": "github",
      "sourceBranch": "os",
      "destinationBranch": "os",
      "fastForward": true,
      "buildEnabled": false
    },
    {
      "id": "bun-runtime",
      "repositoryName": "bun",
      "path": "../bun",
      "remote": "origin",
      "sourceBranch": "main",
      "destinationBranch": "main",
      "fastForward": true,
      "buildEnabled": false
    }
  ]
}
