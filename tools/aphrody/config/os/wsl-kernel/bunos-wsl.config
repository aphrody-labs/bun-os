# SPDX-License-Identifier: GPL-2.0
# Bun OS WSL2 kernel fragment, merged over Microsoft's config-wsl
# (WSL2-Linux-Kernel linux-msft-wsl-6.18.y) for Linux 7.3 + CachyOS.
#
# Toggles: build-wsl-kernel.sh keeps a "@toggle NAME" section when
# BUNOS_WSL_<NAME>=1 (or its default=on) and drops it when =0. Lines before
# the first toggle always apply. "@else" lines apply when the toggle is off.
#
#   BUNOS_WSL_GPU    dxgkrnl (/dev/dxg) GPU paravirtualization       default on
#   BUNOS_WSL_RUST   CONFIG_RUST and Rust abstractions               default on
#   BUNOS_WSL_CACHY  CachyOS BORE scheduler, 1000 Hz, full preempt   default on
#   BUNOS_WSL_DEBUG  lock/atomic debugging, DWARF5, gdb scripts      default off

CONFIG_LOCALVERSION="-bunos-wsl"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KERNEL_ZSTD=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y

# Hyper-V guest, vsock, 9p (drvfs/plan9), virtiofs, balloon (Microsoft config-wsl)
CONFIG_HYPERV=y
CONFIG_HYPERV_UTILS=y
CONFIG_HYPERV_BALLOON=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_HYPERV_KEYBOARD=y
CONFIG_HID_HYPERV_MOUSE=m
CONFIG_PCI_HYPERV=y
CONFIG_VSOCKETS=y
CONFIG_HYPERV_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_9P_FS_SECURITY=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_FUSE_DAX=y
CONFIG_DAX=y
CONFIG_FS_DAX=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_PAGE_REPORTING=y

# Arch/systemd userspace
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_IO_URING=y
CONFIG_PSI=y
CONFIG_DMIID=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_XFS_FS=m
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EROFS_FS=m

# Containers: namespaces, cgroup v2, BPF
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_TIME_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_MISC=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_LSM=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_USERFAULTFD=y
CONFIG_MEMFD_CREATE=y
CONFIG_KSM=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZRAM=m
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y

# Networking: nftables, bridges, overlays for podman/docker
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=m
CONFIG_NFT_FIB_INET=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_VXLAN=y
CONFIG_TUN=y
CONFIG_WIREGUARD=m
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y

# Nested KVM (needs nestedVirtualization=true in .wslconfig)
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
CONFIG_VHOST_NET=m
CONFIG_VHOST_VSOCK=m

# Display: WSLg uses the Windows host compositor over RDP; vgem backs mesa d3d12
CONFIG_DRM=y
CONFIG_DRM_VGEM=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y

# @toggle GPU default=on
CONFIG_DXGKRNL=y
# @else
# CONFIG_DXGKRNL is not set
# @end

# @toggle RUST default=on
CONFIG_RUST=y
CONFIG_GENDWARFKSYMS=y
# CONFIG_RUST_OVERFLOW_CHECKS is not set
# CONFIG_RUST_DEBUG_ASSERTIONS is not set
CONFIG_RUST_FW_LOADER_ABSTRACTIONS=y
# @else
# CONFIG_RUST is not set
# @end

# @toggle CACHY default=on
CONFIG_CACHY=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3=y
CONFIG_SCHED_BORE=y
CONFIG_HZ_1000=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_PREEMPT=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
# @else
# CONFIG_SCHED_BORE is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_HZ_250=y
# @end

# @toggle DEBUG default=off
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_GDB_SCRIPTS=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y
CONFIG_PROVE_LOCKING=y
# @else
# CONFIG_PROVE_LOCKING is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set
# @end
