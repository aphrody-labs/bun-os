APHRODY_AI_VISION_BASE_URL=
# APHRODY_AI_VISION_MODEL: model.
# Default model: qwen3-vl-8b-instruct-q4km.
# vps: unavailable, no local VLM on vps; ai-http /vision/structured forwards to the configured backend.
