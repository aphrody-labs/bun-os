# Generated by scripts/aphrody/tools/infra/gen-local-ai-env.ts from tools/aphrody/config/local-ai.json. Do not edit by hand:
# change the contract, then run `bun scripts/aphrody/tools/infra/gen-local-ai-env.ts`.
# Contract aphrody-local-ai, schemaVersion 1.
#
# Values stay empty on purpose. Each target fills them as commented below;
# consumers read the canonical name first, then each legacy alias in order.
# Secrets come from operator-managed env files, never from Git.

## Binary aphrody: package aphrody (aphrody-ai)
# APHRODY_BIN: path.
APHRODY_BIN=

## Binary aphrody-mcp: package aphrody-mcp (aphrody-ai, features toolbox)
# APHRODY_AI_MCP_BIN: path.
# Legacy aliases, read in this order: APHRODY_MCP_BIN.
APHRODY_AI_MCP_BIN=

## Gateway ai-http: aphrody-rest, service aphrody-ai-http, basePath /api/v1/shenron, auth bearer
# Operations: /health /rag/search /rag/document /rag/stats /rag/ingest /rag/sync/finish /llm/chat /embed /vision/structured /ocr
# APHRODY_AI_HTTP_URL: url, origin form.
# vps: http://127.0.0.1:8789
# windows-local: not provided (aphrody-ai-http does not run there).
# linux-container-26.04: not provided (aphrody-ai-http does not run there).
APHRODY_AI_HTTP_URL=
# APHRODY_AI_HTTP_TOKEN: secret.
# vps: not set by the contract.
# windows-local: not provided (aphrody-ai-http does not run there).
# linux-container-26.04: not provided (aphrody-ai-http does not run there).
APHRODY_AI_HTTP_TOKEN=

## Capability chat: openai-compatible, service aphrody-managed-llama, basePath /v1
# Operations: /chat/completions
# APHRODY_AI_CHAT_BASE_URL: url, base form.
# Legacy aliases, read in this order: APHRODY_OSS_BASE_URL, APHRODY_LOCAL_MODEL_URL (origin form).
# vps: unavailable, no local LLM on vps; generation goes through ai-http /llm/chat, routed to Gemini Web (remote).
# windows-local: printed by `aphrody ai env`.
# linux-container-26.04: printed by `aphrody ai env`.
APHRODY_AI_CHAT_BASE_URL=
# APHRODY_AI_CHAT_MODEL: model.
# Legacy aliases, read in this order: APHRODY_LLM_MODEL.
# Default model: qwen3-30b-a3b-instruct-2507-q4km.
# vps: unavailable, no local LLM on vps; generation goes through ai-http /llm/chat, routed to Gemini Web (remote).
# windows-local: printed by `aphrody ai env`.
# linux-container-26.04: printed by `aphrody ai env`.
APHRODY_AI_CHAT_MODEL=
# APHRODY_AI_CHAT_API_KEY: secret.
# Legacy aliases, read in this order: APHRODY_AI_CHAT_TOKEN, VLLM_API_KEY.
# vps: unavailable, no local LLM on vps; generation goes through ai-http /llm/chat, routed to Gemini Web (remote).
# windows-local: printed by `aphrody ai env`.
# linux-container-26.04: printed by `aphrody ai env`.
APHRODY_AI_CHAT_API_KEY=

## Capability code: openai-compatible, service aphrody-managed-llama, basePath /v1
# Operations: /chat/completions
# Base URL: shared with chat.
# APHRODY_AI_CODE_MODEL: model.
# Default model: qwen3-coder-30b-a3b-q4km.
# vps: unavailable, no local LLM on vps.
# windows-local: printed by `aphrody ai env`.
# linux-container-26.04: printed by `aphrody ai env`.
APHRODY_AI_CODE_MODEL=

## Capability reasoning: openai-compatible, service aphrody-managed-llama, basePath /v1
# Operations: /chat/completions
# Base URL: shared with chat.
# APHRODY_AI_REASONING_MODEL: model.
