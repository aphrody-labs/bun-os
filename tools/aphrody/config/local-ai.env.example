## Capability ocr: cli, binary aphrody, command `aphrody ocr page`
# Also exposed as the aphrody_ocr MCP tool (aphrody-mcp --features ocr) and, on vps, as ai-http /ocr.
# APHRODY_AI_OCR_MODEL: model.
# Default model: granite-docling-258m.
# vps: unavailable, use ai-http /ocr (aphrody OCR engine inside aphrody-ai-http).
# windows-local: printed by `aphrody ai env`.
# linux-container-26.04: printed by `aphrody ai env`.
APHRODY_AI_OCR_MODEL=

## Capability stt: mcp-stdio, binary aphrody-mcp, tool aphrody_transcribe
# APHRODY_AI_STT_MODEL: model.
# Default model: whisper-large-v3-turbo-q8.
# vps: unavailable, no STT workload on vps.
# windows-local: printed by `aphrody ai env`.
# linux-container-26.04: printed by `aphrody ai env`.
APHRODY_AI_STT_MODEL=

## Capability tts: mcp-stdio, binary aphrody-mcp, tool voice_synthesize
# Not served locally.
# No open-weight TTS model is catalogued in aphrody-models; voice_synthesize calls ElevenLabs (remote, operator key). A local TTS model needs a catalog entry and a role before it gets a canonical env name.
# No canonical env name.

## Capability embed: openai-compatible, service aphrody-managed-llama, basePath /v1
# Operations: /embeddings
# The default model is for new local indexes only. Querying an existing index uses that index's model and dimensions (see indexes).
# APHRODY_AI_EMBED_BASE_URL: url, base form.
# Legacy aliases, read in this order: EMBED_URL (origin form), APHRODY_RAG_EMBED_ENDPOINT (endpoint form).
# vps: unavailable, no embedding service on vps.
# windows-local: printed by `aphrody ai env`.
# linux-container-26.04: printed by `aphrody ai env`.
APHRODY_AI_EMBED_BASE_URL=
# APHRODY_AI_EMBED_MODEL: model.
# Legacy aliases, read in this order: APHRODY_RAG_EMBED_MODEL.
# Default model: qwen3-embedding-0.6b.
# vps: unavailable, no embedding service on vps.
# windows-local: printed by `aphrody ai env`.
# linux-container-26.04: printed by `aphrody ai env`.
APHRODY_AI_EMBED_MODEL=
# APHRODY_AI_EMBED_DIMENSIONS: dimensions.
# Legacy aliases, read in this order: APHRODY_RAG_EMBED_DIM.
# Default dimensions: 1024.
# vps: unavailable, no embedding service on vps.
# windows-local: printed by `aphrody ai env`.
# linux-container-26.04: printed by `aphrody ai env`.
APHRODY_AI_EMBED_DIMENSIONS=

## Capability rerank: openai-compatible, service aphrody-managed-llama, basePath /v1
# Operations: /rerank
# llama-server rerank dialect: {model, query, documents} -> {results: [{index, relevance_score}]}.
# APHRODY_AI_RERANK_BASE_URL: url, base form.
# Legacy aliases, read in this order: RERANK_URL (endpoint form), APHRODY_RAG_RERANK_ENDPOINT (endpoint form).
# vps: unavailable, no rerank service in tools/config/service-catalog.json.
# windows-local: printed by `aphrody ai env`.
# linux-container-26.04: printed by `aphrody ai env`.
APHRODY_AI_RERANK_BASE_URL=
# APHRODY_AI_RERANK_MODEL: model.
# Legacy aliases, read in this order: APHRODY_RAG_RERANK_MODEL.
# Default model: qwen3-reranker-0.6b-q8.
# vps: unavailable, no rerank service in tools/config/service-catalog.json.
# windows-local: printed by `aphrody ai env`.
# linux-container-26.04: printed by `aphrody ai env`.
APHRODY_AI_RERANK_MODEL=
