{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "bun-types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "container/**/*.ts",
    "factory/**/*.ts",
    "infra/**/*.ts",
    "scripts/**/*.ts",
    "apps/desktop/**/*.ts",
    "packages/*/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "target",
    "dist",
    "toolchains",
    "apps/desktop/dist",
    "apps/desktop/src-tauri",
    "scripts/aphrody",
    "scripts/iecode",
    "scripts/m3"
  ]
}
