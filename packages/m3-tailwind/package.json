{
  "name": "@aphrody/m3-tailwind",
  "version": "1.4.7",
  "description": "Tailwind v4 CSS-first preset for Material 3: generates @theme (colour roles, shape, typescale, elevation, easing) from @aphrody/m3-tokens.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/bun-distribution.git",
    "directory": "packages/m3-tailwind"
  },
  "homepage": "https://github.com/aphrody-labs/bun-distribution/tree/os/packages/m3-tailwind#readme",
  "bugs": {
    "url": "https://github.com/aphrody-labs/bun-distribution/issues"
  },
  "author": "aphrody-code",
  "files": [
    "src",
    "preset.css"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./preset.css": "./preset.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "test": "bun test ./test/",
    "typecheck": "bun check -p tsconfig.json --noEmit",
    "lint": "bun lint src test scripts"
  },
  "dependencies": {
    "@aphrody/m3-tokens": "workspace:*"
  },
  "devDependencies": {
    "@aphrody/bun": "workspace:*",
    "@aphrody/m3-config": "workspace:*",
    "@tailwindcss/node": "catalog:",
    "tailwindcss": "catalog:"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
