    "typecheck": "bun check --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "homepage": "https://github.com/aphrody-labs/bun-os/tree/os/packages/wasm"
