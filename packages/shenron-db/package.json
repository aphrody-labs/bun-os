{
  "name": "@shenron/db",
  "version": "1.4.7",
  "private": true,
  "description": "PostgreSQL partagé Shenron : schéma Drizzle, pool postgres-js (Next) et driver Bun.SQL (scripts, API), indépendant du framework",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/bun-distribution.git",
    "directory": "packages/shenron-db"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./bot-schema": "./src/bot-schema.ts",
    "./full-schema": "./src/full-schema.ts",
    "./constants": "./src/constants.ts",
    "./config": "./src/config.ts",
    "./types": "./src/types.ts",
    "./sql": "./src/sql.ts",
    "./postgres-js": "./src/postgres-js.ts",
    "./bun-sql": "./src/bun-sql.ts",
    "./bun": "./src/bun.ts",
    "./env": "./src/env.ts",
    "./wiki-registry": "./src/wiki-registry.ts",
    "./repos/wiki": "./src/repos/wiki.ts",
    "./repos/agent-keys": "./src/repos/agent-keys.ts",
    "./repos/accounts": "./src/repos/accounts.ts",
    "./guards": "./src/guards.ts",
    "./redis": "./src/redis.ts"
  },
  "scripts": {
    "typecheck": "bun check -p tsconfig.json --noEmit",
    "lint": "bun lint src test scripts",
    "test": "bun test",
    "audit:migrations": "bun scripts/migration-audit.ts --check"
  },
  "dependencies": {
    "@aphrody/sql": "workspace:*",
    "@paralleldrive/cuid2": "catalog:",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "bun-types": "catalog:",
    "@aphrody/bun-workspace": "workspace:*"
  },
  "engines": {
    "bun": "=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "bunos": {
    "runtime": {
      ".": "server",
      "./schema": "pure",
      "./bot-schema": "pure",
      "./full-schema": "pure",
      "./constants": "pure",
      "./config": "pure",
      "./types": "pure",
      "./sql": "server",
      "./postgres-js": "server",
      "./bun-sql": "bun",
      "./bun": "bun",
      "./env": "server",
      "./wiki-registry": "pure",
      "./repos/wiki": "pure",
      "./repos/agent-keys": "pure",
      "./repos/accounts": "pure",
      "./guards": "server",
      "./redis": "bun"
    }
  }
}
