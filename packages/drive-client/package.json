{
  "name": "@aphrody/drive-client",
  "version": "1.4.7",
  "description": "Type-safe TypeScript client for Spacedrive daemon",
  "keywords": [
    "client",
    "daemon",
    "spacedrive",
    "typescript"
  ],
  "license": "FSL-1.1-Apache-2.0",
  "author": "Spacedrive",
  "files": [
    "dist/**/*",
    "src/**/*",
    "src"
  ],
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./generated/types": {
      "types": "./src/generated/types.ts",
      "default": "./src/generated/types.ts"
    },
    "./src/generated/types": {
      "types": "./src/generated/types.ts",
      "default": "./src/generated/types.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    },
    "./hooks/useClient": {
      "types": "./src/hooks/useClient.tsx",
      "default": "./src/hooks/useClient.tsx"
    },
    "./hooks/useNormalizedQuery": {
      "types": "./src/hooks/useNormalizedQuery.ts",
      "default": "./src/hooks/useNormalizedQuery.ts"
    },
    "./src/hooks/useClient": {
      "types": "./src/hooks/useClient.tsx",
      "default": "./src/hooks/useClient.tsx"
    },
    "./src/hooks/useNormalizedQuery": {
      "types": "./src/hooks/useNormalizedQuery.ts",
      "default": "./src/hooks/useNormalizedQuery.ts"
    },
    "./bun": {
      "bun": "./src/bun.ts",
      "types": "./src/bun.ts",
      "default": "./src/bun.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts src/bun.ts src/hooks/index.ts --target bun --packages external --outdir dist",
    "lint": "bun lint src tests",
    "typecheck": "bun check --noEmit",
    "test": "bun test",
    "test:integration": "bun test ./tests/integration",
    "generate-types": "../../scripts/aphrody/build/rust/cargo-serial.sh run --bin generate_typescript_types --manifest-path ../../apps/aphrody-drive/core/Cargo.toml"
  },
  "dependencies": {
    "@aphrody/assets": "workspace:*",
    "type-fest": "catalog:",
    "valibot": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "bun": "1.4.4-canary.20261028.1"
  }
}
