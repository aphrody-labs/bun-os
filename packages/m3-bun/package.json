{
  "name": "@aphrody/m3-bun",
  "version": "1.4.7",
  "description": "The one Bun-native tool for M3 apps: a single Bun plugin and the m3-bun CLI that build, minify, serve (HMR), compile to one executable, package and generate deploy configs (Docker, systemd, nginx, Vercel, Fly.io, Cloudflare, Coolify, VS Code, Windows, minimal Linux image). One Bun file server serves the UI and the API from one process.",
  "keywords": [
    "bun",
    "compile",
    "deploy",
    "material-3"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/bun-distribution.git",
    "directory": "packages/m3-bun"
  },
  "homepage": "https://github.com/aphrody-labs/bun-distribution/tree/os/packages/m3-bun#readme",
  "bugs": {
    "url": "https://github.com/aphrody-labs/bun-distribution/issues"
  },
  "author": "aphrody-code",
  "bin": {
    "m3-bun": "./bin/m3-bun.ts"
  },
  "files": [
    "src",
    "bin",
    "client.d.ts"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin.ts",
    "./server": "./src/server.ts",
    "./api": "./src/api.ts",
    "./config": "./src/config.ts",
    "./targets": "./src/targets/index.ts",
    "./graph": "./src/graph.ts",
    "./runtime": "./src/runtime.ts",
    "./plugins": "./src/plugins.ts",
    "./plugins-m3": "./src/plugins-m3.ts",
    "./db": "./src/server-db.ts",
    "./auth": "./src/server-auth.ts",
    "./secrets": "./src/server-secrets.ts",
    "./cache": "./src/server-cache.ts",
    "./mcp": "./src/server-mcp.ts",
    "./realtime": "./src/server-realtime.ts",
    "./markdown": "./src/server-markdown.ts",
    "./ag-ui": "./src/server-agui.ts",
    "./next": "./src/server-next.ts",
    "./m3-routes": "./src/server-m3.ts",
    "./dev-inspect": "./src/dev-inspect.ts",
    "./dev-error": "./src/dev-error.ts",
    "./theme-css": "./src/theme-css.ts",
    "./tools": "./src/tools-load.ts",
    "./package.json": "./package.json",
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "bun check -p tsconfig.json --noEmit --customConditions bun",
    "test": "bun test",
    "m3-bun": "bun bin/m3-bun.ts"
  },
