{
  "name": "@aphrody/bun-os-plugins",
  "version": "1.4.7",
  "description": "Bun OS plugin registry: every Bun OS capability and every addition migrated from the aphrody-labs/bun fork as a Bun plugin (build.module virtual modules, lazy globals, bins), preloaded once from the root bunfig.toml on upstream Bun canary.",
  "license": "MIT",
  "author": "aphrody-dev <contact@aphrody.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/bun-os.git",
    "directory": "packages/bun-os-plugins"
  },
  "exports": {
    ".": "./src/index.ts",
    "./define": "./src/define.ts",
    "./preload": "./src/preload.ts",
    "./commands": "./src/commands/index.ts",
    "./devtools": "./src/devtools/devtools.ts",
    "./dotnet": "./src/dotnet/dotnet.ts",
    "./dotnet/hostfxr": "./src/dotnet/hostfxr.ts",
    "./dotnet/plugin": "./src/dotnet/plugin.ts"
  },
  "bin": {
    "bun-os-plugins": "./src/cli.ts",
    "bunos-rename": "./src/bin/bunos-rename.ts",
    "bunos-docs": "./src/bin/bunos-docs.ts",
    "bunos-parse": "./src/bin/bunos-parse.ts",
    "bunos-bench": "./src/bin/bunos-bench.ts",
    "bunos-n2b": "./src/bin/bunos-n2b.ts",
    "bunos-migrate": "./src/bin/bunos-migrate.ts",
    "bunos-mcp": "./src/bin/bunos-mcp.ts",
    "bunos-agent-plugin": "./src/bin/bunos-agent-plugin.ts",
    "bunos-workspace": "./src/bin/bunos-workspace.ts",
    "bunos-lsp": "./src/bin/bunos-lsp.ts",
    "bunos-wasm": "./src/bin/bunos-wasm.ts",
    "bunos-search": "./src/bin/bunos-search.ts",
    "bunos-crawl": "./src/bin/bunos-crawl.ts",
    "bunos-ssh": "./src/bin/bunos-ssh.ts",
    "bunos-docker": "./src/bin/bunos-docker.ts",
    "bunos-vpn": "./src/bin/bunos-vpn.ts",
    "bunos-winmd": "./src/bin/bunos-winmd.ts",
    "bunos-just": "./src/bin/bunos-just.ts",
    "bunos-uv": "./src/bin/bunos-uv.ts",
    "bunos-msvc": "./src/bin/bunos-msvc.ts",
    "bunos-sh": "./src/bin/bunos-sh.ts",
    "bunos-plugin": "./src/bin/bunos-plugin.ts",
    "bunos-env": "./src/bin/bunos-env.ts",
    "bunos-cookie": "./src/bin/bunos-cookie.ts",
    "bunos-host": "./src/bin/bunos-host.ts",
    "bunos-python": "./src/bin/bunos-python.ts",
    "bunos-dotnet": "./src/bin/bunos-dotnet.ts"
  },
  "files": [
    "src",
    "LICENSE"
  ],
  "engines": {
    "bun": "1.4.4-canary.20261028.1"
  }
}
