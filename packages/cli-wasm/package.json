{
  "name": "@aphrody/cli-wasm",
  "version": "1.4.7",
  "description": "The pure aphrody commands (rag, toolcall, html, text) as WebAssembly for the browser, Bun and Node: the same code as `aphrody pure` of the native CLI.",
  "license": "Apache-2.0",
  "files": [
    "src",
    "wasm",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#cli-wasm-glue": "./wasm/aphrody_command_wasm.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./wasm/*": "./wasm/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:wasm": "bun ../../scripts/aphrody/build/rust/wasm-package.ts --crate aphrody-command-wasm --out packages/cli-wasm/wasm",
    "stage": "bun ../../scripts/aphrody/release/stage-cli-wasm.ts",
    "typecheck": "bun check --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "bun-types": "catalog:"
  },
  "engines": {
    "bun": "=1.4.4"
  }
}
