{
  "name": "@shenron/dbxv2",
  "version": "1.4.7",
  "private": true,
  "description": "DBXV2 reverse engineering for Shenron: typed bun:ffi and WebAssembly loaders over the bun-re DBXV2 surface (identify, CPK list/extract, EMB/EMD/ESK/gameplay JSON, ACB/AWB to WAV)",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./ffi": "./src/ffi.ts",
    "./wasm": "./src/wasm.ts",
    "./wasm-node": "./src/wasm-node.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "build:wasm": "bun scripts/build-wasm.ts",
    "typecheck": "bun check -p tsconfig.json --noEmit",
    "lint": "bun lint src"
  },
  "devDependencies": {
    "bun-types": "catalog:"
  }
}
