{
  "manifest_version": 3,
  "name": "YouTube Subs Sorter",
  "version": "0.1.0",
  "description": "Range tes abonnements YouTube en groupes colorés, filtre le flux (Shorts, vidéos vues) et trie la liste. 100 % local.",
  "minimum_chrome_version": "110",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/core.js", "src/content.js"],
      "css": ["src/yss-tokens.css", "src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YouTube Subs Sorter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-subs-sorter@aphrody.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
