{
  "name": "@aphrody/winclean",
  "version": "1.4.7",
  "description": "Kernel-backed Bun client for the unified Aphrody OS WinClean catalog (182 tools).",
  "license": "Apache-2.0",
  "author": "aphrody",
  "files": [
    "src",
    "README.md"
  ],
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./windows-host": "./src/windows-host.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --target bun --packages external --outdir dist",
    "lint": "bun lint src test",
    "typecheck": "bun check --noEmit -p .",
    "test": "bun test"
  },
  "dependencies": {
    "@aphrody/os": "workspace:*",
    "@aphrody/winreg": "workspace:*"
  },
  "engines": {
    "bun": "=1.4.4"
  }
}
