{
  "name": "@aphrody/bun-engine",
  "version": "1.4.7",
  "license": "MIT",
  "bin": {
    "bep": "./src/bep.ts",
    "bun-engine": "./src/cli.ts",
    "bun-engine-formats": "./src/formats/main.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/plugins/index.ts",
    "./formats": "./src/formats/index.ts",
    "./webgpu": "./src/gpu/webx.ts",
    "./usr": "./src/usr.ts"
  },
  "scripts": {
    "build": "bun run ./src/cli.ts build",
    "compile": "bun run ./src/cli.ts compile",
    "bep:compile": "bun run ./src/bep-build.ts",
    "formats:compile": "bun run ./src/formats/main.ts compile",
    "test": "bun test ./test",
    "workspace:test": "bun run ./src/cli.ts test",
    "references": "bun run ./src/cli.ts references",
    "web": "bun run ./src/cli.ts web",
    "probe": "bun run ./src/cli.ts probe",
    "qualify:fc27": "bun run ./src/cli.ts qualify 4080220",
    "console:manifest": "bun test ./test/console-catalog.test.ts",
    "native:test": "bun ../../scripts/aphrody/build/rust/cargo-serial.ts --msvc test -p bun-engine -p aphrody-wii -p aphrody-wii-image -p aphrody-switch",
    "nds:tinke:build": "dotnet publish ../../crates/bun-engine-core/dotnet/BunEngine.Nds.Tinke.csproj -c Release -r win-x64 --self-contained -o ../../build/nds/tinke -p:PublishAot=true",
    "console:validate": "bun run ./src/console/validate.ts"
  },
  "dependencies": {
    "@aphrody/bun-workspace": "workspace:*",
    "@aphrody/bun-steam": "workspace:*",
    "@aphrody/typesafe-sdk": "0.6.2",
    "@bun-os/ds-dotnet": "workspace:*",
    "@bun-os/re": "workspace:*"
  },
  "engines": {
    "bun": "=1.4.4"
  }
}
