{
  "name": "@aphrody/app-ui",
  "version": "1.4.7",
  "license": "Apache-2.0",
  "files": [
    "README.md",
    "backend.ts",
    "build.ts",
    "m3.config.ts",
    "scripts",
    "src",
    "undeclared-deps.ts",
    "showcase",
    "!showcase/scripts"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./backend": "./backend.ts",
    "./webos": "./webos.ts",
    "./styles.css": "./src/styles.css",
    "./showcase": "./showcase/src/App.tsx"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun ../m3/bin/m3.ts dev",
    "build": "bun run build.ts",
    "typecheck": "bun check -p tsconfig.json --noEmit",
    "test": "bun test src",
    "brand": "bun run scripts/brand-theme.ts",
    "showcase:inventory": "cd showcase && bun scripts/inventory.ts",
    "showcase:dev": "cd showcase && bun scripts/inventory.ts && bun ../../m3-bun/bin/m3-bun.ts dev",
    "showcase:build": "cd showcase && bun scripts/inventory.ts && bun ../../m3-bun/bin/m3-bun.ts build",
    "showcase:serve": "cd showcase && bun ../../m3-bun/bin/m3-bun.ts serve",
    "showcase:compile": "cd showcase && bun scripts/inventory.ts && bun ../../m3-bun/bin/m3-bun.ts compile",
    "showcase:package": "cd showcase && bun ../../m3-bun/bin/m3-bun.ts package",
    "showcase:deploy": "cd showcase && bun ../../m3-bun/bin/m3-bun.ts deploy all",
    "showcase:smoke": "cd showcase && bun ../../m3-bun/bin/m3-bun.ts smoke",
    "showcase:typecheck": "cd showcase && bun check -p tsconfig.json --noEmit",
    "showcase:test": "cd showcase && bun test ./test && bun test --preload @aphrody/m3-config/test/dom ./test-dom",
    "showcase:tauri": "cd showcase && bun scripts/tauri.ts",
    "showcase:test:dom": "cd showcase && bun test --preload @aphrody/m3-config/test/dom ./test-dom"
  },
  "dependencies": {
    "@aphrody/assets": "workspace:*",
    "@aphrody/bun-webview-page": "0.1.1-aphrody.2",
    "@aphrody/canvas": "workspace:*",
    "@aphrody/drive-client": "workspace:*",
    "@aphrody/eslint-plugin-m3": "workspace:*",
    "@aphrody/fuzzy": "1.4.7",
    "@aphrody/identity": "workspace:*",
    "@aphrody/m3": "workspace:*",
    "@aphrody/m3-ai": "workspace:*",
    "@aphrody/m3-baseui": "workspace:*",
    "@aphrody/m3-bun": "workspace:*",
    "@aphrody/m3-codemods": "workspace:*",
    "@aphrody/m3-design": "workspace:*",
    "@aphrody/m3-explorer": "workspace:*",
    "@aphrody/m3-fonts": "workspace:*",
    "@aphrody/m3-forms": "workspace:*",
    "@aphrody/m3-front": "workspace:*",
    "@aphrody/m3-icons": "workspace:*",
    "@aphrody/m3-mcp": "workspace:*",
    "@aphrody/m3-motion": "workspace:*",
    "@aphrody/m3-next": "workspace:*",
    "@aphrody/m3-os-themes": "workspace:*",
    "@aphrody/m3-primitives": "workspace:*",
    "@aphrody/m3-react": "workspace:*",
    "@aphrody/m3-reader": "workspace:*",
    "@aphrody/m3-tailwind": "workspace:*",
    "@aphrody/m3-theme": "workspace:*",
    "@aphrody/m3-tokens": "workspace:*",
    "@aphrody/material-design-icons": "workspace:*",
    "@aphrody/qr": "1.4.7",
    "@aphrody/scaffold": "workspace:*",
    "@aphrody/tauri": "workspace:*",
    "@aphrody/webos-wasm": "workspace:*",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@mkkellogg/gaussian-splats-3d": "catalog:",
