{
  "name": "@aphrody/scaffold",
  "version": "1.4.7",
  "description": "The single project scaffolder of the UI stack: Tauri 3 shell (pins, config, capabilities, icon), M3 web and app templates, the canonical example and a writer that never overwrites. Used by m3 new, m3-next-migrate and web-to-tauri.",
  "keywords": [
    "material-3",
    "scaffold",
    "tauri",
    "tauri-3",
    "template"
  ],
  "license": "Apache-2.0",
  "author": "aphrody-code",
  "bin": {
    "aphrody-scaffold": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pins": "./src/pins.ts",
    "./png": "./src/png.ts",
    "./names": "./src/names.ts",
    "./files": "./src/files.ts",
    "./tauri": "./src/tauri.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "bun check -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {},
  "devDependencies": {
    "@aphrody/m3-config": "workspace:*"
  },
  "engines": {
    "bun": "1.4.4-canary.20261028.1"
  }
}
