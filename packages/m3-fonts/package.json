{
  "name": "@aphrody/m3-fonts",
  "version": "1.4.7",
  "description": "Aphrody M3 typefaces: Google Sans Flex, Google Sans Code, Roboto Flex, Roboto Mono and Material Symbols with Japanese fallbacks (Noto Sans JP, M PLUS 1 Code) as @font-face CSS and a typed manifest.",
  "keywords": [
    "aphrody",
    "fonts",
    "japanese",
    "material-3",
    "material-symbols"
  ],
  "license": "Apache-2.0 AND OFL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/bun-distribution.git",
    "directory": "packages/m3-fonts"
  },
  "homepage": "https://github.com/aphrody-labs/bun-distribution/tree/os/packages/m3-fonts#readme",
  "bugs": {
    "url": "https://github.com/aphrody-labs/bun-distribution/issues"
  },
  "author": "aphrody-code",
  "files": [
    "README.md",
    "fonts",
    "fonts.lock.json",
    "scripts",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./fonts.css": "./src/fonts.css",
    "./fonts-jp.css": "./src/fonts-jp.css",
    "./fonts-symbols.css": "./src/fonts-symbols.css",
    "./fonts-symbols-full.css": "./src/fonts-symbols-full.css",
    "./fonts/*": "./fonts/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen": "bun scripts/generate.ts",
    "subset": "bun scripts/subset.ts",
    "symbols:names": "bun scripts/symbols-names.ts",
    "typecheck": "bun check -p tsconfig.json --noEmit",
    "test": "bun ../../scripts/m3/fonts-sync.ts --quiet && bun test src",
    "prepack": "bun ../../scripts/m3/fonts-sync.ts --quiet"
  },
  "devDependencies": {
    "@aphrody/m3-config": "workspace:*",
    "@aphrody/winreg": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
