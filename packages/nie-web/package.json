    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "typecheck": "bun check -p tsconfig.json --noEmit"
  },
  "engines": {
    "bun": "1.4.4-canary.20261028.1"
