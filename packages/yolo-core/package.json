{
  "name": "@aphrody/yolo-core",
  "version": "1.4.7",
  "description": "Unified core library for YOLO, modeled directly after Bun's core library architecture",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/aphrody.git",
    "directory": "packages/engine/core"
  },
  "files": [
    "src",
    "data/host-layout.json"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sys": "./src/sys/index.ts",
    "./vfs": "./src/vfs/index.ts",
    "./vendor": "./src/vendor/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./verify": "./src/verify/index.ts",
    "./server": "./src/server/index.ts",
    "./edge-proxy": "./src/server/edge-proxy.ts",
    "./mcp": "./src/tools/registry.ts",
    "./tool-host": "./src/tools/host.ts",
    "./fleet": "./src/fleet/index.ts",
    "./scaffold": "./src/scaffold/index.ts",
    "./curation": "./src/curation/index.ts",
    "./coord": "./src/coord/index.ts",
    "./distribution": "./src/distribution/index.ts",
    "./units": "./src/units/index.ts",
    "./gemma4": "./src/gemma4/index.ts",
    "./redis": "./src/redis/index.ts",
    "./host": "./src/host/index.ts",
    "./ledger": "./src/ledger/index.ts",
    "./monitor": "./src/monitor/index.ts",
    "./pm": "./src/pm/index.ts",
    "./compiler": "./src/compiler/index.ts",
    "./python": "./src/python/index.ts",
    "./src/*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "bun build-policy.ts",
    "test": "bun test test/core.test.ts test/units.test.ts test/ledger.test.ts test/host-config.test.ts test/redis_monitor.test.ts test/startup.test.ts test/gemma4.test.ts test/gemma4-inference.test.ts test/redis_vector.test.ts test/redis_native.test.ts test/core-transport.test.ts test/vfs-consistency.test.ts test/ledger-content.test.ts test/vendor-status.test.ts test/vendor-catalog.test.ts test/package-manager.test.ts",
    "typecheck": "bun check -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aphrody/paths": "workspace:*",
    "@aphrody/runtime-sdk": "workspace:*",
    "@oxc-project/types": "catalog:"
  },
  "engines": {
    "bun": "=1.4.4"
  }
}
