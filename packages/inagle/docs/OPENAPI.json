          },
          "magicAscii": {
            "type": "string",
            "description": "ASCII representation of the magic header (e.g. 'G4TX')"
          },
          "extension": {
            "type": "string",
            "description": "Canonical file extension (e.g. '.g4tx')"
          },
          "description": {
            "type": "string",
