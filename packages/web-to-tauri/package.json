{
  "name": "@aphrody/web-to-tauri",
  "version": "1.4.7",
  "description": "Converts a website, web app or built web bundle into a native Tauri 3 app: probes the target, plans a regression-free mode (remote, bundle, sidecar), generates the project and checks parity against the original.",
  "keywords": [
    "parity",
    "pwa",
    "tauri",
    "tauri-3",
    "webview",
    "wrapper"
  ],
  "license": "Apache-2.0",
  "author": "aphrody-code",
  "bin": {
    "web-to-tauri": "./src/cli.ts"
  },
  "files": [
    "src",
    "fixtures",
    "README.md"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./policy": "./src/policy.ts",
    "./probe": "./src/probe.ts",
    "./plan": "./src/plan.ts",
    "./generate": "./src/generate.ts",
    "./parity": "./src/parity.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "bun check -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@aphrody/bun-web": "1.4.7",
    "@aphrody/scaffold": "workspace:*"
  },
  "devDependencies": {
    "@aphrody/m3-config": "workspace:*"
  },
  "engines": {
    "bun": "=1.4.4"
  }
}
