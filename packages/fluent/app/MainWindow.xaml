<Window x:Class="BunOs.Fluent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TitleBar x:Name="AppTitleBar" Title="Bun OS Fluent" Subtitle="WinUI 3 / Windows App SDK 2.6.4" IsBackButtonVisible="False" AutomationProperties.AutomationId="AppTitleBar"/>
    <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsSettingsVisible="True" IsBackButtonVisible="Collapsed" AutomationProperties.AutomationId="MainNav" SelectionChanged="OnNavChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Home" Icon="Home" Tag="home" AutomationProperties.AutomationId="NavHome"/>
        <NavigationViewItem Content="Apps" Icon="AllApps" Tag="apps" AutomationProperties.AutomationId="NavApps"/>
      </NavigationView.MenuItems>
      <StackPanel Padding="24" Spacing="12">
        <InfoBar x:Name="Info" IsOpen="True" Severity="Success" Title="Fluent 2 shell" Message="Rendered by WinUI 3 with Mica; launched from Bun." IsClosable="False" AutomationProperties.AutomationId="InfoBar"/>
        <TextBlock x:Name="PageTitle" Text="Home" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="PageTitle"/>
        <Button x:Name="DialogButton" Content="Open dialog" Foreground="{ThemeResource Fluent2.colorNeutralForegroundOnBrand}" Background="{ThemeResource Fluent2.colorBrandBackground}" Click="OnOpenDialog" AutomationProperties.AutomationId="DialogButton"/>
      </StackPanel>
    </NavigationView>
  </Grid>
</Window>
