{
  "name": "@aphrody/web-crawl",
  "version": "1.4.7",
  "description": "Typed Aphrody web search, crawling, and local RAG clients for Bun and Fetch runtimes",
  "license": "Apache-2.0",
  "author": "aphrody-dev <contact@aphrody.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/bun-os.git",
    "directory": "packages/aphrody-web"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./cli": "./src/cli.ts"
  },
  "bin": {
    "aphrody-web": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "bun check --noEmit"
  },
  "devDependencies": {
    "bun-types": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
