{
  "$schema": "https://schema.tauri.app/config/3.0.0-alpha.4",
  "productName": "__NAME__",
  "version": "0.1.0",
  "identifier": "dev.aphrody.__IDENT__",
  "build": {
    "beforeDevCommand": "bun run start",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "__NAME__", "width": 900, "height": 640, "transparent": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
