{
  "name": "@aphrody/tauri",
  "version": "1.4.7",
  "description": "Bun sidecar bridge and MCP bridge guest binding for Tauri apps run by unmodified upstream Bun; the Tauri API itself comes from @tauri-apps/api (catalog)",
  "license": "Apache-2.0 OR MIT",
  "files": [
    "js",
    "bin",
    "README.md",
    "LICENSE-*"
  ],
  "type": "module",
  "exports": {
    ".": "./js/index.ts",
    "./bun": "./js/bun.ts",
    "./server": "./js/server.ts",
    "./sidecar": "./js/sidecar.ts",
    "./mcp-bridge": "./js/plugins/mcp-bridge.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "bin": {
    "bun-tauri-sidecar": "./bin/sidecar.ts"
  },
  "peerDependencies": {
    "@tauri-apps/cli": "catalog:"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/cli": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "@tauri-apps/cli": "catalog:"
  },
  "dependencies": {
    "@tauri-apps/api": "catalog:"
  }
}
