{
  "name": "@aphrody/google",
  "version": "1.4.7",
  "description": "Canonical Bun facade for Aphrody Google Cloud and Gemini, and the owner of the aphrody-labs/bun fork bun:google (Bun OS plugin) on upstream Bun.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/bun-os.git",
    "directory": "packages/google"
  },
  "bin": {
    "bun-google": "./src/bun-google-cli.ts",
    "bun-google-index-public": "./src/public-index-cli.ts"
  },
  "files": [
    "src",
    "types",
    "README.md"
  ],
  "type": "module",
  "types": "./types/google.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./api": "./src/api.ts",
    "./drive-sync": "./src/drive-sync.ts",
    "./drive-model-sync": "./src/drive-model-sync.ts",
    "./services": "./src/services.ts",
    "./edge-proxy": "./src/edge-proxy.ts",
    "./fonts-proxy": "./src/fonts-proxy.ts",
    "./bun-plugin": "./src/bun-plugin.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm",
    "google:status": "bun ./src/cli.ts drive status",
    "google:sync": "bun ./src/cli.ts drive sync",
    "test": "bun test ./test",
    "verify": "bun run test && bun run build"
  },
  "dependencies": {
    "@aphrody/bun-os-plugins": "workspace:*",
    "@aphrody/chromium": "workspace:*",
    "@ai-sdk/google-vertex": "catalog:",
    "@googleapis/docs": "catalog:",
    "@googleapis/drive": "catalog:",
    "ai": "catalog:",
    "google-auth-library": "catalog:"
  },
  "engines": {
    "bun": "1.4.4-canary.20261028.1"
  }
}
