{
  "name": "@aphrody/discord-kit",
  "version": "1.4.7",
  "description": "Unified Discord bot core kit: pre-flight intent negotiation, memory-bounded caching, resilient interaction dispatching, lifecycle management and guards for Bun.",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE.txt"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./rest": {
      "types": "./src/rest.ts",
      "bun": "./src/rest.ts",
      "import": "./dist/rest.mjs"
    },
    "./apps": {
      "types": "./dist/apps.d.mts",
      "import": "./dist/apps.mjs"
    },
    "./messaging": {
      "types": "./dist/messaging.d.mts",
      "import": "./dist/messaging.mjs"
    },
    "./lab": {
      "types": "./src/lab/ai-lab.ts",
      "bun": "./src/lab/ai-lab.ts",
      "import": "./dist/lab/ai-lab.mjs"
    },
    "./assistant": {
      "types": "./dist/lab/assistant.d.mts",
      "import": "./dist/lab/assistant.mjs"
    },
    "./local-ai": {
      "types": "./dist/lab/local-ai.d.mts",
      "import": "./dist/lab/local-ai.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/rest.ts src/apps.ts src/messaging.ts src/lab/ai-lab.ts src/lab/assistant.ts src/lab/local-ai.ts --format esm --dts",
    "test": "bun test --config=./bunfig.toml test",
    "typecheck": "bun check --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aphrody/bun": "workspace:*",
    "@aphrody/runtime-sdk": "catalog:",
    "@discordjs/rest": "catalog:",
    "discord-api-types": "catalog:",
    "discord.js": "catalog:",
    "discordx": "catalog:"
  },
  "devDependencies": {
    "bun-types": "catalog:",
    "tsdown": "catalog:"
  },
  "engines": {
    "bun": "=1.4.4"
  }
}
