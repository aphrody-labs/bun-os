{
  "name": "@aphrody/m3-forms",
  "version": "1.4.7",
  "description": "Material Design 3 form fields (react-hook-form) on @aphrody/m3-primitives: the SpaceUI (@spacedrive/forms) set, M3-styled.",
  "keywords": [
    "material-3",
    "md3",
    "react",
    "spaceui",
    "tailwind"
  ],
  "license": "Apache-2.0 AND MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/bun-distribution.git",
    "directory": "packages/m3-forms"
  },
  "homepage": "https://github.com/aphrody-labs/bun-distribution/tree/os/packages/m3-forms#readme",
  "bugs": {
    "url": "https://github.com/aphrody-labs/bun-distribution/issues"
  },
  "author": "aphrody-code",
  "files": [
    "dist",
    "LICENSE.spaceui",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/m3/build.ts build --only @aphrody/m3-forms",
    "typecheck": "bun check --noEmit",
    "typecheck:fast": "bun check --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@aphrody/m3-primitives": "workspace:*",
    "clsx": "catalog:"
  },
  "devDependencies": {
    "@aphrody/m3-config": "workspace:*",
    "react-hook-form": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-hook-form": ">=7.0.0",
    "tailwindcss": ">=4.1.0"
  },
  "engines": {
    "bun": "1.4.4-canary.20261028.1"
  }
}
