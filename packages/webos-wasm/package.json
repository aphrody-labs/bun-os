{
  "name": "@aphrody/webos-wasm",
  "version": "1.4.7",
  "description": "Rust WebAssembly backend of the Aphrody browser OS: OPFS-persisted file system, explorer wire protocol, local shell and terminal, binary triage and patches.",
  "license": "Apache-2.0",
  "files": [
    "src",
    "wasm",
    "README.md",
    "stage-notices.ts"
  ],
  "type": "module",
  "imports": {
    "#webos-wasm-glue": "./wasm/aphrody_webos_wasm.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./wasm/*": "./wasm/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:wasm": "bun ../../scripts/aphrody/build/rust/wasm-package.ts --crate aphrody-webos-wasm --out packages/webos-wasm/wasm && bun stage-notices.ts",
    "typecheck": "bun check --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": "1.4.4-canary.20261028.1"
  }
}
