{
  "name": "@shenron/ui",
  "version": "1.4.7",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./admin": "./src/admin.ts",
    "./public": "./src/public.ts",
    "./reader": "./src/reader/index.ts",
    "./reader-styles.css": "./src/reader-styles.css",
    "./reader-dragon-ball.css": "./src/reader-dragon-ball.css",
    "./public/*": "./src/public/*.tsx",
    "./assets": "./src/assets.ts",
    "./assets/*": "./assets/*",
    "./svg": "./src/toriyama-svg/index.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./lib/page-window": "./src/lib/page-window.ts",
    "./styles.css": "./src/styles.css",
    "./site.css": "./src/site.css",
    "./toriyama.css": "./src/toriyama.css",
    "./barre-nav.css": "./src/barre-nav.css",
    "./editor.css": "./src/editor.css",
    "./editorial.css": "./src/editorial.css",
    "./tokens": "./src/tokens.ts",
    "./icones": "./src/icones/index.tsx",
    "./toriyama": "./src/toriyama/index.ts",
    "./toriyama/*": "./src/toriyama/*.tsx",
    "./toriyama-svg": "./src/toriyama-svg/index.ts",
    "./toriyama-svg/*": "./src/toriyama-svg/*.ts",
    "./cinematic": "./src/cinematic/index.ts",
    "./cinematic/*": "./src/cinematic/*.tsx",
    "./layout/*": "./src/layout/*.tsx",
    "./navigation/*": "./src/navigation/*.tsx",
    "./admin/*": "./src/admin/*.tsx",
    "./*": "./src/components/*.tsx",
    "./use-focus-trap": "./src/reader/use-focus-trap.ts"
  },
  "scripts": {
    "type-check": "bun check --noEmit",
    "lint": "bun lint",
    "test": "bun test",
    "tokens": "bun scripts/generate-tokens.ts",
    "tokens:check": "bun scripts/generate-tokens.ts --check",
    "css:equivalence": "bun scripts/check-css-equivalence.ts",
    "assets:check": "bun scripts/sync-assets.ts --check",
    "assets:sync": "bun scripts/sync-assets.ts",
    "build:check": "bun scripts/production-check.ts",
    "portability:check": "bun scripts/check-portability.ts",
    "typecheck": "bun check -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aphrody/m3-reader": "workspace:*",
    "@base-ui/react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@aphrody/bun-workspace": "workspace:*",
    "@rosegriffon/config": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "engines": {
    "bun": "1.4.4-canary.20261028.1"
  },
  "bunos": {
    "runtime": {
      ".": "pure",
      "./server": "react",
      "./client": "react",
      "./admin": "react",
      "./public": "react",
      "./reader": "react",
      "./reader-styles.css": "css",
      "./reader-dragon-ball.css": "css",
      "./public/*": "react",
      "./assets": "pure",
      "./assets/*": "css",
      "./svg": "pure",
      "./lib/utils": "pure",
      "./lib/page-window": "pure",
      "./styles.css": "css",
      "./site.css": "css",
      "./toriyama.css": "css",
      "./barre-nav.css": "css",
      "./editor.css": "css",
      "./editorial.css": "css",
      "./tokens": "pure",
      "./icones": "react",
      "./toriyama": "react",
      "./toriyama/*": "react",
      "./toriyama-svg": "pure",
      "./toriyama-svg/*": "pure",
      "./cinematic": "react",
      "./cinematic/*": "react",
      "./layout/*": "react",
      "./navigation/*": "react",
      "./admin/*": "react",
      "./*": "react",
      "./use-focus-trap": "react"
    }
  }
}
