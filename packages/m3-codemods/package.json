{
  "name": "@aphrody/m3-codemods",
  "version": "1.4.7",
  "description": "MUI React -> @aphrody/m3-react codemods, ast-grep rules and the MUI theme -> M3 token migration",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/bun-distribution.git",
    "directory": "packages/m3-codemods"
  },
  "homepage": "https://github.com/aphrody-labs/bun-distribution/tree/os/packages/m3-codemods#readme",
  "bugs": {
    "url": "https://github.com/aphrody-labs/bun-distribution/issues"
  },
  "files": [
    "README.md",
    "data",
    "lib",
    "mui-m3-map.json",
    "rules",
    "scripts",
    "sgconfig.yml",
    "src",
    "transforms"
  ],
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./transforms/*": "./transforms/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "codemod": "bun scripts/codemod.ts",
    "theme": "bun scripts/theme.ts",
    "test": "bun test ./test",
    "typecheck": "bun check -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aphrody/m3-tokens": "workspace:*"
  },
  "devDependencies": {
    "@aphrody/m3-config": "workspace:*"
  },
  "engines": {
    "bun": "1.4.4-canary.20261028.1"
  }
}
