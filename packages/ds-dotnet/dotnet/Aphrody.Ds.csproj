<Project Sdk="Microsoft.NET.Sdk">
  <!-- Glue assembly hosted through hostfxr (src/hostfxr.ts). Vendor sources are referenced in place, never copied. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Aphrody.Ds</AssemblyName>
    <RootNamespace>Aphrody.Ds</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <NoWarn>$(NoWarn);CS8632;CS0168;CS0219;CS0649;CS0169;CS0414;CS8981;CA1416;WFO1000;SYSLIB0011</NoWarn>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <VendorRoot>$(MSBuildThisFileDirectory)../../../vendor/</VendorRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <!-- pk3DS CTR ExeFS reader, GPL-3.0 -->
    <Compile Include="$(VendorRoot)pk3ds/pk3DS.Core/CTR/ExeFS.cs" />
    <!-- SPICA H3D/BCH/CGFX model and texture readers, Unlicense -->
    <Compile Include="$(VendorRoot)spica/SPICA/**/*.cs" Exclude="$(VendorRoot)spica/SPICA/obj/**;$(VendorRoot)spica/SPICA/Properties/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(VendorRoot)kuriimu2/src/lib/Konnect/Konnect.csproj" />
    <ProjectReference Include="$(VendorRoot)kuriimu2/src/lib/Kryptography/Kryptography.csproj" />
  </ItemGroup>
</Project>
