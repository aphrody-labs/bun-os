{
  "name": "@aphrody/m3-motion",
  "version": "1.4.7",
  "description": "Material 3 animation plugin powered by Motion (formerly Framer Motion)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/bun-distribution.git",
    "directory": "packages/m3-motion"
  },
  "homepage": "https://github.com/aphrody-labs/bun-distribution/tree/os/packages/m3-motion#readme",
  "bugs": {
    "url": "https://github.com/aphrody-labs/bun-distribution/issues"
  },
  "license": "Apache-2.0",
  "author": "aphrody-code",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/m3/build.ts build --only @aphrody/m3-motion",
    "typecheck": "bun check --noEmit",
    "typecheck:fast": "bun check --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "motion": "catalog:"
  },
  "devDependencies": {
    "@aphrody/m3-config": "workspace:*",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "motion": ">=12.0.0",
    "react": ">=18.0.0"
  },
  "engines": {
    "bun": "1.4.4-canary.20261028.1"
  }
}
