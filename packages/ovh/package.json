{
  "name": "@aphrody/ovh",
  "version": "1.4.7",
  "description": "OVH cloud library for Aphrody Infra: DNS, VPS, Email, and multi-profile operations in pure Bun (command line: aphrody ovh)",
  "license": "Apache-2.0",
  "files": [
    "README.md",
    "src",
    "LICENSE-APACHE",
    "SOURCE.json"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./dns": "./src/dns.ts",
    "./vps": "./src/vps.ts",
    "./email": "./src/email.ts",
    "./profiles": "./src/profiles.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build.ts",
    "lint": "bun lint src test",
    "test": "bun test",
    "typecheck": "bun check -p ../../tsconfig.json --threads=2 --no-pretty",
    "status": "aphrody ovh status",
    "dns": "aphrody ovh dns",
    "vps": "aphrody ovh vps",
    "email": "aphrody ovh email"
  },
  "dependencies": {},
  "devDependencies": {
    "@aphrody/bun-workspace": "workspace:*"
  },
  "engines": {
    "bun": "1.4.4-canary.20261028.1"
  }
}
