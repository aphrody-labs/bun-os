{
  "name": "@aphrody/themes",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth for the Bun OS themes: Material 3 (Google Book OS), Windows 11 Fluent, Apple Liquid Glass. W3C design tokens in, CSS variables, Tailwind v4 theme, TypeScript types, Rust consts and Tauri window effects out.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./themes.css": "./generated/themes.css",
    "./tailwind.css": "./generated/tailwind.css",
    "./tokens.json": "./generated/resolved.json",
    "./window-effects.json": "./generated/window-effects.json"
  },
  "scripts": {
    "build": "bun src/build.ts",
    "check": "bun src/build.ts --check",
    "test": "bun test test/"
  },
  "devDependencies": {
    "@material/material-color-utilities": "0.4.0",
    "happy-dom": "^20.14.5"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
