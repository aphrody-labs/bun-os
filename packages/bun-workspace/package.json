{
  "name": "@aphrody/bun-workspace",
  "version": "1.4.7",
  "license": "MIT AND Apache-2.0",
  "bin": {
    "aphrody-bun": "./src/cli.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./assets": "./src/assets.ts",
    "./capabilities": "./src/capabilities.ts",
    "./libraries": "./src/craft.ts",
    "./craft": "./src/craft.ts",
    "./craft-control": "./src/craft-control.ts",
    "./coverage": "./src/coverage.ts",
    "./hash": "./src/hash.ts",
    "./guards": "./src/guards.ts",
    "./process": "./src/process.ts",
    "./windows-job": "./src/windows-job.ts",
    "./runtime": "./src/runtime.ts",
    "./automation": "./src/automation/index.ts",
    "./automation/*": "./src/automation/*"
  },
  "dependencies": {
    "@aphrody/a2a": "workspace:*",
    "@aphrody/os": "workspace:*",
    "@aphrody/paths": "workspace:*",
    "@aphrody/runtime-sdk": "workspace:*",
    "@aphrody/timeline": "1.4.7",
    "@aphrody/update": "workspace:*",
    "@aphrody/yolo-core": "workspace:*",
    "ts-morph": "catalog:"
  },
  "devDependencies": {
    "@aphrody/yolo-cli": "workspace:*"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "bunos": {
    "runtime": {
      "./guards": "server"
    }
  }
