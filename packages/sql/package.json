{
  "name": "@aphrody/sql",
  "version": "1.4.7",
  "description": "Shared Bun database mechanics for Aphrody: env/URL resolution, Bun.SQL and Redis factories, bun:sqlite open policy with optional sqlite-vec",
  "license": "Apache-2.0",
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./postgres": "./src/postgres.ts",
    "./redis": "./src/redis.ts",
    "./sqlite": "./src/sqlite.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --target bun --packages external --outdir dist",
    "test": "bun test",
    "typecheck": "bun check -p tsconfig.json --noEmit",
    "lint": "bun lint src test"
  },
  "dependencies": {
    "sqlite-vec": "catalog:"
  },
  "engines": {
    "bun": "1.4.4-canary.20261028.1"
  }
}
