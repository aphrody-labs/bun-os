{
  "version": "1.0.0",
  "spec": "a2a/v1.0",
  "id": "aphrody@aphrody-code/aphrody",
  "schema_version": "1.0.0",
  "kind": "agent",
  "name": "Aphrody Bun OS",
  "description": "Private A2A 1.0 coordination for the unified Bun OS workspace and its agents.",
  "a2a_protocol_version": "1.0",
  "documentation_url": "https://github.com/aphrody-labs/bun-os",
  "peer_registry": {
    "owner": "@aphrody/bun-os",
    "path": "tools/aphrody/config/a2a-peers.json",
    "note": "Canonical monorepo peer registry; APHRODY_A2A_PEERS_FILE is an explicit override."
  },
  "provider": {
    "organization": "Aphrody Labs",
    "url": "https://github.com/aphrody-labs/bun-os"
  },
  "supported_interfaces": [],
  "capabilities": {
    "streaming": true,
    "pushNotifications": false,
    "extendedAgentCard": false
  },
  "default_input_modes": [
    "text/plain"
  ],
  "default_output_modes": [
    "text/plain",
    "application/json"
  ],
  "skills": [
    {
      "id": "a2a.coord",
      "name": "Bun OS agent coordination",
      "description": "Authenticated A2A 1.0 task coordination and durable peer mailboxes for the Bun OS workspace.",
      "tags": [
        "a2a",
        "coordination",
        "bun-os"
      ]
    }
  ],
  "coord": {
    "mailbox_dir": ".coord",
    "inbox_pattern": "inbox-from-<peer-short-id>.jsonl",
    "http_bind": "127.0.0.1:8788",
    "envelope": {
      "v": 1,
      "kinds": [
        "ping",
        "ask",
        "fact",
        "ack",
        "error"
      ]
    }
  },
  "deployment_status": "local-coordination; public A2A interface remains unqualified"
}
